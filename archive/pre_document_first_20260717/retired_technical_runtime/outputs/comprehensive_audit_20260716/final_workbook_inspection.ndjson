{"kind":"table","sheet":"Dashboard","address":"A1:H16","rows":16,"cols":8,"values":[["Comprehensive Process Audit",null,null,null,null,null,null,null],["Formula-driven summary of the latest structured legacy workbook. Metrics are retrospective diagnostics, not certified prospective performance.",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["Metric","Value","Interpretation","Status",null,"What failed and what replaced it",null,null],["Structured selections",449,"Non-template rows in latest settled XLSX","LEGACY",null,"Old process","Observed defect","Replacement control"],["Decisive W/L",443,"Excludes pushes, voids and unresolved","LEGACY",null,"Four/long ranked cards","Opposite outcomes counted as separate picks; many cards guaranteed 2-2","One declared decision per market; alternatives logged as candidates"],["Wins",253,"Raw count; correlated selections included","LEGACY",null,"Mutable ledger row","Pregame probability, result and postmortem co-located","Immutable publication snapshot plus append-only settlement"],["Losses",190,"Raw count; correlated selections included","LEGACY",null,"Penalty/exemption economy","Custom accounting obscured raw ranking performance","Proper scores, baselines, event-clustered uncertainty"],["Pushes",2,"Recorded P status","LEGACY",null,"Fixed L5/L10/L15/L20 ritual","Overlapping windows encouraged selection and recency bias","Predeclared sport/market features tested chronologically"],["Raw hit rate",0.5711060948081265,"Not an edge or ROI measure","CAUTION",null,"All-sport confidence language","No validated model cards for several named sports","Coverage registry; unsupported scopes must PASS"],["Apparent Brier",0.21919322799097066,"Unverified lock; do not call calibrated","CAUTION",null,"Poisson/simulation precision","Assumed parameters and independent counts looked more certain than warranted","Validated distribution, typed uncertainty, MCSE and convergence"],["Exact complement rows",306,"Rows belonging to a detected over/under or opposite-spread pair","FAIL",null,"Research-only cards","No prices, stakes or executions, so value/ROI claims were impossible","Separate research and price modes; execution required for P&L/CLV"],["Exact complement share",0.6815144766146993,"Mechanically inflates all-selection summaries","FAIL",null,"Immediate rule after each miss","Single-event narratives caused rule accretion and overfit","Batch review, preregistered change ticket, new untouched test"],["Settlement rows with URL",12,"Legacy settlement source fields mostly contain prose","FAIL",null,null,null,null],["Eligible for v3 evaluation",0,"Requires immutable cutoff/model/source packet","FAIL",null,null,null,null],[null,null,null,null,null,"Current publication rule: SUSPENDED — NO ACTIVE MODELS. A numerical probability is prohibited unless an ACTIVE, in-scope model passes the acceptance suite and prospective shadow gate.",null,null]]}
