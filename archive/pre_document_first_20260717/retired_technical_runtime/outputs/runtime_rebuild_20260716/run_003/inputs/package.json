{
  "name": "sports-research-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fail-closed runtime and validation harness for the Sports Research v3 specification.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "validate": "node scripts/sportsctl.mjs validate-system",
    "verify-store": "node scripts/sportsctl.mjs verify-store",
    "release-bundle": "node scripts/build_release_bundle.mjs",
    "next-run": "node scripts/sportsctl.mjs new-request --input templates/next_request.template.json --output runtime/next_decision_packet.json"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
