{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.sports-research/schema/analysis_output.schema.json",
  "title": "Sports analysis-only live output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "analysis_tier", "model_id", "model_version", "sport_family", "competition_id", "market_family", "forecast_state", "as_of_utc", "numeric_forecast_authorized", "lean", "input_hash", "source_snapshot_hash", "model_code_hash", "limitations", "prohibited_claims"],
  "properties": {
    "schema_version": { "const": "SPORTS_ANALYSIS_OUTPUT_V1" },
    "analysis_id": { "type": "string" },
    "analysis_tier": { "const": "ACTIVE_ANALYSIS_ONLY" },
    "model_id": { "type": "string" }, "model_version": { "type": "string" },
    "sport_family": { "enum": ["Baseball", "Cricket", "Soccer", "Australian football", "Rugby league"] },
    "competition_id": { "type": "string" }, "market_family": { "const": "winner" }, "forecast_state": { "const": "LIVE" },
    "as_of_utc": { "type": "string" }, "numeric_forecast_authorized": { "const": false },
    "lean": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "participant_id", "strength", "reason_codes", "state_summary"],
      "properties": {
        "classification": { "enum": ["SIDE", "TOSSUP"] },
        "participant_id": { "type": ["string", "null"] },
        "strength": { "enum": ["NONE", "SLIGHT", "MODERATE", "STRONG"] },
        "reason_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "state_summary": { "type": "string", "minLength": 1 }
      }
    },
    "input_hash": { "$ref": "#/$defs/sha256" }, "source_snapshot_hash": { "$ref": "#/$defs/sha256" }, "model_code_hash": { "$ref": "#/$defs/sha256" },
    "limitations": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "prohibited_claims": { "type": "array", "const": ["calibrated_probability", "betting_edge", "expected_value", "stake", "profitability"] }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
