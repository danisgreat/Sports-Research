                    <img class=" js-faded-image fade-in-on-load object-fit-cover-picture__img" src="https://resources.afl.com.au/photo-resources/2023/08/08/02ce4230-a96f-4c03-9576-0ca11e8f8bf9/xcjjh4MH.jpg?width=1064&height=600" alt="" >
        </picture>
