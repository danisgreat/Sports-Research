                    <source class="" srcset="https://resources.afl.com.au/photo-resources/2023/08/18/00a7151b-ae93-448e-a548-6d02eb3e9cea/8iQ4bu0U.jpg?width=1064&height=600, https://resources.afl.com.au/photo-resources/2023/08/18/00a7151b-ae93-448e-a548-6d02eb3e9cea/8iQ4bu0U.jpg?width=2128&height=1200 2x" media="(min-width: 769px)">
                    <img class=" js-faded-image fade-in-on-load object-fit-cover-picture__img" src="https://resources.afl.com.au/photo-resources/2023/08/18/00a7151b-ae93-448e-a548-6d02eb3e9cea/8iQ4bu0U.jpg?width=1064&height=600" alt="" >
