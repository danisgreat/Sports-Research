                    <source class="" srcset="https://resources.afl.com.au/photo-resources/2023/08/19/75f66922-a63b-4b94-ae82-ae90c3fc4da6/sFSlLEMJ.jpg?width=1064&height=600, https://resources.afl.com.au/photo-resources/2023/08/19/75f66922-a63b-4b94-ae82-ae90c3fc4da6/sFSlLEMJ.jpg?width=2128&height=1200 2x" media="(min-width: 769px)">
                    <img class=" js-faded-image fade-in-on-load object-fit-cover-picture__img" src="https://resources.afl.com.au/photo-resources/2023/08/19/75f66922-a63b-4b94-ae82-ae90c3fc4da6/sFSlLEMJ.jpg?width=1064&height=600" alt="" >
