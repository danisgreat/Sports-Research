        --tag-status-postponed-bg-rgb: var(--color-orange-dark-rgb);
        --tag-status-postponed-label-rgb: var(--text-dark-x-high-rgb);
        --tag-status-cancelled-bg-rgb: var(--color-red-dark-rgb);
        --tag-status-cancelled-label-rgb: var(--text-dark-x-high-rgb);
        --tag-status-tbc-bg-rgb: var(--color-neutral-600-rgb);
        --tag-status-tbc-label-rgb: var(--text-dark-x-high-rgb);
        --tag-content-breaking-bg-rgb: var(--color-brand-aflw-green-rgb);
        --tag-content-breaking-label-rgb: var(--color-theme-aflw-700-rgb);
        --tag-content-exclusive-bg-rgb: var(--color-brand-aflw-blue-rgb);
        --tag-content-exclusive-label-rgb: var(--color-theme-aflw-700-rgb);
        --tag-content-live-bg-rgb: var(--color-brand-aflw-pink-rgb);
        --tag-content-live-label-rgb: var(--color-neutral-white-rgb);
        --tag-content-generic-bg-rgb: var(--fill-accent-brand-rgb);
        --tag-content-generic-label-rgb: var(--color-neutral-white-rgb);

        --secondary-gradient: linear-gradient(
            90deg,
            var(--fill-accent-stats) 0%,
            var(--fill-accent-stats) 100%
        );

        --stats-bg: url('../i/elements/aflw-pattern-bg.svg') no-repeat center/100%;
        --stats-bg-mask-image: none;
        --stats-bg-image-height: 62%;
        --stats-bg-opacity: 1;

        --compare-player-bg-image: url('../i/elements/aflw-compare-bg-pattern.svg');
        --compare-player-bg-color: rgb(var(--fill-800-rgb));

        --promo-bg: linear-gradient(90deg, var(--fill-bg-feature), var(--fill-bg-feature));
        --promo-bg-image-mobile: url('../i/elements/aflw-pattern-vertical.svg') no-repeat center bottom, linear-gradient(90deg, var(--fill-bg-feature), var(--fill-bg-feature));
        --promo-bg-image-desktop: url('../i/elements/aflw-pattern-vertical.svg') no-repeat center bottom, linear-gradient(90deg, var(--fill-bg-feature), var(--fill-bg-feature));

        --modal-image-placeholder: url('../i/elements/aflw-logo.png');

        --stats-compare-players-bg: url('../i/elements/aflw-pattern-bg.svg') no-repeat center/100% var(--color-theme-aflw-800);
        --stats-compare-players-gradient: transparent;
        --stats-compare-players-padding-bottom: 0;

        --grad-player-awards-leader-row-bg: var(--grad-player-awards-aflw-bg);

        --ladder-cut-off-line: rgb(var(--color-brand-aflw-charged-coral-rgb));
    }
</style>

