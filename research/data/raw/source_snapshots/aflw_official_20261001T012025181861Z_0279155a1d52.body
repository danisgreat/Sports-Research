                                    <div class="photo__icon">
	<svg class="icon camera-icon" aria-hidden="true">
			<use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="/resources/v5.54.8/i/svg-output/icons.svg#icn-camera"></use>
	</svg>
