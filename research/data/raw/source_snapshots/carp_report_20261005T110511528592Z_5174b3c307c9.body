 '#tab-bp-news-all') return;\n    var tab = document.querySelector('a[data-news-init][href$=\"' + h + '\"]');\n    if (!tab || tab.classList.contains('is-active')) return;\n    tab.click();\n  }\n\n  function waitAndActivate() {\n    if (document.querySelectorAll('a[data-news-init]').length) {\n      return setTimeout(activate, 150);\n    }\n    var tid, ob = new MutationObserver(function (_, obs) {\n      if (document.querySelectorAll('a[data-news-init]').length) {\n        obs.disconnect();\n        clearTimeout(tid);\n        setTimeout(activate, 150);\n      }\n    });\n    ob.observe(document.documentElement, { childList: true, subtree: true });\n    tid = setTimeout(function () { ob.disconnect(); }, 5000);\n  }\n\n  function hookRouter(n) {\n    var app = (document.querySelector('#__nuxt') || {}).__vue_app__;\n    var router = app && app.config.globalProperties.$router;\n    if (router) {\n      router.afterEach(function (to) {\n        if (to.path === PATH && to.hash) waitAndActivate();\n      });\n    } else if (n \u003C 30) {\n      setTimeout(function () { hookRouter(n + 1); }, 200);\n    }\n  }\n\n  if (location.pathname === PATH) {\n    document.readyState === 'loading'\n      ? document.addEventListener('DOMContentLoaded', waitAndActivate)\n      : waitAndActivate();\n  }\n\n  hookRouter(0);\n})();\n\u003C\u002Fscript>","22dc3258-f441-4545-aa1e-f1d113ba39e5",[852,856],{"memo":234,"src":235,"tags":853,"uuid":855},[854],{"children":238,"tagName":163},"e6f74c70-90ea-443d-ad3b-9e587782d2a2",{"memo":241,"src":242,"tags":857,"uuid":859},[858],{"children":245,"tagName":163},"546de113-f65b-4bb5-b4cb-95e4d190373c","ニュース｜野球振興｜広島東洋カープ","baseball-promotion\u002Fnews","b463ebf4-1435-487e-9519-284795a2c3f9",[251,864,253,254,255],"cc55dca2-eed5-48a7-aeac-eece520a3fa0",{"head":866,"id":874,"type":212,"uuid":875,"symbolIds":876},{"customCode":867,"title":873},{"headEnd":868},[869],{"memo":241,"src":242,"tags":870,"uuid":872},[871],{"children":245,"tagName":163},"59cfcf5