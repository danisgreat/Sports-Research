70454d4900",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,382,1158,323],{"head":1187,"id":1189,"type":212,"uuid":1190,"symbolIds":1191},{"title":1188},"監督・コーチ｜広島東洋カープ公式サイト","team\u002Fmanager-coach","487ef685-79e4-4521-95c0-3cbecabe4015",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,382,1158,323],{"head":1193,"id":1195,"type":212,"uuid":1196,"symbolIds":1197},{"title":1194},"2026年1月チームスケジュール","team\u002Fschedule\u002F202601","fede8f7f-a9f7-4c90-b2ec-a48739f2ad32",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],"a689c691-d8bf-42a5-a7bb-541d44e6c4f2",{"head":1200,"id":1206,"type":212,"uuid":1207,"symbolIds":1208},{"customCode":1201,"title":1205},{"bodyEnd":1202},[1203],{"memo":1049,"src":1082,"uuid":1204},"82e6874f-7d10-49ee-b3af-1f76a173ff4c","2026年2月チームスケジュール","team\u002Fschedule\u002F202602","70c8da39-e0d3-4b13-a920-24645b05003a",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"head":1210,"id":1220,"type":212,"uuid":1221,"symbolIds":1222},{"customCode":1211,"title":1219},{"bodyEnd":1212},[1213,1215],{"memo":1049,"src":1082,"uuid":1214},"c8fa2af3-5d37-4e36-a9e0-28eba28d70dc",{"memo":1216,"src":1217,"uuid":1218},"並び順を日付の昇順にする","\u003Cstyle>\n  \u002F* ここに対象のIDをカンマ区切りで指定してください *\u002F\n  #calendar-1, #calendar-2, #calendar-3, #calendar-4 {\n    opacity: 0; \u002F* 最初は透明にしておく *\u002F\n    transition: opacity 0.2s ease; \u002F* ふわっと表示させるアニメーション（お好みで） *\u002F\n  }\n\n  \u002F* 並び替え完了後にこのクラスが追加され、表示される *\u002F\n  #calendar-1.is-ready, #calendar-2.is-ready, #calendar-3.is-ready, #calendar-4.is-ready {\n    opacity: 1;\n  }\n\u003C\u002Fstyle>\n\n\u003Cscript>\n(function() {\n  \u002F\u002F 対象のIDを指定\n  const targetIds = ['calendar-1', 'calendar-2', 'calendar-3', 'calendar-4'];\n\n  function sortCalendar(id) {\n    const targetContainer = document.getElementById(id);\n    if (!targetContainer) return false;\n\n    const targetList = targetContainer.tagName === 'UL' ? targetContainer : targetContainer.querySelector('ul');\n    if (!targetList) return false;\n\n    const listItems = Array.from(targetList.children).filter(child => child.tagName === 'LI');\n    if (listItems.length \u003C 2) return false;\n\n    if (targetList.dataset.sorted === 'true') return true;\n\n    \u002F\u002F 非表示の裏側で昇順に並べ替え\n    listItems.sort((a, b) => {\n      const matchA = a.textContent.match(\u002F(\\d+)\\s*\\\u002F\\s*(\\d+)\u002F);\n      const matchB = b.textContent.match(\u002F(\\d+)\\s*\\\u002F\\s*(\\d+)\u002F);\n      \n      const scoreA = matchA ? (parseInt(matchA[1], 10) * 100 + parseInt(matchA[2], 10)) : 9999;\n      const scoreB = matchB ? (parseInt(matchB[1], 10) * 100 + parseInt(matchB[2], 10)) : 9999;\n      \n      return scoreA - scoreB;\n    });\n\n    listItems.forEach(item => targetList.appendChild(item));\n    targetList.dataset.sorted = 'true';\n    \n    \u002F\u002F ★並び替えが終わった瞬間に 'is-ready' クラスを付与して表示させる\n    targetContainer.classList.add('is-ready'); \n    \n    return true;\n  }\n\n  let attempts = 0;\n  \u002F\u002F チェックの間隔を短く（100ms）し、より早く検知するように調整\n  const intervalId = setInterval(() => {\n    let allDone = true;\n\n    targetIds.forEach(id => {\n      const isSorted = sortCalendar(id);\n      if (!isSorted) {\n        allDone = false;\n      }\n    });\n\n    attempts++;\n\n    \u002F\u002F 全て完了、または一定時間（約2秒）経過したら監視終了\n    if (allDone || attempts >= 20) {\n      clearInterval(intervalId);\n      \n      \u002F\u002F ★万が一、読み込みエラー等で処理が失敗しても、\n      \u002F\u002F 画面が真っ白のままにならないよう強制的に表示させる安全装置\n      targetIds.forEach(id => {\n        const el = document.getElementById(id);\n        if (el && !el.classList.contains('is-ready')) {\n          el.classList.add('is-ready');\n        }\n      });\n    }\n  }, 100); \n})();\n\u003C\u002Fscript>","e5431aaf-d907-40b8-93c5-c1954f6c985e","2026年3月チームスケジュール","team\u002Fschedule\u002F202603","5dbd7726-a551-4a77-a084-e970c6daa770",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"head":1224,"id":1233,"type":212,"uuid":1234,"symbolIds":1235},{"customCode":1225,"title":1232},{"bodyEnd":1226},[1227,1228],{"memo":1216,"src":1217,"uuid":1218},{"memo":1229,"src":1230,"uuid":1231},"タブによる絞り込み","\u003Cscript>\n\u002F\u002F 1. Studioの再描画に負けないよう、専用の\u003Cstyle>タグを作ってページに追加する\nconst styleTag = document.createElement('style');\ndocument.head.appendChild(styleTag);\n\n\u002F\u002F 2. 選ばれたタブの href を元に、強制的に色を変えるCSSルールを書き込む関数\nfunction updateTabStyle(activeHref) {\n  styleTag.innerHTML = `\n    \u002F* 選ばれたタブ（およびその親要素）の背景を強制的に赤にする *\u002F\n    #js-parts-tab-calendar-1 li:has(a[href=\"${activeHref}\"]),\n    #js-parts-tab-calendar-1 a[href=\"${activeHref}\"] {\n      background-color: #CA0915 !important;\n      transition: none !important; \u002F* Studioのアニメーション干渉を防ぐ *\u002F\n    }\n    \u002F* 選ばれたタブの中の文字（pタグ）を強制的に白にする *\u002F\n    #js-parts-tab-calendar-1 a[href=\"${activeHref}\"] p {\n      color: #ffffff !important;\n    }\n  `;\n}\n\n\u002F\u002F 3. ページを開いた瞬間に「すべて」のタブに色を付けるCSSをセットしておく\n\u002F\u002F （※要素が後から読み込まれても、CSSが待ち構えているので確実に色が付きます）\nupdateTabStyle('#tab-calendar-all');\n\n\u002F\u002F ここから下はカレンダーの絞り込み処理\ndocument.addEventListener('click', function(e) {\n  const tabLink = e.target.closest('#js-parts-tab-calendar-1 a');\n  if (!tabLink) return;\n\n  \u002F\u002F Studio標準タブの余計な動きを止める\n  e.preventDefault();\n  e.stopPropagation();\n\n  \u002F\u002F ★クリックされたタブの href属性（#tab-calendar-firstなど）を取得して色を更新\n  const targetHref = tabLink.getAttribute('href');\n  updateTabStyle(targetHref);\n\n  const targetText = tabLink.textContent.trim();\n  const calendar = document.getElementById('calendar-1');\n  if (!calendar) return;\n\n  const calendarWrapper = document.getElementById('tab-calendar-all');\n  if (calendarWrapper) {\n    calendarWrapper.style.setProperty('display', 'block', 'important');\n  }\n\n  const dailyBlocks = Array.from(calendar.children).filter(el => el.tagName === 'LI');\n\n  dailyBlocks.forEach(dayBlock => {\n    const eventList = dayBlock.querySelector('ul');\n    if (!eventList) return;\n\n    const eventRows = Array.from(eventList.children).filter(el => el.tagName === 'LI');\n    let visibleRows = []; \n\n    eventRows.forEach(row => {\n      const categoryP = row.querySelector('p');\n      const categoryText = categoryP ? categoryP.textContent.trim() : '';\n\n      if (targetText === 'すべて' || categoryText === targetText) {\n        row.style.setProperty('display', '', 'important'); \n        row.style.removeProperty('border-bottom'); \n        visibleRows.push(row); \n      } else {\n        row.style.setProperty('display', 'none', 'important'); \n      }\n    });\n\n    \u002F\u002F 最後の1行の下線を消す\n    if (visibleRows.length > 0) {\n      visibleRows[visibleRows.length - 1].style.setProperty('border-bottom', '0', 'important');\n    }\n\n    \u002F\u002F 表示項目がゼロの日は日付枠ごと隠す\n    if (targetText !== 'すべて' && visibleRows.length === 0) {\n      dayBlock.style.setProperty('display', 'none', 'important');\n    } else {\n      dayBlock.style.setProperty('display', '', 'important');\n    }\n  });\n\n}, true);\n\u003C\u002Fscript>","22e17ee9-2241-4d23-9b14-026d60f18a7f","2026年3月チームスケジュール_test","team\u002Fschedule\u002F202603-1","009ce4e7-22d1-4bf3-9609-283aef895e5d",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"id":1237,"isCreatedInV4":10,"redirectTo":1238,"type":218,"uuid":1239},"team\u002Fschedule","\u002Fteam\u002Fschedule\u002F202610","8ba007ca-f609-4926-8ebb-efa327525143",{"head":1241,"id":1248,"type":212,"uuid":1249,"symbolIds":1250},{"customCode":1242,"title":1247},{"bodyEnd":1243},[1244,1245],{"memo":1049,"src":1082,"uuid"