itle":1034},"3月15日(日) カープダイジェスト｜広島東洋カープ公式サイト","game\u002Fcarp-digest\u002F2026\u002F0315","fbb4aad1-dabd-49d8-b24a-35c47436b705",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,337,338,323],{"head":1039,"id":1041,"type":212,"uuid":1042,"symbolIds":1043},{"title":1040},"3月22日(日) カープダイジェスト｜広島東洋カープ公式サイト","game\u002Fcarp-digest\u002F2026\u002F0322","a4edf282-6e49-4ebf-8e9e-e1210516905a",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,337,338,323],{"head":1045,"id":1063,"type":212,"uuid":1064,"symbolIds":1065},{"customCode":1046,"meta":1060,"title":1062},{"bodyEnd":1047,"headEnd":1052},[1048],{"memo":1049,"src":1050,"uuid":1051},"カスタムJS（タブ切替実行）","\u003Cscript>\n(function() {\n  function adjustTabComponent() {\n    const container = document.querySelector('[id^=\"js-parts-tab\"], [id^=\"js-foryou-tabs\"]');\n    const contentBoxes = document.querySelectorAll('[id^=\"tab-\"]');\n    if (!container || contentBoxes.length === 0) return;\n\n    \u002F\u002F ボタンの親要素である ul を特定\n    const tabUl = container.querySelector('ul');\n\n    let emptyMsg = document.getElementById('js-empty-message') || (function() {\n      const div = document.createElement('div');\n      div.id = 'js-empty-message';\n      div.innerHTML = '\u003Cp style=\"font-family:sans-serif; font-size:15px; color:#333; text-align:center;\">開催次第、更新いたします。\u003C\u002Fp>';\n      container.parentNode.insertBefore(div, container);\n      return div;\n    })();\n\n    let validInitialId = null;\n    let hasAnyLink = false;\n    let activeYearCount = 0;\n\n    \u002F\u002F 1. 記事チェックとカウント\n    contentBoxes.forEach(box => {\n      const hasLink = box.querySelector('a') !== null;\n      const tabBtn = document.querySelector(`a[href=\"#${box.id}\"]`);\n      const tabLi = tabBtn ? tabBtn.closest('li') : null;\n\n      if (hasLink) {\n        hasAnyLink = true;\n        if (!box.id.includes('all')) activeYearCount++;\n        if (tabLi) tabLi.style.display = 'inline-block';\n        if (!validInitialId || box.id.includes('all')) validInitialId = box.id;\n      } else {\n        if (tabLi) tabLi.style.display = 'none';\n      }\n    });\n\n    \u002F\u002F 2. 表示の最終確定\n    if (!hasAnyLink) {\n      \u002F\u002F 記事が全くない場合：全体を消してメッセージ\n      container.style.setProperty('display', 'none', 'important');\n      emptyMsg.style.setProperty('display', 'block', 'important');\n    } else {\n      emptyMsg.style.setProperty('display', 'none', 'important');\n      container.style.setProperty('display', 'block', 'important');\n\n      \u002F\u002F 【修正の核心】1年分以下ならボタンリスト(ul)のみを隠す\n      if (activeYearCount \u003C= 1 && tabUl) {\n        tabUl.style.setProperty('display', 'none', 'important');\n      } else if (tabUl) {\n        tabUl.style.setProperty('display', 'flex', 'important'); \u002F\u002F または初期設定の display\n      }\n\n      \u002F\u002F 3. コンテンツBoxの表示\n      if (validInitialId) {\n        contentBoxes.forEach(box => {\n          if (box.id === validInitialId) {\n            box.classList.add('is-active');\n            box.style.setProperty('display', 'block', 'important');\n          } else {\n            box.classList.remove('is-active');\n            box.style.setProperty('display', 'none', 'important');\n          }\n        });\n        \n        const startBtn = container.querySelector(`a[href=\"#${validInitialId}\"]`);\n        if (startBtn) startBtn.classList.add('is-active');\n      }\n    }\n\n    \u002F\u002F 4. クリックイベント（複製してイベントの重複を防ぐ）\n    const allTabBtns = container.querySelectorAll('a[href^=\"#tab-\"]');\n    allTabBtns.forEach(btn => {\n      if (btn.dataset.initialized) return;\n      \n      const newBtn = btn.cloneNode(true);\n      btn.parentNode.replaceChild(newBtn, btn);\n      newBtn.dataset.initialized = \"true\";\n\n      newBtn.addEventListener('click', function(e) {\n        e.preventDefault();\n        e.stopPropagation();\n        const targetId = this.getAttribute('href').replace('#', '');\n        contentBoxes.forEach(box => {\n          const isActive = box.id === targetId;\n          box.classList.toggle('is-active', isActive);\n          box.style.setProperty('display', isActive ? 'block' : 'none', 'important');\n        });\n        const currentBtns = container.querySelectorAll('a[href^=\"#tab-\"]');\n        currentBtns.forEach(b => b.classList.toggle('is-active', b.getAttribute('href') === `#${targetId}`));\n      });\n    });\n  }\n\n  adjustTabComponent();\n  window.addEventListener('load', adjustTabComponent);\n  setTimeout(adjustTabComponent, 1000);\n})();\n\u003C\u002Fscript>","dea9b52c-1836-44bb-841f-6dc23ab59fb6",[1053],{"memo":1054,"src":1055,"tags":1056,"uuid":1059},"タブ切り替え","\u003Cstyle>\n  \u002F* メッセージエリア：初期は非表示 *\u002F\n  #js-empty-message {\n    width: 100%; display: none; text-align: center; padding: 60px 20px;\n  }\n  \n  \u002F* タブコンテナとコンテンツBox：JSで制御するため初期は隠す *\u002F\n  [id^=\"js-parts-tab\"], [id^=\"js-foryou-tabs\"], [id^=\"tab-\"] {\n    display: none;\n  }\n\n  \u002F* アクティブなタブボタンの装飾 *\u002F\n  a[href^=\"#tab-\"].is-active {\n    background-color: var(--s-color-af8b1674) !important;\n  }\n  a[href^=\"#tab-\"].is-active p,\n  a[href^=\"#tab-\"].is-active span {\n    color: #ffffff !important;\n  }\n\u003C\u002Fstyle>",[1057],{"children":1058,"tagName":163},"\u002F* メッセージエリア：初期は非表示 *\u002F\n  #js-empty-message {\n    width: 100%; display: none; text-align: center; padding: 60px 20px;\n  }\n  \n  \u002F* タブコンテナとコンテンツBox：JSで制御するため初期は隠す *\u002F\n  [id^=\"js-parts-tab\"], [id^=\"js-foryou-tabs\"], [id^=\"tab-\"] {\n    display: none;\n  }\n\n  \u002F* アクティブなタブボタンの装飾 *\u002F\n  a[href^=\"#tab-\"].is-active {\n    background-color: var(--s-color-af8b1674) !important;\n  }\n  a[href^=\"#tab-\"].is-active p,\n  a[href^=\"#tab-\"].is-active span {\n    color: #ffffff !important;\n  }","2b812465-0fc5-4148-ba06-10aa8b3e647d",{"robots":1061},"noindex","ヒーローインタビュー｜広島東洋カープ公式サイト","game\u002Fhero","e669376a-2fdd-45dc-afdf-68cd7e683705",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1066,382,323],"0d4202b9-bd16-452f-9456-2f0a3cb67d58",{"head":1068,"id":1070,"type":212,"uuid":1071,"symbolIds":1072},{"title":1069}," キャンプ練習スケジュール｜広島東洋カープ公式サイト","team\u002Fcamp\u002Fschedule","10559d42-47ac-42db-88f9-481561260690",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,823,1073,1074,1075,822,1076,323],"16d1cd5c-ad54-4778-ae6b-6d5afbbbd4f8","3f08b7da-9415-441d-9779-41dfc415daec","36656891-229b-4bb2-a274-8d1f8f26c77b","014f1206-92cc-42fe-9027-2300488299c1",{"head":1078,"id":1084,"type":212,"uuid":1085,"symbolIds":1086},{"customCode":1079,"title":392},{"bodyEnd":1080},[1081],{"memo":1049,"src":1082,"uuid":1083},"\u003Cscript>\n\t\u002F\u002F タブ切り替えを実行する\n\tsetTimeout(initTabs, 300);\n\u003C\u002Fscript>\n\u003Cscript type=\"module\">\n\tconst target = document.getElementById('__nuxt')\n\tconst observer = new MutationObserver(records => {\n\t\tsetTimeout(initTabs, 300);\n\t\tobserver.disconnect();\n\t})\n\tobserver.observe(target, { childList: true })\n\u003C\u002Fscript>","dfb05132-92e6-43cf-bcf3-5404b8cd521a","news_bk","1487e2ed-016c-4d48-86d9-b086ca7dcb9e",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,382,383,323],{"head":1088,"id":1090,"type":212,"uuid":1091,"symbolIds":1092},{"title":1089},"キャンプ情報｜広島東洋カープ公式サイト","team\u002Fcamp","d1564976-14f5-4277-bfc4-3e96adb0b6b1",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1093,823,822,1094,1095,323],"b524bbc6-852c-4ca5-b6f3-79558c576e01","88f110e4-f174-4a4f-a76f-3e009f7a3e53","7dadbd01-a7a2-4551-8412-8d5dfa1c87bb",{"head":1097,"id":1099,"type":212,"uuid":1100,"symbolIds":1101},{"title":1098},"春季キャンプ参加メンバー｜広島東洋カープ公式サイト","team\u