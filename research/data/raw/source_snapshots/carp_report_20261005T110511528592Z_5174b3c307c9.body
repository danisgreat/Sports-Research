		overflow-x: auto;
		overflow-y: hidden;
	}

	#parts-en-howto-scroll #wrap,
	#parts-zh-howto-scroll #wrap {
		min-width: 760px;
	}

	/* 陳特報のスコア表はみ出し */

	@media screen and (max-width: 840px) {
		#score-table {
			overflow-x: auto;
			overflow-y: hidden;
		}

		#score-table>div {
			min-width: 640px;
		}
	}

	/* 成績表組みのswipe-infoの表示制御 */
	@media screen and (min-width: 1441px) {
		[id^="swipe-info-upper-1441"] {
			display: none !important;
		}
	}

	/* 成績表組みランキングのはみ出し */
	[id^="team-status-table"] {
		min-width: 744px;
	}

	/* CMS詳細ページのコンテンツ余白調整 */
	#cms-contents>*:first-child {
		margin-top: 0 !important;
	}

	/* 中国語試合結果詳細表組みのはみ出し */
	[id^="zh-schedule-table"] {
