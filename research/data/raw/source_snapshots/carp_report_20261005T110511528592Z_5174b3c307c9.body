pe":212,"uuid":1839,"symbolIds":1840},{"title":1837},"2023年度助成交付事業 | 公益財団法人 広島スポーツ文化財団","sportsbunkazaidan\u002Freports\u002F2023","e2b3c382-910b-4b91-b284-02ba8fcc1232",[1799,1810,1803],{"head":1842,"id":1844,"type":212,"uuid":1845,"symbolIds":1846},{"title":1843},"過去の助成交付事業 | 公益財団法人 広島スポーツ文化財団","sportsbunkazaidan\u002Freports\u002Farchives","2a2e8313-b232-4365-99ac-80e990e74276",[1799,1810,1803],{"head":1848,"id":1850,"type":212,"uuid":1851,"symbolIds":1852},{"title":1849},"プライバシーポリシー | 公益財団法人 広島スポーツ文化財団","sportsbunkazaidan\u002Fprivacy","182a92e9-6a9a-4e23-b654-108fc0b03399",[1799,1810,1803],{"head":1854,"id":1856,"type":212,"uuid":1857,"symbolIds":1858},{"title":1855},"お問い合わせ | 公益財団法人 広島スポーツ文化財団","sportsbunkazaidan\u002Fcontact","7c60e185-e4e8-46ad-9c3a-5070d821b577",[1799,1810,1803],{"head":1860,"id":1862,"type":212,"uuid":1863,"symbolIds":1864},{"title":1861},"電子公告 | 公益財団法人 広島スポーツ文化財団","sportsbunkazaidan\u002Fdisclosure","88032357-85de-4cd8-a2e3-1def385e171e",[1799,1810,1803],{"head":1866,"id":1877,"type":212,"uuid":1878,"symbolIds":1879},{"customCode":1867,"title":1876},{"bodyEnd":1868,"headEnd":1871},[1869],{"memo":229,"src":1050,"uuid":1870},"505069b1-ea3a-4885-8d9b-3459f18144ff",[1872],{"memo":1145,"src":1055,"tags":1873,"uuid":1875},[1874],{"children":1058,"tagName":163},"c150c783-94d2-48c1-9376-bdc290b17e30","P4 HIROSHIMA｜広島東洋カープ公式サイト","company\u002Fcommunity\u002Fp4-hiroshima","afbd776d-95f9-4e89-ba78-c305ac601447",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,823,822,1095,1533,382,1157,323],{"head":1881,"id":1895,"type":212,"uuid":1896,"symbolIds":1897},{"customCode":1882,"title":1894},{"bodyEnd":1883,"headEnd":1887},[1884],{"memo":1049,"src":1885,"uuid":1886},"\u003Cscript>\n(function () {\n    const initCustomTabs = () => {\n        const containers = document.querySelectorAll('[id^=\"js-parts-tab-\"]');\n        if (containers.length === 0) return false;\n\n        let isAllInitialized = true;\n\n        containers.forEach((container) => {\n            if (container.dataset.initialized === \"true\") return;\n\n            \u002F\u002F hrefに「#tab-」が含まれるものを探す（URL付きでも対応）\n            const tabLinks = container.querySelectorAll('a[href*=\"#tab-\"]');\n            const panels = container.querySelectorAll('[id^=\"tab-\"]');\n            const tabList = container.querySelector('ul');\n\n            if (tabLinks.length === 0 || panels.length === 0) {\n                isAllInitialized = false;\n                return;\n            }\n\n            \u002F\u002F 1. 記事リンクの有無チェック\n            let hasAnyLink = false;\n            panels.forEach(panel => {\n                \u002F\u002F 内部アンカー以外のリンクがあれば記事ありと判定\n                const links = panel.querySelectorAll('a:not([href*=\"#tab-\"])');\n                if (links.length > 0) hasAnyLink = true;\n            });\n\n            if (tabList) {\n                if (!hasAnyLink) {\n                    tabList.style.setProperty('display', 'none', 'important');\n                } else {\n                    tabList.style.removeProperty('display');\n                }\n            }\n\n            \u002F\u002F 2. パネル切り替え関数（クラス付与＋直接CSSで二重に強制表示）\n            const tabs = Array.from(tabLinks).map(a => a.closest('li')).filter(li => li !== null);\n            \n            const activateTab = (targetId) => {\n                \u002F\u002F 全て隠す\n                tabs.forEach(t => t.classList.remove('is-active'));\n                panels.forEach(p => {\n                    p.classList.remove('is-active');\n                    p.style.setProperty('display', 'none', 'important');\n                });\n\n                \u002F\u002F 指定されたIDのみ表示する\n                tabs.forEach(t => {\n                    const a = t.querySelector('a');\n                    if (a && a.getAttribute('href').includes(targetId)) {\n                        t.classList.add('is-active');\n                    }\n                });\n\n                const targetPanel = document.getElementById(targetId);\n                if (targetPanel) {\n                    targetPanel.classList.add('is-active');\n                    \u002F\u002F クラスが消されても大丈夫なように直接スタイルを書き込む\n                    targetPanel.style.setProperty('display', 'flex', 'important');\n                    targetPanel.style.setProperty('flex-direction', 'column', 'important');\n                }\n            };\n\n            \u002F\u002F 3. クリックイベントの設定\n            tabs.forEach((tab, index) => {\n                const link = tab.querySelector('a');\n                \u002F\u002F ★修正箇所：URLの有無に関わらず、#の後ろのIDだけを確実に抽出する\n                const href = link.getAttribute('href');\n                const targetId = href.split('#')[1]; \n\n                if (!tab.dataset.clickEvent) {\n                    link.addEventListener('click', (e) => {\n                        e.preventDefault();\n                        activateTab(targetId);\n                    });\n                    tab.dataset.clickEvent = \"true\";\n                }\n\n                \u002F\u002F 最初のタブをアクティブにする\n                if (index === 0) {\n                    activateTab(targetId);\n                }\n            });\n\n            container.dataset.initialized = \"true\";\n        });\n\n        return isAllInitialized;\n    };\n\n    \u002F\u002F STUDIOの描画完了を待って実行\n    let attempts = 0;\n    const tryInit = setInterval(() => {\n        attempts++;\n        const success = initCustomTabs();\n        if (success || attempts >= 15) clearInterval(tryInit);\n    }, 200);\n\n    \u002F\u002F 万が一イベントが剥がれた場合のための、親要素でのクリック監視（イベント委譲）\n    document.addEventListener('click', (e) => {\n        const link = e.target.closest('[id^=\"js-parts-tab-\"] a[href*=\"#tab-\"]');\n        if (link) {\n            e.preventDefault();\n            const targetId = link.getAttribute('href').split('#')[1];\n            const container = link.closest('[id^=\"js-parts-tab-\"]');\n            \n            if (container) {\n                container.querySelectorAll('li').forEach(li => li.classList.remove('is-active'));\n                container.querySelectorAll('[id^=\"tab-\"]').forEach(p => {\n                    p.classList.remove('is-active');\n                    p.style.setProperty('display', 'none', 'important');\n                });\n                \n                link.closest('li').classList.add('is-active');\n                const targetPanel = document.getElementById(targetId);\n                if(targetPanel) {\n                    targetPanel.classList.add('is-active');\n                    targetPanel.style.setProperty('display', 'flex', 'important');\n                    targetPanel.style.setProperty('flex-direction', 'column', 'important');\n                }\n            }\n        }\n    });\n})();\n\u003C\u002Fscript>","10facb9d-e4a4-462d-8ac0-358f0d55c62d",[1888],{"memo":158,"src":1889,"tags":1890,"uuid":1893},"\u003Cstyle>\n\u002F* タブコンテンツの初期状態：非表示 *\u002F\n[id^=\"js-parts-tab-\"] [id^=\"tab-\"] {\n    display: none !important;\n}\n\n\u002F* アクティブなパネルのみ表示（既存の仕様に合わせflexに設定） *\u002F\n[id^=\"js-parts-tab-\"] [id^=\"tab-\"].is-active {\n    display: flex !important;\n    flex-direction: column;\n}\n\n\u002F* アクティブなタブボタンのスタイル（既存の配色を継承） *\u002F\n[id^=\"js-parts-tab-\"] li.is-active a {\n    background-color: #CA0915 !important;\n}\n\n[id^=\"js-parts-tab-\"] li.is-active a * {\n    color: #fff !important;\n}\n\n\u002F* 記事が一つもない場合にJSで付与する非表示クラス *\u002F\n.tabs-hidden-completely {\n    display: none !important;\n}\n\u003C\u002Fstyle>",[1891],{"children":1892,"tagName":163},"\u002F* タブコンテンツの初期状態：非表示 *\u002F\n[id^=\"js-parts-tab-\"] [id^=\"tab-\"] {\n    display: none !important;\n}\n\n\u002F* アクティブなパネルのみ表示（既存の仕様に合わせflexに設定） *\u002F\n[id^=\"js-parts-tab-\"] [id^=\"tab-\"].is-active {\n    display: flex !important;\n    flex-direction: column;\n}\n\n\u002F* アクティブなタブボタンのスタイル（既存の配色を継承） *\u002F\n[id^=\"js-parts-tab-\"] li.is-active a {\n    background-color: #CA0915 !important;\n}\n\n[id^=\"js-parts-tab-\"] li.is-active a * {\n    color: #fff !important;\n}\n\n\u002F* 記事が一つもない場合にJSで付与する非表示クラス *\u002F\n.tabs-hidden-completely {\n    display: none !important;\n}","5a097a10-4487-4c08-999c-780915a28be9"," 地域交流イベント｜広島東洋カープ公式サイト","company\u002Fcommunity","9b676921-8901-4c54-9c2c-645a669b0dcb",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1347,823,822,382,825,1157,323],{"head":1899,"id":1901,"type":212,"uuid":1902,"symbolIds":1903},{"title":1900},"球場外イベント｜広島東洋カープ公式サイト","company\u002Fcommunity\u002Fout-stadium","dbfa3c4a-0112-4393-bd64-83651a8c544e",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,382,323],{"head":1905,"id":1907,"type":212,"uuid":1908,"symbolIds":1909},{"title":1906},"球場内イベント｜広島東洋カープ公式サイト","company\u002Fcommunity\u002Fin-stadium","2ccf4eef-9b8f-48bf-90c7-129086e877b8",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,382,323],{"head":1911,"id":1913,"type":212,"uuid":1914,"symbolIds":1915},{"title":1912},"球団マスコット「スラィリー」｜広島東洋カープ公式サイト","company\u002Fcommunity\u002Fmascot","bbad0795-eb9b-48e8-b94d-6ad07d65305a",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,825,822,823,323],{"head":1917,"id":1919,"type":212,"uuid":1920,"symbolIds":1921},{"title":1918},"球団商標の無償使用について ｜広島東洋カープ公式サイト","company\u002Fcommunity\u002Ftrademark-policy","057bd941-e142-4bfd-8a1d-89fb4b2177eb",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,823,822,1525,1073,1156,323],{"head":1923,"id":1933,"type":212,"uuid":1934,"symbolIds":1935},{"customCode":1924,"meta":1931,"title":1932},{"bodyEnd":1925,"headEnd":1927},[1926],{"memo":229,"src":1885,"uuid":1661},[1928],{"memo":1145,"src":1889,"tags":1929,"uuid":1668},[1930],{"children":1892,"tagName":163},{"robots":1061},"地域交流イベント一覧｜広島東洋カープ公式サイト","company\u002Fcommunity\u002Farchive","df8a4560-466c-4b38-b02c-12e7b4e2beef",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,382,323],{"head":1937,"id":1947,"type":212,"uuid":1948,"symbolIds":1949},{"customCode":1938,"meta":1946,"title":1894},{"bodyEnd":1939,"headEnd":1942},[1940],{"memo":1049,"src":1941,"uuid":1886},"\u003Cscript>\n\t(function () {\n\t\tconst initCustomTabs = () => {\n\t\t\tconsole.group(\"--- Tab System: Simple Button Toggle ---\");\n\t\t\t\n\t\t\tconst containers = document.querySelectorAll('[id^=\"js-parts-tab-\"]');\n\t\t\t\n\t\t\tcontainers.forEach((container) => {\n\t\t\t\tconst tabLinks = container.querySelectorAll('a[href^=\"#tab-\"]');\n\t\t\t\tconst tabs = Array.from(tabLinks).map(a => a.closest('li')).filter(li => li !== null);\n\t\t\t\tconst panels = container.querySelectorAll('[id^=\"tab-\"]');\n\t\t\t\tconst tabList = container.querySelector('ul'); \u002F\u002F タブボタンの親要素(ul)\n\t\t\t\t\n\t\t\t\t\u002F\u002F 1. 記事リンクの有無だけをチェック\n\t\t\t\tlet hasAnyLink = false;\n\t\t\t\tpanels.forEach(panel => {\n\t\t\t\t\t\u002F\u002F ページ内アンカー(#)以外の、外部\u002F詳細へのリンクがあるか\n\t\t\t\t\tconst links = panel.querySelectorAll('a:not([href^=\"#\"])');\n\t\t\t\t\tif (links.length > 0) {\n\t\t\t\t\t\thasAnyLink = true;\n\t\t\t\t\t}\n\t\t\t\t});\n\n\t\t\t\t\u002F\u002F 2. 記事が1件もなければボタン(ul)だけを隠す\n\t\t\t\tif (!hasAnyLink) {\n\t\t\t\t\tconsole.log(`[${container.id}] 記事リンクがないため、ボタンエリアを隠します。`);\n\t\t\t\t\tif (tabList) {\n\t\t\t\t\t\ttabList.style.setProperty('display', 'none', 'important');\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\tif (tabList) {\n\t\t\t\t\t\ttabList.style.removeProperty('display');\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t\t\t\u002F\u002F 3. タブ切り替え・初期化ロジック\n\t\t\t\t\u002F\u002F 最初のパネル（すべて）に is-active を付与して、STUDIOの標準表示（Empty含）を見えるようにします\n\t\t\t\ttabs.forEach((tab, index) => {\n\t\t\t\t\tconst link = tab.querySelector('a');\n\t\t\t\t\tconst targetId = link.getAttribute('href').replace('#', '');\n\n\t\t\t\t\tlink.addEventListener('click', (e) => {\n\t\t\t\t\t\te.preventDefault();\n\t\t\t\t\t\ttabs.forEach(t => t.classList.remove('is-active'));\n\t\t\t\t\t\tpanels.forEach(p => p.classList.remove('is-active'));\n\t\t\t\t\t\ttab.classList.add('is-active');\n\t\t\t\t\t\tconst targetPanel = document.getElementById(targetId);\n\t\t\t\t\t\tif (targetPanel) targetPanel.classList.add('is-active');\n\t\t\t\t\t});\n\n\t\t\t\t\t\u002F\u002F 記事がなくても「すべて」タブ（index 0）はアクティブ状態にする\n\t\t\t\t\tif (index === 0) {\n\t\t\t\t\t\ttab.classList.add('is-active');\n\t\t\t\t\t\tconst firstPanel = document.getElementById(targetId);\n\t\t\t\t\t\tif (firstPanel) firstPanel.classList.add('is-active');\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t});\n\t\t\tconsole.groupEnd();\n\t\t};\n\n\t\tif (document.readyState === 'loading') {\n\t\t\tdocument.addEventListener('DOMContentLoaded', initCustomTabs);\n\t\t} else {\n\t\t\tsetTimeout(initCustomTabs, 500);\n\t\t}\n\t})();\n\u003C\u002Fscript>",[1943],{"memo":158,"src":1889,"tags":1944,"uuid":1893},[1945],{"children":1892,"tagName":163},{"robots":1061},"company\u002Fcommunity-test","2aed82ac-eb6c-4429-aa97-29ddcb6a9ea0",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1347,823,822,382,825,1157,323],{"head":1951,"id":1953,"type":212,"uuid":1954,"symbolIds":1955},{"title":1952},"カープHISTORY｜広島東洋カープ公式サイト","company\u002Fhistory","bbb70e4e-19c0-48ea-80bf-b748975e96b9",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,382,323],{"head":1957,"id":1958,"type":212,"uuid":1959,"symbolIds":1960},{"title":1574},"company\u002Fsponsor\u002Fcampaign\u002Fin-stadium\u002Fwagamachi-pr","8cd70560-4fad-4062-aade-3213de7758e6",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,82