:1335},"由宇練習場へのアクセス｜広島東洋カープ公式サイト","farm\u002Fyuu","ef59dcb9-17d1-4f8b-b9bc-70a6e4c4df1e",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1095,1093,1339,1074,824,823,1340,323],"b16c179a-6784-426b-b1cd-23b4a27c0ee5","81656b4a-f321-436d-80cc-c3726e264c88",{"head":1342,"id":1344,"type":212,"uuid":1345,"symbolIds":1346},{"title":1343},"ファーム｜広島東洋カープ公式サイト","farm","eef84fc2-0026-41f1-9662-d6b10c8e97a6",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1347,1348,822,1109,825,1349,1350,1094,323],"24c57ece-d8b8-4a03-a866-4ec075e478a8","594b3e6f-f3b3-4d59-ad50-85c175ae42e4","33b51f4d-0236-4a35-bd0f-6ebdfedca844","e0ce94e7-e604-44c7-a017-74f6c4ad7f84",{"head":1352,"id":1353,"type":212,"uuid":1354,"symbolIds":1355},{"title":1343},"farm\u002Fschedule","42e7559c-8683-4f4b-853b-baeae9143fc7",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,382,323],{"head":1357,"id":1358,"type":212,"uuid":1359,"symbolIds":1360},{"title":1133},"farm\u002Fstats\u002F2025","1b4005c2-4ef7-4f9c-8742-d3f883fc79fc",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1074,1123,323],{"id":1362,"isCreatedInV4":23,"redirectTo":1363,"type":218,"uuid":1364},"ticket\u002Findex.html","\u002Fticket","98e6cb2d-f2dd-4967-b065-86f8a4d8c5a9",{"head":1366,"id":1375,"type":212,"uuid":1376,"symbolIds":1377},{"customCode":1367,"title":1374},{"bodyEnd":1368},[1369,1371],{"memo":1216,"src":1217,"uuid":1370},"d37a7631-b749-4602-b4fe-86c46a5a184d",{"memo":1229,"src":1372,"uuid":1373},"\u003Cscript>\n(function() {\n  \u002F\u002F 1. スタイルタグの準備 (重複作成防止)\n  let styleTag = document.getElementById('custom-facility-style-v4');\n  if (!styleTag) {\n    styleTag = document.createElement('style');\n    styleTag.id = 'custom-facility-style-v4';\n    document.head.appendChild(styleTag);\n  }\n\n  \u002F\u002F タブのCSSを書き換える関数\n  function updateFacilityTabStyle(activeHref) {\n    styleTag.innerHTML = `\n      \u002F* 選ばれたタブの背景を強制的に赤にする *\u002F\n      #js-parts-tab-calendar a[href=\"${activeHref}\"] {\n        background-color: #CA0915 !important;\n        transition: none !important;\n      }\n      \u002F* 選ばれたタブの中の文字を強制的に白にする *\u002F\n      #js-parts-tab-calendar a[href=\"${activeHref}\"] p,\n      #js-parts-tab-calendar a[href=\"${activeHref}\"] span {\n        color: #ffffff !important;\n      }\n    `;\n  }\n\n  \u002F\u002F 初期状態：「すべて」タブを赤くする\n  updateFacilityTabStyle('#tab-calendar-all');\n\n  \u002F\u002F イベントの重複登録ストッパー\n  if (window.__facilityFilterInit_v4) return;\n  window.__facilityFilterInit_v4 = true;\n\n  \u002F\u002F ▼検索する施設のキーワード一覧\n  const tabKeywords = [\n    \"事務所\", \"グッズショップ\", \"ギャラリー\", \"カフェ\", \n    \"入場券\", \"むさし\", \"コンコース\", \"ベースボールギャラリー\", \"ツアー\"\n  ];\n\n  \u002F\u002F 2. カレンダーの絞り込み処理\n  document.addEventListener('click', function(e) {\n    const tabLink = e.target.closest('#js-parts-tab-calendar a');\n    if (!tabLink) return;\n\n    \u002F\u002F Studioの標準タブ切り替え機能をブロック\n    e.preventDefault();\n    e.stopPropagation();\n\n    \u002F\u002F 選択されたタブのスタイルを更新（全レスポンシブ共通）\n    const targetHref = tabLink.getAttribute('href');\n    updateFacilityTabStyle(targetHref);\n\n    \u002F\u002F 絞り込みテキストを取得し、空白を除去（例：「マツダ スタジアム」→「マツダスタジアム」）\n    const targetText = tabLink.textContent.trim().replace(\u002F\\s+\u002Fg, '');\n\n    \u002F\u002F ページ内のすべてのカレンダー大枠を取得して強制表示（PC\u002Fスマホの両方）\n    const calendarWrappers = document.querySelectorAll('div[id^=\"tab-calendar\"]');\n    calendarWrappers.forEach(wrapper => {\n      wrapper.style.setProperty('display', 'block', 'important');\n    });\n\n    \u002F\u002F ページ内のすべてのカレンダーリストを取得\n    const calendars = document.querySelectorAll('ul[id^=\"calendar-1\"]');\n    if (calendars.length === 0) return;\n\n    calendars.forEach(calendar => {\n      \u002F\u002F 日付ごとのブロックを取得（\u003Cli>）\n      const dailyBlocks = Array.from(calendar.children).filter(el => el.tagName === 'LI');\n\n      dailyBlocks.forEach(dayBlock => {\n        \u002F\u002F ▼構造に依存せず、その日の中にあるすべての \u003Cp> タグを探す\n        const allP = Array.from(dayBlock.querySelectorAll('p'));\n        const dataRows = [];\n\n        \u002F\u002F 施設名が入っている \u003Cp> を見つけ、その親要素を「1行」として認定する\n        allP.forEach(p => {\n          if (p.parentElement && p.parentElement.firstElementChild === p) {\n            const text = p.textContent.trim().replace(\u002F\\s+\u002Fg, '');\n            const isFacility = tabKeywords.some(kw => text.includes(kw));\n            if (isFacility && !dataRows.includes(p.parentElement)) {\n              dataRows.push(p.parentElement); \u002F\u002F 行として配列に追加\n            }\n          }\n        });\n\n        let visibleRows = [];\n\n        \u002F\u002F 見つけた「行」を一つずつ判定する\n        dataRows.forEach(row => {\n          const firstP = row.firstElementChild;\n          const rowTitle = firstP ? firstP.textContent.trim().replace(\u002F\\s+\u002Fg, '') : '';\n\n          if (targetText === 'すべて' || rowTitle.includes(targetText)) {\n            row.style.setProperty('display', '', 'important');\n            row.style.removeProperty('border-bottom');\n            visibleRows.push(row);\n          } else {\n            row.style.setProperty('display', 'none', 'important');\n          }\n        });\n\n        \u002F\u002F 表示する行のうち、一番最後の行の border-bottom を 0 にする\n        if (visibleRows.length > 0) {\n          visibleRows[visibleRows.length - 1].style.setProperty('border-bottom', '0px', 'important');\n        }\n\n        \u002F\u002F 表示する施設が1件もない場合は、日付ブロックごと非表示にする\n        if (targetText !== 'すべて' && visibleRows.length === 0) {\n          dayBlock.style.setProperty('display', 'none', 'important');\n        } else {\n          dayBlock.style.setProperty('display', '', 'important');\n        }\n      });\n    });\n  }, true);\n})();\n\u003C\u002Fscript>","4602e89b-74af-4baf-887c-17b1263b5b62","営業日カレンダー2026年2月","stadium\u002Foffice-calendar\u002F202602","0e867afa-bf0a-4fef-b8fa-6c3cb8c8fd98",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"head":1379,"id":1385,"type":212,"uuid":1386,"symbolIds":1387},{"customCode":1380,"title":1384},{"bodyEnd":1381},[1382,1383],{"memo":1216,"src":1217,"uuid":1370},{"memo":1229,"src":1372,"uuid":1373},"営業日カレンダー2026年3月","stadium\u002Foffice-calendar\u002F202603","195c8133-5377-4d0c-8a68-e55cd9fb785f",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"head":1389,"id":1395,"type":212,"uuid":1396,"symbolIds":1397},{"customCode":1390,"title":1394},{"bodyEnd":1391},[1392,1393],{"memo":1216,"src":1217,"uuid":1370},{"memo":1229,"src":1372,"uuid":1373},"営業日カレンダー2026年4月","stadium\u002Foffice-calendar\u002F202604","07bb7536-ce5d-450c-afb9-3dbdb2fdfeb1",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"head":1399,"id":1405,"type":212,"uuid":1406,"symbolIds":1407},{"customCode":1400,"title":1404},{"bodyEnd":1401},[1402,1403],{"memo":1216,"src":1217,"uuid":1370},{"memo":1229,"src":1372,"uuid":1373},"営業日カレンダー2026年5月","stadium\u002Foffice-calendar\u002F202605","9cd215ee-be9c-4c41-bce9-8ac7fb8eb992",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"head":1409,"id":1415,"type":212,"uuid":1416,"symbolIds":1417},{"customCode":1410,"title":1414},{"bodyEnd":1411},[1412,1413],{"memo":1216,"src":1217,"uuid":1370},{"memo":1229,"src":1372,"uuid":1373},"営業日カレンダー2026年6月","stadium\u002Foffice-calendar\u002F202606","48af744d-f152-4e83-95f1-f30e854ca8b9",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"head":1419,"id":1425,"type":212,"uuid":1426,"symbolIds":1427},{"customCode":1420,"title":1424},{"bodyEnd":1421},[1422,1423],{"memo":1216,"src":1217,"uuid":1370},{"memo":1229,"src":1372,"uuid":1373},"営業日カレンダー2026年7月","stadium\u002Foffice-calendar\u002F202607","708bf02d-fb07-4380-b0cf-b4afccadfe59",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"head":1429,"id":1435,"type":212,"uuid":1436,"symbolIds":1437},{"customCode":1430,"title":1434},{"bodyEnd":1431},[1432,1433],{"memo":1216,"src":1217,"uuid":1370},{"memo":1229,"src":1372,"uuid":1373},"営業日カレンダー2026年8月","stadium\u002Foffice-calendar\u002F202608","3dcd2eb4-a805-4863-bde1-db357927843d",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"head":1439,"id":1445,"type":212,"uuid":1446,"symbolIds":1447},{"customCode":1440,"title":1444},{"bodyEnd":1441},[1442,1443],{"memo":1216,"src":1217,"uuid":1370},{"memo":1229,"src":1372,"uuid":1373},"営業日カレンダー2026年9月","stadium\u002Foffice-calendar\u002F202609","22b1d0a1-0fce-4ce2-8db6-4f9a733dcab8",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"head":1449,"id":1455,"type":212,"uuid":1456,"symbolIds":1457},{"customCode":1450,"title":1454},{"bodyEnd":1451},[1452,1453],{"memo":1216,"src":1217,"uuid":1370},{"memo":1229,"src":1372,"uuid":1373},"営業日カレンダー2026年10月","stadium\u002Foffice-calendar\u002F202610","dfdcb1ba-2b6f-4dc9-9a71-8cbce0bd39e6",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1198,1073,323],{"head":1459,"id":1461,"type":212,"uuid":1462,"symbolIds":1463},{"title":1460},"トイレについて｜広島東洋カープ公式サイト","stadium\u002Ffacilities\u002Ftoilets\u002Fbarrierfree","55b737c1-0ee4-43d0-8107-b69431f6a141",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1076,825,323],{"head":1465,"id":1466,"type":212,"uuid":1467,"symbolIds":1468},{"title":1460},"stadium\u002Ffacilities\u002Ftoilets","478ee5fe-c2d7-4383-8a38-866ce9ae235e",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1076,825,323],{"head":1470,"id":1472,"type":212,"uuid":1473,"symbolIds":1474},{"title":1471},"マツダ スタジアムコンコースマップ｜広島東洋カープ公式サイト｜広島東洋カープ公式サイト","stadium\u002Ffacilities\u002Fmap\u002Fconcourse-map","c047b352-14b2-4d59-ade5-24d6650b3419",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1095,1475,323],"257d79c7-83b7-489c-ad60-c8aaa30be3f9",{"head":1477,"id":1479,"type":212,"uuid":1480,"symbolIds":1481},{"title":1478},"マツダ スタジアム敷地マップ｜広島東洋カープ公式サイト","stadium\u002Ffacilities\u002Fmap\u002Fsite-map","c15e2243-98cb-406a-b9d8-ea44b0cb2021",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1157,1095,1475,323],{"head":1483,"id":1494,"type":212,"uuid":1495,"symbolIds":1496},{"customCode":1484,"title":1493},{"bodyEnd":1485,"headEnd":1488},[1486],{"memo":229,"src":1050,"uuid":1487},"6480d573-9d2a-43dd-b238-0ac394c8bda7",[1489],{"memo":1145,"src":1055,"tags":1490,"uuid":1492},[1491],{"children":1058,"tagName":163},"f6e6d2fe-043c-403a-bde3-ef862c513b27","来場者フォト｜広島東洋カープ公式サイト","stadium\u002Fphoto","74adddba-00aa-4d31-9d1c-ead3218798e3",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,1066,382,383,323],{"head":1498,"id":1506,"type":212,"uuid":1507,"symbolIds":1508},{"customCode":1499,"title":1505},{"bodyEnd":1500},[1501],{"memo":1502,"src":1503,"uuid":1504},"カレンダー描画・高さ自動調整","\u003Cscript>\n(function() {\n  \u002F\u002F 0.5秒（500ミリ秒）ごとに箱が作られたかチェックし続ける\n  var checkExist = setInterval(function() {\n    var container = document.getElementById(\"ticket-calendar\");\n    \n    \u002F\u002F もし箱が画面に現れたら！\n    if (container) {\n      clearInterval(checkExist); \u002F\u002F 探し続けるのをストップする\n\n      \u002F\u002F 万が一、既にiframeが入っていたら二重に入れるのを防ぐ\n      if (container.innerHTML !== \"\") return;\n\n      \u002F\u002F iframeを自作して箱の中に追加する\n      var iframe = document.createElement(\"iframe\");\n      iframe.src = \"https:\u002F\u002Fwww.ticket.carp.co.jp\u002Fstadium-tour\u002Fcalendar\";\n      iframe.style.width = \"100%\";\n      iframe.style.border = \"none\";\n      iframe.scrolling = \"no\";\n      iframe.style.height = \"500px\"; \u002F\u002F データが来るまでの初期の高さ\n      container.appendChild(iframe);\n\n      \u002F\u002F 先方からの高さ通知（postMessage）を受け取って高さを変える\n      var receiveMessage = function (event) {\n        if (event.origin !== \"https:\u002F\u002Fwww.ticket.carp.co.jp\") return;\n        \n        var contentH = event.data;\n        if (!isNaN(contentH)) {\n          contentH = contentH + \"px\";\n        }\n\n        iframe.style.height = contentH;\n        container.style.height = contentH; \n      };\n\n      window.addEventListener(\"message\", receiveMessage, false);\n    }\n  }, 500); \u002F\u002F 500ミリ秒ごとに探す\n})();\n\u003C\u002Fscript>","adad6e81-5c27-4350-aa57-f595b8b14a40","スタジアムツアー｜広島東洋カープ公式サイト","stadium\u002Ftour","54d1c0e7-b123-4541-8c2b-3752ec583867",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,1109,1348,824,1509,1510,1511,1075,1076,1095,1512,823,1073,323],"cf6da9ad-c24a-4325-9d0e-36b850f9e3b9","783bdc88-5c5c-46c2-8224-9f041cfca345","69fe8eb9-a4f4-480e-aa41-2c4137d0bb89","d2ed8c2b-a7ca-448d-935b-98080e9d60cd",{"head":1514,"id":1516,"type":212,"uuid":1517,"symbolIds":1518},{"title":1515},"広島市民球場 (MAZDA Zoom-Zoomスタジアム広島)｜広島東洋カープ公式サイト","stadium\u002Fabout","58820df8-228d-43b3-9cc5-da0a369e6b4f",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1076,1157,323],{"head":1520,"id":1522,"type":212,"uuid":1523,"symbolIds":1524},{"title":1521},"観戦時のお願い｜広島東洋カープ公式サイト","stadium\u002Frules","9b89a195-4953-4681-94c8-a872e1b2cc5c",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,823,822,1095,1525,1076,323],"9939a29e-2288-4d70-abaa-7d4e19e85aeb",{"head":1527,"id":1529,"type":212,"uuid":1530,"symbolIds":1531},{"title":1528},"観戦・球場｜広島東洋カープ公式サイト","stadium","f0ff993f-f711-4175-9a10-f97189f81b7b",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1532,1533,823,1095,323],"112a6137-3da0-426a-8ca9-4c7a07aefb0f","11e9af02-9f4d-49f7-952e-37d3ba97d977",{"head":1535,"id":1537,"type":212,"uuid":1538,"symbolIds":1539},{"title":1536},"試合観戦契約約款のご案内 前文｜広島東洋カープ公式サイト","stadium\u002Fterms","54b445d0-1345-4e6a-b4e6-110e0dc0cbad",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,323],{"head":1541,"id":1543,"type":212,"uuid":1544,"symbolIds":1545},{"title":1542},"試合観戦契約約款｜広島東洋カープ公式サイト","stadium\u002Fterms\u002Fspectator-agreement","2f08aa08-138e-42ed-ac6d-bd1344300252",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1095,1525,1546,823,323],"48a81270-788d-4a9c-9f13-677496a59dda",{"head":1548,"id":1550,"type":212,"uuid":1551,"symbolIds":1552},{"title":1549},"特別応援許可規程｜広島東洋カープ公式サイト","stadium\u002Fterms\u002Fcheering-permission","eedd67fc-6ad9-4851-8ae3-3701fb31af9b",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,823,822,1525,1546,323],{"head":1554,"id":1556,"type":212,"uuid":1557,"symbolIds":1558},{"title":1555},"写真・動画等の撮影及び配信・送信規程｜広島東洋カープ公式サイト","stadium\u002Fterms\u002Fphoto-video-policy","e49cc7b1-1c25-42c6-9855-ed97f6950e8c",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,823,822,1525,1546,323],{"head":1560,"id":1562,"type":212,"uuid":1563,"symbolIds":1564},{"title":1561},"Outline of the \"Provisions of the Game Watching Contract\" and \"Rules on Permission for Special Cheering”","stadium\u002Fterms\u002Fenglish","5be84dd6-d24d-4745-bafe-c213308dde60",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,823,822,1525,1095,1339,1546,323],{"head":1566,"id":1568,"type":212,"uuid":1569,"symbolIds":1570},{"title":1567},"はじめてのマツダスタジアム観戦ガイド｜広島東洋カープ公式サイト","stadium\u002Fguide","1d5c7287-3f9f-45bf-b0e1-566cddfb2de0",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,1157,825,323],{"head":1572,"id":1575,"type":212,"uuid":1576,"symbolIds":1577},{"meta":1573,"title":1574},{"robots":1061},"わがまち魅力発信隊｜広島東洋カープ公式サイト","stadium\u002Fwagamachi-pr","fd1cf9cc-a2e0-46d8-b941-1963929bd83a",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,824,1578,1093,323],"d74ab8b6-045f-47f1-9a0a-330e83f8d329",{"id":1580,"isCreatedInV4":10,"redirectTo":1581,"type":218,"uuid":1582},"stadium\u002Foffice-calendar-latest","\u002Fstadium\u002Foffice-calendar\u002F202610","9458829c-b048-4a59-8de1-e8cae6c7fc04",{"head":1584,"id":1586,"type":212,"uuid":1587,"symbolIds":1588},{"title":1585},"カープギャラリー（2F）｜広島東洋カープ公式サイト","stadium\u002Fgallery","81abab69-1daf-4290-8d8e-0235cd2279cd",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,1589,323],"51b55fa5-0230-40ab-8261-f4c70a36567f",{"head":1591,"id":1593,"type":212,"uuid":1594,"symbolIds":1595},{"title":1592},"アミューズメント紹介｜広島東洋カープ公式サイト","stadium\u002Famusement","490d5398-e731-4e82-b420-a2d51e018149",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,323],{"head":1597,"id":1599,"type":212,"uuid":1600,"symbolIds":1601},{"title":1598},"Carp ID｜広島東洋カープ公式サイト","carp-id","17861ac6-f366-4845-bfa2-38e82ef4d69f",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1602,1603,1095,823,323],"6736b5e2-3f9b-4664-96b9-046d27ea40f3","04813b6e-8f9c-407c-ada3-19a4d4000b6f",{"head":1605,"id":1607,"type":212,"uuid":1608,"symbolIds":1609},{"title":1606},"よくある質問｜広島東洋カープ公式サイト","carp-id\u002Ffaq","9a9cfb1e-3b7c-42a6-87d3-a32072c99fce",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1610,323],"2c7294f5-ea45-4d10-9616-ebde540fa4e3",{"head":1612,"id":1614,"type":212,"uuid":1615,"symbolIds":1616},{"title":1613},"Carp ID利用規約｜広島東洋カープ公式サイト","carp-id\u002Fterms","fc99b7ad-b415-4ab8-9f49-b9a6561efed5",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,823,822,1095,1525,1546,323],{"id":1618,"isCreatedInV4":23,"redirectTo":1619,"type":218,"uuid":1620},"carpid\u002Frules.html","\u002Fcarp-id\u002Fterms","294d52c5-04bd-4c2c-95ba-46d601e06922",{"id":1622,"isCreatedInV4":23,"redirectTo":1623,"type":218,"uuid":1624},"carpid\u002Ffaq.html","\u002Fcarp-id\u002Ffaq","c153549a-0b58-495e-a5dd-bc2f3fa0d652",{"head":1626,"id":1628,"type":212,"uuid":1629,"symbolIds":1630},{"title":1627},"陳ブログ｜広島東洋カープ公式サイト","chen-blog","72ff78db-0a99-40ac-a457-6375635dddb9",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,1066,382,323],{"head":1632,"id":1634,"type":212,"uuid":1635,"symbolIds":1636},{"title":1633},"陳特報｜広島東洋カープ公式サイト","chen-news","15c4369b-c935-4065-8e6c-2e368e62b8a0",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,1066,382,323],{"head":1638,"id":1640,"type":212,"uuid":1641,"symbolIds":1642},{"title":1639},"カープ陳特報　第1号｜広島東洋カープ公式サイト","chen-news\u002F2026\u002F0327","8d79eab7-9f29-4f2b-b6cc-8846979c300c",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,825,323],{"head":1644,"id":1646,"type":212,"uuid":1647,"symbolIds":1648},{"title":1645},"カープ陳特報　第2号｜広島東洋カープ公式サイト","chen-news\u002F2026\u002F0328","495c4606-1d92-4efe-8776-85d5434edf31",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,825,323],{"head":1650,"id":1652,"type":212,"uuid":1653,"symbolIds":1654},{"title":1651},"カープ陳特報　第3号｜広島東洋カープ公式サイト","chen-news\u002F2026\u002F0329","796bd3c7-5501-44ed-bdca-a7b5e9f375c2",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,825,323],{"head":1656,"id":1670,"type":212,"uuid":1671,"symbolIds":1672},{"customCode":1657,"title":1669},{"bodyEnd":1658,"headEnd":1662},[1659],{"memo":229,"src":1660,"uuid":1661},"\u003Cscript>\n(function() {\n  let retryCount = 0;\n  const maxRetries = 10; \u002F\u002F 最大10回試行\n  const retryInterval = 500; \u002F\u002F 0.5秒おきにチェック\n\n  function adjustTabComponent() {\n    const container = document.querySelector('[id^=\"js-parts-tab\"], [id^=\"js-foryou-tabs\"]');\n    const contentBoxes = document.querySelectorAll('[id^=\"tab-\"]');\n    \n    \u002F\u002F コンポーネント自体が見つからない場合は終了\n    if (!container || contentBoxes.length === 0) return;\n\n    \u002F\u002F ボタンの親要素である ul を特定\n    const tabUl = container.querySelector('ul');\n\n    \u002F\u002F メッセージ要素の取得・作成\n    let emptyMsg = document.getElementById('js-empty-message') || (function() {\n      const div = document.createElement('div');\n      div.id = 'js-empty-message';\n      div.innerHTML = '\u003Cp style=\"font-family:sans-serif; font-size:15px; color:#333; text-align:center;\">開催次第、更新いたします。\u003C\u002Fp>';\n      container.parentNode.insertBefore(div, container);\n      return div;\n    })();\n\n    let validInitialId = null;\n    let hasAnyLink = false;\n    let activeYearCount = 0;\n\n    \u002F\u002F 1. 記事チェックとカウント\n    contentBoxes.forEach(box => {\n      const hasLink = box.querySelector('a') !== null;\n      const tabBtn = document.querySelector(`a[href=\"#${box.id}\"]`);\n      const tabLi = tabBtn ? tabBtn.closest('li') : null;\n\n      if (hasLink) {\n        hasAnyLink = true;\n        if (!box.id.includes('all')) activeYearCount++;\n        if (tabLi) tabLi.style.display = 'inline-block';\n        if (!validInitialId || box.id.includes('all')) validInitialId = box.id;\n      } else {\n        if (tabLi) tabLi.style.display = 'none';\n      }\n    });\n\n    \u002F\u002F ★デバッグ用：現在のカウント状況をコンソールに出力\n    console.log(`[Debug] 試行回数: ${retryCount}, 有効な年度数: ${activeYearCount}, 記事の有無: ${hasAnyLink}`);\n\n    \u002F\u002F --- ここが「繰り返しチェック」の核心部分 ---\n    \u002F\u002F 記事が見つからず、まだリトライ回数に余裕がある場合は、再試行して終了\n    if (!hasAnyLink && retryCount \u003C maxRetries) {\n      retryCount++;\n      \u002F\u002F ★デバッグ用：リトライすることを通知\n      console.log(`[Debug] 記事が見つからないため、${retryInterval}ms後にリトライします...`);\n      setTimeout(adjustTabComponent, retryInterval);\n      return; \n    }\n    \u002F\u002F ------------------------------------------\n\n    \u002F\u002F 2. 表示の最終確定\n    if (!hasAnyLink) {\n      \u002F\u002F 最大回数試しても記事がなかった場合：コンテナを隠し、メッセージを出す\n      container.style.setProperty('display', 'none', 'important');\n      emptyMsg.style.setProperty('display', 'block', 'important');\n    } else {\n      \u002F\u002F 記事があった場合：メッセージを隠し、コンテナを「表示」に上書きする\n      emptyMsg.style.setProperty('display', 'none', 'important');\n      container.style.setProperty('display', 'block', 'important'); \u002F\u002F ここでCSSの隠し設定を上書き\n\n      if (activeYearCount \u003C= 1 && tabUl) {\n        tabUl.style.setProperty('display', 'none', 'important');\n      } else if (tabUl) {\n        tabUl.style.setProperty('display', 'flex', 'important');\n      }\n\n      \u002F\u002F 3. コンテンツBoxの表示（初期アクティブの設定）\n      if (validInitialId) {\n        contentBoxes.forEach(box => {\n          const isActive = (box.id === validInitialId);\n          box.classList.toggle('is-active', isActive);\n          box.style.setProperty('display', isActive ? 'block' : 'none', 'important');\n        });\n        \n        const startBtn = container.querySelector(`a[href=\"#${validInitialId}\"]`);\n        if (startBtn) startBtn.classList.add('is-active');\n      }\n    }\n\n    \u002F\u002F 4. クリックイベント（初期化済みでない場合のみ設定）\n    if (!container.dataset.eventsInitialized) {\n      const allTabBtns = container.querySelectorAll('a[href^=\"#tab-\"]');\n      allTabBtns.forEach(btn => {\n        const newBtn = btn.cloneNode(true);\n        btn.parentNode.replaceChild(newBtn, btn);\n\n        newBtn.addEventListener('click', function(e) {\n          e.preventDefault();\n          e.stopPropagation();\n          const targetId = this.getAttribute('href').replace('#', '');\n          contentBoxes.forEach(box => {\n            const isActive = box.id === targetId;\n            box.classList.toggle('is-active', isActive);\n            box.style.setProperty('display', isActive ? 'block' : 'none', 'important');\n          });\n          const currentBtns = container.querySelectorAll('a[href^=\"#tab-\"]');\n          currentBtns.forEach(b => b.classList.toggle('is-active', b.getAttribute('href') === `#${targetId}`));\n        });\n      });\n      container.dataset.eventsInitialized = \"true\";\n    }\n  }\n\n  \u002F\u002F 初回実行\n  adjustTabComponent();\n  \u002F\u002F STUDIOの読み込み完了（load）時にもう一度トリガー\n  window.addEventListener('load', adjustTabComponent);\n})();\n\u003C\u002Fscript>","2866b1f5-ccb3-4205-a423-d068ff090618",[1663],{"memo":1145,"src":1664,"tags":1665,"uuid":1668},"\u003Cstyle>\n  \u002F* メッセージエリア：初期は非表示 *\u002F\n  #js-empty-message {\n    width: 100%; display: none; text-align: center; padding: 60px 20px;\n  }\n  \n  \u002F* IDの接頭辞が一致するタブコンポーネントを最初から隠す *\u002F\n  [id^=\"js-parts-tab\"], [id^=\"js-foryou-tabs\"], #js-empty-message {\n    display: none !important;\n  }\n\n  \u002F* アクティブなタブボタンの装飾 *\u002F\n  a[href^=\"#tab-\"].is-active {\n    background-color: var(--s-color-af8b1674) !important;\n  }\n  a[href^=\"#tab-\"].is-active p,\n  a[href^=\"#tab-\"].is-active span {\n    color: #ffffff !important;\n  }\n\u003C\u002Fstyle>\n",[1666],{"children":1667,"tagName":163},"\u002F* メッセージエリア：初期は非表示 *\u002F\n  #js-empty-message {\n    width: 100%; display: none; text-align: center; padding: 60px 20px;\n  }\n  \n  \u002F* IDの接頭辞が一致するタブコンポーネントを最初から隠す *\u002F\n  [id^=\"js-parts-tab\"], [id^=\"js-foryou-tabs\"], #js-empty-message {\n    display: none !important;\n  }\n\n  \u002F* アクティブなタブボタンの装飾 *\u002F\n  a[href^=\"#tab-\"].is-active {\n    background-color: var(--s-color-af8b1674) !important;\n  }\n  a[href^=\"#tab-\"].is-active p,\n  a[href^=\"#tab-\"].is-active span {\n    color: #ffffff !important;\n  }","df6c82f6-8b9d-4e75-95ec-65d93c8365e5","職レポ｜広島東洋カープ公式サイト","staff-report","8b0db987-dbef-4418-baba-0d5c94e3705e",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,382,323],{"head":1674,"id":1689,"type":212,"uuid":1690,"symbolIds":1691},{"customCode":1675,"title":1688},{"bodyEnd":1676,"headEnd":1681},[1677],{"memo":1678,"src":1679,"uuid":1680},"tab","\u003Cscript>\n(function() {\n  const initTab = () => {\n    const tabs = document.querySelectorAll('input[name=\"tab\"]');\n    if (tabs.length > 0 && !Array.from(tabs).some(t => t.checked)) {\n      \u002F\u002F 最初のタブをチェック\n      tabs[0].checked = true;\n      \u002F\u002F 状態変化をブラウザに通知（:hasの再計算を促す）\n      tabs[0].dispatchEvent(new Event('change', { bubbles: true }));\n    }\n  };\n\n  \u002F\u002F STUDIOのレンダリングに合わせて複数タイミングで実行\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initTab);\n  } else {\n    initTab();\n  }\n  \u002F\u002F 保険：window.loadでも実行\n  window.addEventListener('load', initTab);\n})();\n\u003C\u002Fscript>","7eae316b-2d7b-4c34-9b3c-52fcf31dace2",[1682],{"memo":1678,"src":1683,"tags":1684,"uuid":1687},"\u003Cstyle>\n  \u002F* 1. デフォルトは非表示。ただし最初の1つだけはJSなしでも表示されるように設定（保険） *\u002F\n  #tab-wrap-1, #tab-wrap-2, #tab-wrap-3, #tab-wrap-4 {\n    display: none !important;\n  }\n\n  \u002F* 2. :has() を使い、最も近い共通の親要素、あるいは html レベルで判定 *\u002F\n  \u002F* body ではなく :root (html) または直接指定で精度を上げます *\u002F\n  :root:has(input[name=\"tab\"][value=\"1\"]:checked) #tab-wrap-1,\n  :root:has(input[name=\"tab\"][value=\"2\"]:checked) #tab-wrap-2,\n  :root:has(input[name=\"tab\"][value=\"3\"]:checked) #tab-wrap-3,\n  :root:has(input[name=\"tab\"][value=\"4\"]:checked) #tab-wrap-4 {\n    display: flex !important;\n  }\n\n  \u002F* 3. 選択中のラベルのデザイン（!importantでSTUDIOのスタイルを上書き） *\u002F\n  #tab-btns label:has(input:checked) {\n    background-color: #ca0915 !important;\n  }\n  #tab-btns label:has(input:checked) span {\n    color: #FFFFFF !important;\n  }\n  \n  \u002F* ラジオボタン自体は邪魔な場合が多いので隠す（必要に応じて） *\u002F\n  input[name=\"tab\"] {\n    display: none;\n  }\n\u003C\u002Fstyle>",[1685],{"children":1686,"tagName":163},"\u002F* 1. デフォルトは非表示。ただし最初の1つだけはJSなしでも表示されるように設定（保険） *\u002F\n  #tab-wrap-1, #tab-wrap-2, #tab-wrap-3, #tab-wrap-4 {\n    display: none !important;\n  }\n\n  \u002F* 2. :has() を使い、最も近い共通の親要素、あるいは html レベルで判定 *\u002F\n  \u002F* body ではなく :root (html) または直接指定で精度を上げます *\u002F\n  :root:has(input[name=\"tab\"][value=\"1\"]:checked) #tab-wrap-1,\n  :root:has(input[name=\"tab\"][value=\"2\"]:checked) #tab-wrap-2,\n  :root:has(input[name=\"tab\"][value=\"3\"]:checked) #tab-wrap-3,\n  :root:has(input[name=\"tab\"][value=\"4\"]:checked) #tab-wrap-4 {\n    display: flex !important;\n  }\n\n  \u002F* 3. 選択中のラベルのデザイン（!importantでSTUDIOのスタイルを上書き） *\u002F\n  #tab-btns label:has(input:checked) {\n    background-color: #ca0915 !important;\n  }\n  #tab-btns label:has(input:checked) span {\n    color: #FFFFFF !important;\n  }\n  \n  \u002F* ラジオボタン自体は邪魔な場合が多いので隠す（必要に応じて） *\u002F\n  input[name=\"tab\"] {\n    display: none;\n  }","20633be5-29b5-4f86-ad8f-41f76b1afb8a","商標・肖像利用について｜広島東洋カープ公式サイト","guidelines\u002Ftrademark","2a378da1-6008-47df-8ba6-93c37cda5be7",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,823,1095,1525,1339,1076,1156,1074,824,1073,323],{"head":1693,"id":1695,"type":212,"uuid":1696,"symbolIds":1697},{"title":1694},"ホームランガール｜広島東洋カープ公式サイト","recruit\u002Fpart-time\u002Fhome-run-girl","4ed4a1ac-f6f3-4e7c-afbc-5406c79dbcda",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1093,1109,822,1076,823,824,1156,338,323],{"head":1699,"id":1701,"type":212,"uuid":1702,"symbolIds":1703},{"title":1700},"チケット販売スタッフ｜広島東洋カープ公式サイト","recruit\u002Fpart-time\u002Fticket-sales","e5ec8d61-01c4-460a-972d-3c2757c4fff4",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1076,824,823,1156,338,323],{"head":1705,"id":1707,"type":212,"uuid":1708,"symbolIds":1709},{"title":1706},"ホスピタリティスタッフ｜広島東洋カープ公式サイト","recruit\u002Fpart-time\u002Fhospitality","724793d8-8eb6-4a6e-af2f-8f0ee95ded8a",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,822,1076,824,823,1156,338,323],{"head":1711,"id":1713,"type":212,"uuid":1714,"symbolIds":1715},{"title":1712},"ボールボーイ｜広島東洋カープ公式サイト","recruit\u002Fpart-time\u002Fball-boy","b7bceb4b-e31f-420a-927c-2eff23253161",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293,318,319,381,1093,822,1076,1075,1716,824,1156,338,323],"10904bd3-2e46-42fb-bcd1-7ef96ae00103",{"head":1718,"id":1720,"type":212,"uuid":1721,"symbolIds":1722},{"title":1719},"新卒採用｜広島東洋カープ公式サイト","recruit\u002Fnew-graduate","e8ef02f5-21fe-4b20-aab8-2da3b1351268",[294,295,296,297,292,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,291,293