ute('aria-hidden'));\n\t\t\tconst observer = new MutationObserver(mutationList => {\n\t\t\t\tfor (const mut of mutationList) {\n\t\t\t\t\tif (mut.type === 'attributes' && mut.attributeName === 'aria-hidden') {\n\t\t\t\t\t\tconst newVal = normalize(target.getAttribute('aria-hidden'));\n\t\t\t\t\t\tif (prev === 'true' && newVal === 'false') {\n\t\t\t\t\t\t\tcallback();\n\t\t\t\t\t\t}\n\t\t\t\t\t\tprev = newVal;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t});\n\t\t\tobserver.observe(target, { attributes: true, attributeFilter: ['aria-hidden'] });\n\t\t\treturn observer;\n\t\t}\n\t\tconst studioCanvas = document.querySelector('.StudioCanvas');\n\t\tconst toggleButtons = document.querySelectorAll('#js-toggle-menu button');\n\t\tif (toggleButtons.length && studioCanvas) {\n\t\t\ttoggleButtons.forEach(button => {\n\t\t\t\tbutton.addEventListener('click', () => {\n\t\t\t\t\tif (button.classList.contains('is-open')) return;\n\n\t\t\t\t\tbutton.classList.add('is-open');\n\n\t\t\t\t\tconst observer = watchAriaHiddenChange(studioCanvas, () => {\n\t\t\t\t\t\tbutton.classList.remove('is-open');\n\n\t\t\t\t\t\tobserver.disconnect();\n\t\t\t\t\t});\n\t\t\t\t});\n\t\t\t});\n\t\t}\n\t})();\n\u003C\u002Fscript>\n\u003Cscript>\n\t\u002F\u002F タブ切り替え時のクラス付与\n\tfunction initTabs() {\n\t\t$('[id^=\"js-tab\"], [id^=\"js-parts-tab\"]').each(function () {\n\t\t\tconst $el = $(this);\n\t\t\tif ($el.hasClass('ui-tabs')) {\n\t\t\t\treturn;\n\t\t\t}\n\t\t\t$el.tabs({\n\t\t\t\tactivate: function (event, ui) {\n\t\t\t\t\tui.newPanel.css({ display: 'flex' });\n\t\t\t\t}\n\t\t\t});\n\t\t});\n\t}\n\u003C\u002Fscript>\n","3c13938c-5a60-4711-9bf5-76b986bf24af",{"memo":153,"src":154,"uuid":155},"アプリでのヘッダ・フッタ非表示","\u003Cscript>\n(function() {\n    function hideElements() {\n        \u002F\u002F bodyがない場合はリトライ（STUDIOの読み込み待ち対策）\n        if (!document.body) {\n            setTimeout(hideElements, 100);\n            return;\n        }\n\n        \u002F\u002F 1. 判定（大文字・小文字を区別しない）\n        const ua = navigator.userAgent.toLowerCase();\n        const urlParams = new URLSearchParams(window.location.search);\n        \n        \u002F\u002F carpidapp (小文字) で比較することで、CarpIdApp等にもヒット\n        const isCarpApp = ua.includes('carpidapp') || urlParams.has('app_test');\n\n        if (!isCarpApp) return;\n\n        \u002F\u002F 2. CSSを注入\n        const style = document.createElement('style');\n        style.innerHTML = `\n            #site-header, #site-footer, #breadcrumb, #header, #backbtn { \n                display: none !important; \n            }\n            body { \n                padding-top: 0 !important; \n                margin-top: 0 !important; \n            }\n            .StudioCanvas { \n                padding-top: 0 !important; \n                margin-top: -60px !important; \n                padding-bottom: 60px !important; \n            }\n        `;\n        document.head.appendChild(style);\n    }\n\n    \u002F\u002F 実行タイミングの制御\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', hideElements);\n    } else {\n        hideElements();\n    }\n})();\n\u003C\u002Fscript>","4f408a7c-fe8f-4404-898a-22a5fea3df7f",[157,165,173,186],{"memo":158,"src":159,"tags":160,"uuid":164},"カスタムCSS","\u003Cstyle>\n\t\u002F* デフォルトスタイル *\u002F\n\ta:hover {\n\t\topacity: 0.6;\n\t}\n\n\timg {\n\t\tobject-fit: cover;\n\t}\n\n\t@media screen and (max-width: 840px) {\n\t\t[id^=\"table\"] {\n\t\t\toverflow: scroll;\n\t\t}\n\n\t\t[id^=\"table\"]>div {\n\t\t\tmin-width: 840px;\n\t\t}\n\t}\n\n\t@media screen and (max-width: 540px) {\n\t\t[id^=\"small-table\"] {\n\t\t\toverflow: scroll;\n\t\t}\n\n\t\t[id^=\"small-table\"]>div {\n\t\t\tmin-width: 540px;\n\t\t}\n\t}\n\n\t\u002F* メガヘッダー高さ制限 *\u002F\n\t[id^=\"js-scroll-\"] {\n\t\tmax-height: calc(100vh - 263px);\n\t\toverflow-y: auto;\n\t\toverflow-x: hidden;\n\t}\n\n\t@media screen and (max-width: 1140px) {\n\t\t[id^=\"js-scroll-\"] {\n\t\t\tmax-height: calc(100vh - 219px);\n\t\t}\n\t}\n\n\t@media screen and (max-width: 840px) {\n\t\t[id^=\"js-scroll-\"] {\n\t\t\tmax-height: calc(100vh - 114px);\n\t\t}\n\t}\n\n\t\u002F* モーダルメニュー開閉時の色変更 *\u002F\n\t#js-toggle-menu li:last-child {\n\t\tborder-right: none !important;\n\t}\n\n\t#js-toggle-menu button.is-open {\n\t\tbackground-color: #2E2F3B !important;\n\t}\n\n\t#js-toggle-menu button.is-open * {\n\t\tcolor: #fff !important;\n\t}\n\n\t#js-toggle-menu button.is-open *:first-child {\n\t\tcolor: #DCDCDC !important;\n\t}\n\n\t\u002F* パーツタブ切り替え時の色変更 *\u002F\n\t[id^=\"js-parts-tab\"] .ui-state-active a,\n\t[id^=\"js-parts-tab\"] .ui-state-active a:link,\n\t[id^=\"js-parts-tab\"] .ui-state-active a:visited {\n\t\tbackground-color: #CA0915 !important;\n\t}\n\n\t[id^=\"js-parts-tab\"] .ui-state-active a *,\n\t[id^=\"js-parts-tab\"] .ui-state-active a:link *,\n\t[id^=\"js-parts-tab\"] .ui-state-active a:visited * {\n\t\tcolor: #fff !important;\n\t}\n\n\t\u002F* フッターメニューの下線削除 *\u002F\n\t[id^=\"footer-menu\"] li:first-child,\n\t[id^=\"footer-menu\"] li:first-child a {\n\t\tborder-top: none;\n\t}\n\n\t\u002F* トップタブ切り替え時の色変更 *\u002F\n\t[id^=\"js-tab-foryou-atv\"] {\n\t\tdisplay: none !important;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li {\n\t\tposition: relative;\n\t\ttransition: none;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li:first-child,\n\t[id^=\"js-foryou-tabs\"] li:last-child {\n\t\tz-index: 1;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li:first-child::before,\n\t[id^=\"js-foryou-tabs\"] li:last-child::before {\n\t\tcontent: \"\";\n\t\twidth: 1px;\n\t\theight: 100%;\n\t\tposition: absolute;\n\t\ttop: 0;\n\t\tbackground: linear-gradient(to bottom, #fff 0%, #fff 12%, #8E8E8E 12%, #8E8E8E 88%, #fff 88%, #fff 100%);\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li:first-child::before {\n\t\tright: -2px;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li:last-child::before {\n\t\tleft: -2px;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li.ui-state-active {\n\t\tborder-top: 3px solid #CA0915 !important;\n\t\tborder-left: 3px solid #CA0915 !important;\n\t\tborder-right: 3px solid #CA0915 !important;\n\t\tborder-bottom: none !important;\n\t\tz-index: 2 !important;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li.ui-state-active:before {\n\t\tdisplay: none !important;\n\t}\n\n\t@media screen and (max-width: 540px) {\n\t\t[id^=\"js-foryou-tabs\"] li.ui-state-active {\n\t\t\tborder-top: 2px solid #CA0915 !important;\n\t\t\tborder-left: 2px solid #CA0915 !important;\n\t\t\tborder-right: 2px solid #CA0915 !important;\n\t\t\tborder-bottom: none;\n\t\t}\n\t}\n\n\t[id^=\"js-foryou-tabs\"] .ui-state-active *,\n\t[id^=\"js-foryou-tabs\"] .ui-state-active *:link,\n\t[id^=\"js-foryou-tabs\"] .ui-state-active *:visited {\n\t\tborder: none !important;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] .ui-state-active [id^=\"js-tab-foryou-non\"] {\n\t\tdisplay: none !important;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] .ui-state-active [id^=\"js-tab-foryou-atv\"] {\n\t\tdisplay: block !important;\n\t}\n\n\t\u002F* パンくずの文字数制限 *\u002F\n\n\t#breadcrumb li p {\n\t\tdisplay: -webkit-box;\n\t\t-webkit-box-orient: vertical;\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n\t\t-webkit-line-clamp: 1;\n\t\tmax-width: 180px;\n\t}\n\n\t@media screen and (max-width: 540px) {\n\t\t#breadcrumb li p {\n\t\t\tmax-width: 100px;\n\t\t}\n\t}\n\n\t\u002F* linkbox-01のボタンサイズ調整 *\u002F\n\n\t[id^=\"linkbox-01\"] p+div {\n\t\twidth: 100% !important;\n\t\tmax-width: 322px !important;\n\t}\n\n\t\u002F* 横幅330pxのボタン伸縮 *\u002F\n\n\t[id^=\"button-330\"] {\n\t\twidth: 100% !important;\n\t\tmax-width: 330px !important;\n\t}\n\n\t\u002F* 汎用モーダルの高さ制限 *\u002F\n\t[id^=\"modal\"] {\n\t\tmax-height: 90vh;\n\t\toverflow-y: auto;\n\t\toverflow-x: hidden;\n\t}\n\n\t\u002F* 年間指定席メニュー項目のborder調整 *\u002F\n\t@media screen and (max-width: 840px) {\n\t\t#menu-season-ticket li:last-child {\n\t\t\tborder-right: none;\n\t\t}\n\t}\n\n\t@media screen and (max-width: 320px) {\n\t\t#menu-season-ticket li:nth-child(even) {\n\t\t\tborder-right: none;\n\t\t}\n\t}\n\n\t\u002F* 最小幅840pxではみ出す画像 *\u002F\n\t@media screen and (max-width: 1140px) {\n\t\t[id^=\"width-840-scroll\"] img {\n\t\t\tmin-width: 840px;\n\t\t\twidth: 840px;\n\t\t}\n\t}\n\n\t\u002F* Game Scheduleカレンダーのはみ出し *\u002F\n\t#parts-en-sche-scroll,\n\t#parts-zh-sche-scroll {\n\t\toverflow-x: auto;\n\t\toverflow-y: hidden;\n\t}\n\n\t#parts-en-sche-scroll ul,\n\t#parts-zh-sche-scroll ul {\n\t\tmin-width: 510px;\n\t}\n\n\t\u002F* How To Buy Tickets空席表のはみ出し *\u002F\n\t#parts-en-howto-scroll,\n\t#parts-zh-howto-scroll {\n\t\toverflow-x: auto;\n\t\toverflow-y: hidden;\n\t}\n\n\t#parts-en-howto-scroll #wrap,\n\t#parts-zh-howto-scroll #wrap {\n\t\tmin-width: 760px;\n\t}\n\n\t\u002F* 陳特報のスコア表はみ出し *\u002F\n\n\t@media screen and (max-width: 840px) {\n\t\t#score-table {\n\t\t\toverflow-x: auto;\n\t\t\toverflow-y: hidden;\n\t\t}\n\n\t\t#score-table>div {\n\t\t\tmin-width: 640px;\n\t\t}\n\t}\n\n\t\u002F* 成績表組みのswipe-infoの表示制御 *\u002F\n\t@media screen and (min-width: 1441px) {\n\t\t[id^=\"swipe-info-upper-1441\"] {\n\t\t\tdisplay: none !important;\n\t\t}\n\t}\n\n\t\u002F* 成績表組みランキングのはみ出し *\u002F\n\t[id^=\"team-status-table\"] {\n\t\tmin-width: 744px;\n\t}\n\n\t\u002F* CMS詳細ページのコンテンツ余白調整 *\u002F\n\t#cms-contents>*:first-child {\n\t\tmargin-top: 0 !important;\n\t}\n\n\t\u002F* 中国語試合結果詳細表組みのはみ出し *\u002F\n\t[id^=\"zh-schedule-table\"] {\n\t\tmin-width: 510px;\n\t}\n\n\t\u002F* バイヤーズチョイスナビ背景色 *\u002F\n\t#js-bc-links a.link-active,\n\t#js-bc-links a:hover {\n\t\tbackground-color: rgba(234, 74, 60, 0.2);\n\t}\n\n\t\u002F* 営業日カレンダーの「すべて」を隠す *\u002F\n\t[id^=\"calendar-all-list\"] li:first-child {\n\t\tdisplay: none !important;\n\t}\n\n\t\u002F* トップSNS&BLOG 横線の調整 *\u002F\n\t@media screen and (max-width: 540px) {\n\t\t[id^=\"top-sns-blog-list\"] li:nth-child(even) {\n\t\t\tborder-right: none;\n\t\t}\n\t}\n\n\t\u002F* トップスライダーのボタン調整 *\u002F\n\n\t[id^=\"top-slider-arrows\"] {\n\t\ttop: 0 !important;\n    bottom: 0 !important;\n    margin: auto !important;\n\t}\n\n\t@media screen and (max-width: 840px) {\n\t\t[id^=\"top-slider-arrows\"] {\n\t\t\ttop: initial !important;\n\t\t}\n\t}\n\n\t\u002F* --------------------------------------------------\n\t\t2025年度のタブ要素を非表示にする設定\n\t\t前提：タブの並び順が「1.すべて」「2.2025」であること\n\t-------------------------------------------------- *\u002F\n\n\t\u002F* 親要素が tab-second-none の場合、2番目のリスト項目(li)を隠す *\u002F\n\t#tab-second-none ul li:nth-of-type(2) {\n\t\tdisplay: none !important;\n\t}\n\n\t\u002F* 親要素が tab-second-none の場合、2番目のコンテンツ領域(div)を隠す *\u002F\n\t#tab-second-none div:nth-of-type(2) {\n\t\tdisplay: none !important;\n\t}\n\u003C\u002Fstyle>\n",[161],{"children":162,"tagName":163},"\u002F* デフォルトスタイル *\u002F\n\ta:hover {\n\t\topacity: 0.6;\n\t}\n\n\timg {\n\t\tobject-fit: cover;\n\t}\n\n\t@media screen and (max-width: 840px) {\n\t\t[id^=\"table\"] {\n\t\t\toverflow: scroll;\n\t\t}\n\n\t\t[id^=\"table\"]>div {\n\t\t\tmin-width: 840px;\n\t\t}\n\t}\n\n\t@media screen and (max-width: 540px) {\n\t\t[id^=\"small-table\"] {\n\t\t\toverflow: scroll;\n\t\t}\n\n\t\t[id^=\"small-table\"]>div {\n\t\t\tmin-width: 540px;\n\t\t}\n\t}\n\n\t\u002F* メガヘッダー高さ制限 *\u002F\n\t[id^=\"js-scroll-\"] {\n\t\tmax-height: calc(100vh - 263px);\n\t\toverflow-y: auto;\n\t\toverflow-x: hidden;\n\t}\n\n\t@media screen and (max-width: 1140px) {\n\t\t[id^=\"js-scroll-\"] {\n\t\t\tmax-height: calc(100vh - 219px);\n\t\t}\n\t}\n\n\t@media screen and (max-width: 840px) {\n\t\t[id^=\"js-scroll-\"] {\n\t\t\tmax-height: calc(100vh - 114px);\n\t\t}\n\t}\n\n\t\u002F* モーダルメニュー開閉時の色変更 *\u002F\n\t#js-toggle-menu li:last-child {\n\t\tborder-right: none !important;\n\t}\n\n\t#js-toggle-menu button.is-open {\n\t\tbackground-color: #2E2F3B !important;\n\t}\n\n\t#js-toggle-menu button.is-open * {\n\t\tcolor: #fff !important;\n\t}\n\n\t#js-toggle-menu button.is-open *:first-child {\n\t\tcolor: #DCDCDC !important;\n\t}\n\n\t\u002F* パーツタブ切り替え時の色変更 *\u002F\n\t[id^=\"js-parts-tab\"] .ui-state-active a,\n\t[id^=\"js-parts-tab\"] .ui-state-active a:link,\n\t[id^=\"js-parts-tab\"] .ui-state-active a:visited {\n\t\tbackground-color: #CA0915 !important;\n\t}\n\n\t[id^=\"js-parts-tab\"] .ui-state-active a *,\n\t[id^=\"js-parts-tab\"] .ui-state-active a:link *,\n\t[id^=\"js-parts-tab\"] .ui-state-active a:visited * {\n\t\tcolor: #fff !important;\n\t}\n\n\t\u002F* フッターメニューの下線削除 *\u002F\n\t[id^=\"footer-menu\"] li:first-child,\n\t[id^=\"footer-menu\"] li:first-child a {\n\t\tborder-top: none;\n\t}\n\n\t\u002F* トップタブ切り替え時の色変更 *\u002F\n\t[id^=\"js-tab-foryou-atv\"] {\n\t\tdisplay: none !important;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li {\n\t\tposition: relative;\n\t\ttransition: none;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li:first-child,\n\t[id^=\"js-foryou-tabs\"] li:last-child {\n\t\tz-index: 1;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li:first-child::before,\n\t[id^=\"js-foryou-tabs\"] li:last-child::before {\n\t\tcontent: \"\";\n\t\twidth: 1px;\n\t\theight: 100%;\n\t\tposition: absolute;\n\t\ttop: 0;\n\t\tbackground: linear-gradient(to bottom, #fff 0%, #fff 12%, #8E8E8E 12%, #8E8E8E 88%, #fff 88%, #fff 100%);\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li:first-child::before {\n\t\tright: -2px;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li:last-child::before {\n\t\tleft: -2px;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li.ui-state-active {\n\t\tborder-top: 3px solid #CA0915 !important;\n\t\tborder-left: 3px solid #CA0915 !important;\n\t\tborder-right: 3px solid #CA0915 !important;\n\t\tborder-bottom: none !important;\n\t\tz-index: 2 !important;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] li.ui-state-active:before {\n\t\tdisplay: none !important;\n\t}\n\n\t@media screen and (max-width: 540px) {\n\t\t[id^=\"js-foryou-tabs\"] li.ui-state-active {\n\t\t\tborder-top: 2px solid #CA0915 !important;\n\t\t\tborder-left: 2px solid #CA0915 !important;\n\t\t\tborder-right: 2px solid #CA0915 !important;\n\t\t\tborder-bottom: none;\n\t\t}\n\t}\n\n\t[id^=\"js-foryou-tabs\"] .ui-state-active *,\n\t[id^=\"js-foryou-tabs\"] .ui-state-active *:link,\n\t[id^=\"js-foryou-tabs\"] .ui-state-active *:visited {\n\t\tborder: none !important;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] .ui-state-active [id^=\"js-tab-foryou-non\"] {\n\t\tdisplay: none !important;\n\t}\n\n\t[id^=\"js-foryou-tabs\"] .ui-state-active [id^=\"js-tab-foryou-atv\"] {\n\t\tdisplay: block !important;\n\t}\n\n\t\u002F* パンくずの文字数制限 *\u002F\n\n\t#breadcrumb li p {\n\t\tdisplay: -webkit-box;\n\t\t-webkit-box-orient: vertical;\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n\t\t-webkit-line-clamp: 1;\n\t\tmax-width: 180px;\n\t}\n\n\t@media screen and (max-width: 540px) {\n\t\t#breadcrumb li p {\n\t\t\tmax-width: 100px;\n\t\t}\n\t}\n\n\t\u002F* linkbox-01のボタンサイズ調整 *\u002F\n\n\t[id^=\"linkbox-01\"] p+div {\n\t\twidth: 100% !important;\n\t\tmax-width: 322px !important;\n\t}\n\n\t\u002F* 横幅330pxのボタン伸縮 *\u002F\n\n\t[id^=\"button-330\"] {\n\t\twidth: 100% !important;\n\t\tmax-width: 330px !important;\n\t}\n\n\t\u002F* 汎用モーダルの高さ制限 *\u002F\n\t[id^=\"modal\"] {\n\t\tmax-height: 90vh;\n\t\toverflow-y: auto;\n\t\toverflow-x: hidden;\n\t}\n\n\t\u002F* 年間指定席メニュー項目のborder調整 *\u002F\n\t@media screen and (max-width: 840px) {\n\t\t#menu-season-ticket li:last-child {\n\t\t\tborder-right: none;\n\t\t}\n\t}\n\n\t@media screen and (max-width: 320px) {\n\t\t#menu-season-ticket li:nth-child(even) {\n\t\t\tborder-right: none;\n\t\t}\n\t}\n\n\t\u002F* 最小幅840pxではみ出す画像 *\u002F\n\t@media screen and (max-width: 1140px) {\n\t\t[id^=\"width-840-scroll\"] img {\n\t\t\tmin-width: 840px;\n\t\t\twidth: 840px;\n\t\t}\n\t}\n\n\t\u002F* Game Scheduleカレンダーのはみ出し *\u002F\n\t#parts-en-sche-scroll,\n\t#parts-zh-sche-scroll {\n\t\toverflow-x: auto;\n\t\toverflow-y: hidden;\n\t}\n\n\t#parts-en-sche-scroll ul,\n\t#parts-zh-sche-scroll ul {\n\t\tmin-width: 510px;\n\t}\n\n\t\u002F* How To Buy Tickets空席表のはみ出し *\u002F\n\t#parts-en-howto-scroll,\n\t#parts-zh-howto-scroll {\n\t\toverflow-x: auto;\n\t\toverflow-y: hidden;\n\t}\n\n\t#parts-en-howto-scroll #wrap,\n\t#parts-zh-howto-scroll #wrap {\n\t\tmin-width: 760px;\n\t}\n\n\t\u002F* 陳特報のスコア表はみ出し *\u002F\n\n\t@media screen and (max-width: 840px) {\n\t\t#score-table {\n\t\t\toverflow-x: auto;\n\t\t\toverflow-y: hidden;\n\t\t}\n\n\t\t#score-table>div {\n\t\t\tmin-width: 640px;\n\t\t}\n\t}\n\n\t\u002F* 成績表組みのswipe-infoの表示制御 *\u002F\n\t@media screen and (min-width: 1441px) {\n\t\t[id^=\"swipe-info-upper-1441\"] {\n\t\t\tdisplay: none !important;\n\t\t}\n\t}\n\n\t\u002F* 成績表組みランキングのはみ出し *\u002F\n\t[id^=\"team-status-table\"] {\n\t\tmin-width: 744px;\n\t}\n\n\t\u002F* CMS詳細ページのコンテンツ余白調整 *\u002F\n\t#cms-contents>*:first-child {\n\t\tmargin-top: 0 !important;\n\t}\n\n\t\u002F* 中国語試合結果詳細表組みのはみ出し *\u002F\n\t[id^=\"zh-schedule-table\"] {\n\t\tmin-width: 510px;\n\t}\n\n\t\u002F* バイヤーズチョイスナビ背景色 *\u002F\n\t#js-bc-links a.link-active,\n\t#js-bc-links a:hover {\n\t\tbackground-color: rgba(234, 74, 60, 0.2);\n\t}\n\n\t\u002F* 営業日カレンダーの「すべて」を隠す *\u002F\n\t[id^=\"calendar-all-list\"] li:first-child {\n\t\tdisplay: none !important;\n\t}\n\n\t\u002F* トップSNS&BLOG 横線の調整 *\u002F\n\t@media screen and (max-width: 540px) {\n\t\t[id^=\"top-sns-blog-list\"] li:nth-child(even) {\n\t\t\tborder-right: none;\n\t\t}\n\t}\n\n\t\u002F* トップスライダーのボタン調整 *\u002F\n\n\t[id^=\"top-slider-arrows\"] {\n\t\ttop: 0 !important;\n    bottom: 0 !important;\n    margin: auto !important;\n\t}\n\n\t@media screen and (max-width: 840px) {\n\t\t[id^=\"top-slider-arrows\"] {\n\t\t\ttop: initial !important;\n\t\t}\n\t}\n\n\t\u002F* --------------------------------------------------\n\t\t2025年度のタブ要素を非表示にする設定\n\t\t前提：タブの並び順が「1.すべて」「2.2025」であること\n\t-------------------------------------------------- *\u002F\n\n\t\u002F* 親要素が tab-second-none の場合、2番目のリスト項目(li)を隠す *\u002F\n\t#tab-second-none ul li:nth-of-type(2) {\n\t\tdisplay: none !important;\n\t}\n\n\t\u002F* 親要素が tab-second-none の場合、2番目のコンテンツ領域(div)を隠す *\u002F\n\t#tab-second-none div:nth-of-type(2) {\n\t\tdisplay: none !important;\n\t}","style","4dc37b09-5463-4a10-b550-4107e74e81a1",{"memo":166,"src":167,"tags":168,"uuid":172},"全角数字を半角数字に変換","\u003Cscript>\nwindow.addEventListener('load', () => {\n  const convertText = () => {\n    \u002F\u002F 変換対象とする要素（Studioのテキスト要素、リスト、テーブル等）\n    const targets = document.querySelectorAll('.text, p, li, td, span');\n\n    targets.forEach(target => {\n      \u002F\u002F 子要素にタグが含まれていない（純粋なテキストのみ）の場合に処理\n      if (target.children.length === 0) {\n        let text = target.innerText;\n\n        \u002F\u002F 1. 全角数字を半角数字へ変換\n        text = text.replace(\u002F[０-９]\u002Fg, (s) => {\n          return String.fromCharCode(s.charCodeAt(0) - 0xFEE0);\n        });\n\n        \u002F\u002F 2. 半角括弧を全角括弧へ変換\n        text = text.replace(\u002F\\(\u002Fg, '（').replace(\u002F\\)\u002Fg, '）');\n\n        \u002F\u002F 反映\n        if (target.innerText !== text) {\n          target.innerText = text;\n        }\n      }\n    });\n  };\n\n  \u002F\u002F 初回実行\n  convertText();\n\n  \u002F\u002F Studioの動的リスト対策（1秒後に再実行）\n  setTimeout(convertText, 1000);\n});\n\u003C\u002Fscript>",[169],{"children":170,"tagName":171},"window.addEventListener('load', () => {\n  const convertText = () => {\n    \u002F\u002F 変換対象とする要素（Studioのテキスト要素、リスト、テーブル等）\n    const targets = document.querySelectorAll('.text, p, li, td, span');\n\n    targets.forEach(target => {\n      \u002F\u002F 子要素にタグが含まれていない（純粋なテキストのみ）の場合に処理\n      if (target.children.length === 0) {\n        let text = target.innerText;\n\n        \u002F\u002F 1. 全角数字を半角数字へ変換\n        text = text.replace(\u002F[０-９]\u002Fg, (s) => {\n          return String.fromCharCode(s.charCodeAt(0) - 0xFEE0);\n        });\n\n        \u002F\u002F 2. 半角括弧を全角括弧へ変換\n        text = text.replace(\u002F\\(\u002Fg, '（').replace(\u002F\\)\u002Fg, '）');\n\n        \u002F\u002F 反映\n        if (target.innerText !== text) {\n          target.innerText = text;\n        }\n      }\n    });\n  };\n\n  \u002F\u002F 初回実行\n  convertText();\n\n  \u002F\u002F Studioの動的リスト対策（1秒後に再実行）\n  setTimeout(convertText, 1000);\n});","script","b3e9d056-9c42-4207-ae0c-77349cef7097",{"memo":174,"src":175,"tags":176,"uuid":185},"追加","\u003Cscript src=\"https:\u002F\u002Fajax.googleapis.com\u002Fajax\u002Flibs\u002Fjquery\u002F3.4.1\u002Fjquery.min.js\" data-hid=\"4ff866e\">\u003C\u002Fscript>\n\u003Cscript src=\"https:\u002F\u002Fajax.googleapis.com\u002Fajax\u002Flibs\u002Fjqueryui\u002F1.12.1\u002Fjquery-ui.min.js\" data-hid=\"bda835f\">\u003C\u002Fscript>",[177,181],{"attrs":178,"children":21,"tagName":171},{"data-hid":179,"src":180},"4ff866e","https:\u002F\u002Fajax.googleapis.com\u002Fajax\u002Flibs\u002Fjquery\u002F3.4.1\u002Fjquery.min.js",{"attrs":182,"children":21,"tagName":171},{"data-hid":183,"src":184},"bda835f","https:\u002F\u002Fajax.googleapis.com\u002Fajax\u002Flibs\u002Fjqueryui\u002F1.12.1\u002Fjquery-ui.min.js","6f2f52b8-aac2-4ae2-becf-789817efef94",{"memo":187,"src":188,"tags":189,"uuid":192},"モバイルメニューCSS","\u003Cstyle>\n#js-mobile-toggle > button[aria-expanded=\"false\"] #js-mobile-toggle--close {\n    display: block;\n}\n#js-mobile-toggle > button[aria-expanded=\"false\"] #js-mobile-toggle--open {\n    display: none;\n}\n#js-mobile-toggle > button[aria-expanded=\"true\"] #js-mobile-toggle--close {\n    display: none;\n}\n#js-mobile-toggle > button[aria-expanded=\"true\"] #js-mobile-toggle--open {\n    display: block;\n}\n#js-mobile-toggle > div[aria-labelledby^=\"studio-toggle-button-\"] {\n    left: calc(60px - 100vw);\n}\n#js-mobile-toggle > div[aria-labelledby^=\"studio-toggle-button-\"][aria-hidden=\"false\"] {\n    height: 100vh !important;\n    overflow-y: scroll;\n}\n\u003C\u002Fstyle>",[190],{"children":191,"tagName":163},"#js-mobile-toggle > button[aria-expanded=\"false\"] #js-mobile-toggle--close {\n    display: block;\n}\n#js-mobile-toggle > button[aria-expanded=\"false\"] #js-mobile-toggle--open {\n    display: none;\n}\n#js-mobile-toggle > button[aria-expanded=\"true\"] #js-mobile-toggle--close {\n    display: none;\n}\n#js-mobile-toggle > button[aria-expanded=\"true\"] #js-mobile-toggle--open {\n    display: block;\n}\n#js-mobile-toggle > div[aria-labelledby^=\"studio-toggle-button-\"] {\n    left: calc(60px - 100vw);\n}\n#js-mobile-toggle > div[aria-labelledby^=\"studio-toggle-button-\"][aria-hidden=\"false\"] {\n    height: 100vh !important;\n    overflow-y: scroll;\n}","6e3751fb-d2e2-4c3e-9df8-585220a10280","https:\u002F\u002Fstorage.googleapis.com\u002Fproduction-os-assets\u002Fassets\u002Fcdb6f07d-865a-4d62-bb5b-6f79c0a0c323","ja",{"description":21,"og:image":21},"広島東洋カープ公式サイト",{"baseWidth":198,"collabWriteOrigin":199,"created_at":202,"migratedPageView":10,"screen":203,"type":205,"updated_at":206,"version":207},1280,{"tabSessionId":200,"writeId":201},"3256ad6d-3e08-4908-83c8-55987fb73f71","3d6ee465-0d74-44ad-b5fb-c63665a59161",1518591100346,{"baseWidth":198,"height":204,"isAutoHeight":23,"width":198,"workingState":23},600,"web",1518792996878,"4.2.0",[209,215,220,224,256,324,331,339,345,351,357,363,369,375,384,390,396,402,408,414,420,426,432,438,444,450,456,462,468,474,480,486,492,498,504,510,516,522,528,534,540,546,552,558,564,570,576,582,588,594,600,606,612,618,624,630,636,642,648,654,660,666,672,678,684,690,696,702,708,714,720,726,732,738,744,750,756,762,768,774,780,786,792,798,804,810,816,826,841,865,879,891,909,926,938,950,962,975,987,1001,1014,1020,1026,1032,1038,1044,1067,1077,1087,1096,1103,1110,1117,1125,1131,1137,1159,1168,1174,1180,1186,1192,1199,1209,1223,1236,1240,1251,1261,1271,1281,1291,1301,1311,1318,1324,1333,1341,1351,1356,1361,1365,1378,1388,1398,1408,1418,1428,1438,1448,1458,1464,1469,1476,1482,1497,1513,1519,1526,1534,1540,1547,1553,1559,1565,1571,1579,1583,1590,1596,1604,1611,1617,1621,1625,1631,1637,1643,1649,1655,1673,1692,1698,1704,1710,1717,1724,1731,1739,1745,1751,1757,1766,1776,1789,1793,1804,1811,1817,1823,1829,1835,1841,1847,1853,1859,1865,1880,1898,1904,1910,1916,1922,1936,1950,1956,1961,1968,1974,1980,1987,1993,1999,2005,2011,2017,2023,2029,2035,2041,2047,2064,2079,2085,2098,2104,2110,2117,2123,2129,2135,2142,2148,2154,2160,2166,2172,2178,2184,2190,2196,2202,2208,2214,2220,2226,2232,2238,2244,2250,2256,2262,2268,2274,2280,2286,2292,2298,2304,2310,2316,2322,2328,2334,2340,2346,2352,2358,2364,2370,2376,2382,2388,2394,2400,2406,2412,2418,2424,2430,2436,2442,2448,2454,2460,2466,2472,2478,2484,2490,2495,2501,2507,2513,2519,2525,2531,2537,2543,2549,2555,2561,2567,2573,2580,2586,2592,2598,2611,2617,2623,2634,2640,2646,2654,2662,2670,2676,2689,2695,2701,2707,2713,2719,2725,2732,2738,2744,2750,2756,2762,2768,2774,2780,2785,2791,2797,2803,2809,2816,2820,2831,2837,2843,2850,2860,2873,2880,2887,2894,2902,2909,2915,2921,2927,2934,2940,2946,2952,2959,2965,2972,2978,2984,2990,2996,3002,3008,3014,3020,3026,3032,3038,3044,3050,3056,3062,3068,3074,3080,3086,3092,3097,3103,3109,3115,3121,3127,3133,3138,3144,3150,3156,3165,3171,3177,3183,3190,3196,3202,3208,3214,3220,3224,3228,3232,3236,3240,3245,3249,3253,3257,3261,3265,3269,3273,3277,3281,3285,3289,3293,3297,3301,3305,3309,3313,3317,3321,3325,3329,3333,3337,3341,3345,3349,3353,3357,3361,3365,3369,3373,3377,3381,3385,3389,3393,3397,3401,3405,3409,3413,3417,3421,3425,3429,3433,3438,3442,3446,3450,3454,3458,3462,3471,3485,3493,3499,3506,3512,3518,3524,3530,3537,3544,3554,3561,3568,3574,3580,3586,3594,3600,3607,3613,3619,3625],{"head":210,"id":211,"type":212,"uuid":213,"symbolIds":214},{"title":21},"iframe-testpage","page","d1ec5b34-2e06-4ebb-a842-b524827ec4c0",[],{"id":216,"isCreatedInV4":23,"redirectTo":217,"type":218,"uuid":219},"privacy\u002Findex.html","\u002Fguidelines\u002Fprivacy","redirect","58b80228-b567-4844-8230-4fdbf9a833f7",{"id":221,"isCreatedInV4":23,"redirectTo":222,"type":218,"uuid":223},"rules_stipulations\u002Findex.html","\u002Fstadium\u002Fterms","fb68fed4-68a7-4de9-8845-a2abb849dabf",{"head":225,"id":248,"type":212,"uuid":249,"symbolIds":250},{"customCode":226,"title":247},{"bodyEnd":227,"headEnd":232},[228],{"memo":229,"src":230,"uuid":231},"JS_タブ切り替え","  \u003Cscript>\n  (function() {\n    function initNewsTabs(retries) {\n      if (retries === undefined) retries = 20;\n\n      const contentBoxes = document.querySelectorAll('ul[id^=\"tab-bp-news-\"]');\n      const tabButtons = document.querySelectorAll('a[href*=\"#tab-bp-news-\"]');\n\n      \u002F* ボタンが見つからない場合もリトライ *\u002F\n      if (contentBoxes.length === 0 || tabButtons.length === 0) {\n        if (retries > 0) {\n          setTimeout(() => initNewsTabs(retries - 1), 200);\n        }\n        return;\n      }\n\n      const contentParent = contentBoxes[0].parentNode;\n      let emptyMsg = document.getElementById('js-empty-message') || (function() {\n        const div = document.createElement('div');\n        div.id = 'js-empty-message';\n        div.innerHTML = '\u003Cp style=\"font-family:sans-serif; font-size:15px; color:#333;\">記事がありません。\u003C\u002Fp>';\n        contentParent.appendChild(div);\n        return div;\n      })();\n\n      function updateNewsDisplay(targetId) {\n        let hasContent = false;\n        contentBoxes.forEach(box => {\n          const isActive = (box.id === targetId);\n          if (isActive) {\n            const contentExists = box.querySelector('li');\n            box.style.setProperty('display', contentExists ? 'flex' : 'none', 'important');\n            hasContent = !!contentExists;\n          } else {\n            box.style.setProperty('display', 'none', 'important');\n          }\n        });\n        emptyMsg.style.display = hasContent ? 'none' : 'block';\n\n        tabButtons.forEach(btn => {\n          const btnTarget = btn.getAttribute('href').split('#')[1];\n          btn.classList.toggle('is-active', btnTarget === targetId);\n        });\n      }\n\n      tabButtons.forEach(btn => {\n        if (btn.dataset.newsInit) return;\n        btn.addEventListener('click', (e) => {\n          e.preventDefault();\n          const targetId = btn.getAttribute('href').split('#')[1];\n          updateNewsDisplay(targetId);\n        });\n        btn.dataset.newsInit = \"true\";\n      });\n\n      function checkAndInit(targetId, retries) {\n        const targetBox = document.getElementById(targetId);\n        if ((targetBox && targetBox.querySelector('li')) || retries === 0) {\n          updateNewsDisplay(targetId);\n        } else {\n          setTimeout(() => checkAndInit(targetId, retries - 1), 200);\n        }\n      }\n\n      checkAndInit('tab-bp-news-all', 15);\n    }\n\n    if (document.readyState !== 'loading') {\n      initNewsTabs();\n    } else {\n      document.addEventListener('DOMContentLoaded', initNewsTabs);\n    }\n  })();\n  \u003C\u002Fscript>","379e117a-e57b-4358-a696-2d66d6024c60",[233,240],{"memo":234,"src":235,"tags":236,"uuid":239},"CSS_タブ切り替え（news）","  \u003Cstyle>\n    \u002F* 初期表示：すべて(all)以外を隠す *\u002F\n    ul[id^=\"tab-bp-news-\"]:not(#tab-bp-news-all) {\n      display: none !important;\n    }\n    \u002F* メッセージエリア *\u002F\n    #js-empty-message {\n      width: 100%; display: none; text-align: center; padding: 60px 20px;\n    }\n    \u002F* アクティブなタブボタン *\u002F\n    [id^=\"js-parts-tab\"] a.is-active {\n      background-color: #97141b !important;\n    }\n    [id^=\"js-parts-tab\"] a.is-active .image:first-of-type {\n      opacity: 0;\n    }\n    [id^=\"js-parts-tab\"] a.is-active p {\n      color: #ffffff !important;\n    }\n  \u003C\u002Fstyle>",[237],{"children":238,"tagName":163},"\u002F* 初期表示：すべて(all)以外を隠す *\u002F\n    ul[id^=\"tab-bp-news-\"]:not(#tab-bp-news-all) {\n      display: none !important;\n    }\n    \u002F* メッセージエリア *\u002F\n    #js-empty-message {\n      width: 100%; display: none; text-align: center; padding: 60px 20px;\n    }\n    \u002F* アクティブなタブボタン *\u002F\n    [id^=\"js-parts-tab\"] a.is-active {\n      background-color: #97141b !important;\n    }\n    [id^=\"js-parts-tab\"] a.is-active .image:first-of-type {\n      opacity: 0;\n    }\n    [id^=\"js-parts-tab\"] a.is-active p {\n      color: #ffffff !important;\n    }","0d9cfd13-ce17-48d6-b75a-1368f9107fdb",{"memo":241,"src":242,"tags":243,"uuid":246},"サイト全体のCSS打ち消し","\u003Cstyle>\n    #baseball-promotion a:hover {\n        opacity: 1.0 !important;\n    }\n    #baseball-promotion [id^=\"tab-bp-news-\"] a:hover {\n        opacity: 0.6 !important;\n    }\n\u003C\u002Fstyle>",[244],{"children":245,"tagName":163},"#baseball-promotion a:hover {\n        opacity: 1.0 !important;\n    }\n    #baseball-promotion [id^=\"tab-bp-news-\"] a:hover {\n        opacity: 0.6 !important;\n    }","01149647-827a-435c-8af4-5c2544c1d341","野球振興｜広島東洋カープ","baseball-promotion-2","ff2a79d1-c8f3-4125-b3ed-3f066fc2f734",[251,252,253,254,255],"571dff24-7bae-407c-9692-6ce15a5c3157","d067f272-b4ac-4968-89a8-bc57386e2441","cd018c65-2a3d-461e-974b-763f678ef23f","4953defe-e9d3-4333-98d5-2832ec2689d2","999c12c7-f9ff-499a-b998-f30e6bfae75e",{"head":257,"id":286,"position":287,"type":212,"uuid":289,"symbolIds":290},{"customCode":258,"meta":284,"title":285},{"bodyEnd":259,"headEnd":276},[260,264,268,272],{"memo":261,"src":262,"uuid":263},"JS_タブ切り替え（foryou）","\u003Cscript>\n(function() {\n  const TARGET_CONTENT_ID = 'tab-01_foryou_content-01';\n\n  const forceShowFirstTab = () => {\n    const tabContainer = document.getElementById('js-foryou-tabs');\n    const firstContent = document.getElementById(TARGET_CONTENT_ID);\n    const firstTabBtn = document.querySelector(`#js-foryou-tabs a[href*=\"${TARGET_CONTENT_ID}\"]`);\n\n    if (firstContent && firstTabBtn) {\n      \u002F\u002F 1. 全てのコンテンツを一旦隠す（リセット）\n      document.querySelectorAll('[id^=\"tab-01_foryou_content-\"]').forEach(el => {\n        el.style.setProperty('display', 'none', 'important');\n        el.classList.remove('is-active-content');\n      });\n\n      \u002F\u002F 2. 全てのタブのアクティブを外す\n      document.querySelectorAll('#js-foryou-tabs a').forEach(el => {\n        el.classList.remove('is-active-tab');\n      });\n\n      \u002F\u002F 3. 1番目だけを「超強制的」に表示する\n      firstContent.classList.add('is-active-content');\n      firstTabBtn.classList.add('is-active-tab');\n      \n      \u002F\u002F STUDIOのアニメーションによる透明化を無効化してこじ開ける\n      firstContent.style.setProperty('display', 'flex', 'important');\n      firstContent.style.setProperty('opacity', '1', 'important');\n      firstContent.style.setProperty('visibility', 'visible', 'important');\n      firstContent.style.setProperty('transform', 'none', 'important');\n    }\n  };\n\n  \u002F\u002F --- クリック時の挙動（一度だけ登録） ---\n  const initClickEvents = () => {\n    const container = document.getElementById('js-foryou-tabs');\n    if (!container || container.dataset.clickInit) return;\n\n    container.addEventListener('click', (e) => {\n      const link = e.target.closest('a');\n      if (!link) return;\n      \n      const href = link.getAttribute('href');\n      if (!href || !href.includes('#')) return;\n\n      e.preventDefault();\n      e.stopPropagation();\n\n      const targetId = href.split('#')[1];\n      \n      \u002F\u002F クリックされた時の切り替え処理\n      document.querySelectorAll('#js-foryou-tabs a').forEach(a => a.classList.remove('is-active-tab'));\n      document.querySelectorAll('[id^=\"tab-01_foryou_content-\"]').forEach(div => {\n        div.style.setProperty('display', 'none', 'important');\n        div.classList.remove('is-active-content');\n      });\n\n      link.classList.add('is-active-tab');\n      const targetDiv = document.getElementById(targetId);\n      if (targetDiv) {\n        targetDiv.classList.add('is-active-content');\n        targetDiv.style.setProperty('display', 'flex', 'important');\n        targetDiv.style.setProperty('opacity', '1', 'important');\n        targetDiv.style.setProperty('visibility', 'visible', 'important');\n      }\n    }, true);\n    container.dataset.clickInit = \"true\";\n  };\n\n  \u002F\u002F 実行：DOM構築後、ロード後、さらに時間差で数回追い打ちをかける\n  initClickEvents();\n  forceShowFirstTab();\n\n  window.addEventListener('load', () => {\n    initClickEvents();\n    forceShowFirstTab();\n  });\n\n  \u002F\u002F STUDIOの「後出し上書き」に勝つための4段階追い打ち\n  [100, 500, 1000, 2000].forEach(delay => {\n    setTimeout(() => {\n      initClickEvents();\n      forceShowFirstTab();\n    }, delay);\n  });\n})();\n\u003C\u002Fscript>","2a1581fd-7821-42c5-bfb2-57ce7d509d03",{"memo":265,"src":266,"uuid":267},"カスタムJS(RCCスコアボード)","\u003Cscript>\n    (function() {\n        \u002F\u002F 1. 対象のiframe要素を取得\n        var iframe = document.getElementById('carpscore');\n\n        \u002F\u002F 2. ベースとなるURL\n        var baseUrl = \"https:\u002F\u002Fcarpscore.rcc.jp\u002Fscore.htm\";\n\n        \u002F\u002F 3. 付与したい値（ここでは現在時刻のミリ秒）\n        \u002F\u002F ※ここを任意の変数に変えれば、指定の値を付与できます\n        var queryValue = new Date().getTime();\n\n        \u002F\u002F 4. URLを結合してsrc属性にセット\n        iframe.src = baseUrl + \"?\" + queryValue;\n    })();\n\u003C\u002Fscript>","3f25b298-e665-47f2-b96a-8ee9dc20180a",{"memo":269,"src":270,"uuid":271},"カスタムJS（days ","\u003Cscript>\n    (function() {\n        \u002F\u002F --- 設定 ---\n        var iframeId = 'carpscore';\n        var wrapperId = 'todays-game-title';\n        \u002F\u002F -----------\n\n        var iframe = document.getElementById(iframeId);\n        var wrapper = document.getElementById(wrapperId);\n\n        \u002F\u002F 監視機能（MutationObserver）の作成\n        var observer = new MutationObserver(function(mutations) {\n            mutations.forEach(function(mutation) {\n                \u002F\u002F style属性が変更された場合のみ反応する\n                if (mutation.type === \"attributes\" && mutation.attributeName === \"style\") {\n                    \n                    \u002F\u002F 現在のiframeのstyle状態を取得\n                    var currentDisplay = iframe.style.display;\n                    var currentHeight = iframe.style.height;\n\n                    \u002F\u002F 判定条件: displayがnone、または heightが0なら\n                    \u002F\u002F (※既存スクリプトがどのような値をセットするかによって微調整してください)\n                    if (currentDisplay === 'none' || currentHeight === '0px' || currentHeight === '0') {\n                        \n                        \u002F\u002F 親要素を非表示にする\n                        if(wrapper) {\n                            wrapper.style.display = 'none';\n                        }\n                        \n                        \u002F\u002F 用が済んだら監視を終了しても良い（負荷軽減）\n                        \u002F\u002F observer.disconnect(); \n                    }\n                }\n            });\n        });\n\n        \u002F\u002F 監視の開始\n        \u002F\u002F attributes: true -> 属性の変更を監視\n        \u002F\u002F attributeFilter: ['style'] -> style属性だけをピンポイントで監視\n        if (iframe) {\n            observer.observe(iframe, { \n                attributes: true, \n                attributeFilter: ['style'] \n            });\n        }\n    })();\n\u003C\u002Fscript>","edd4e616-69c7-4444-a278-84f5242e1922",{"memo":273,"src":274,"uuid":275},"RCCスコアボードが非表示の際のタイトル非表示","\u003Cscript>\nwindow.addEventListener(\"message\", function(event) {\n  \u002F\u002F 1. まずメッセージを受信できたか確認\n  \u002F\u002F console.log(\"★親ウィンドウ：メッセージを受信しました\", event);\n  \u002F\u002F console.log(\"・送信元オリジン:\", event.origin);\n  \u002F\u002F console.log(\"・受け取ったデータ:\", event.data);\n\n  \u002F\u002F （セキュリティのためのオリジン確認：テスト中はコメントアウトしてもOKです）\n  \u002F\u002F if (event.origin !== \"https:\u002F\u002Fcarpscorediv.rcc.jp\") return;\n\n  \u002F\u002F 2. データのタイプが一致するか確認\n  if (event.data && event.data.type === \"hideSection\") {\n    \n    \u002F\u002F 3. 対象の要素が取得できているか確認\n    const targetDiv = document.getElementById(\"todays-game-title\");\n    const targetDiv2 = document.getElementById(\"carpscorediv\");\n    \u002F\u002Fconsole.log(\"・対象の要素(#todays-game-title):\", targetDiv);\n\n    if (targetDiv) {\n      targetDiv.style.display = \"none\";\n      \u002F\u002Fconsole.log(\"★処理成功：#todays-game-title を非表示にしました\");\n    } else {\n      \u002F\u002F console.error(\"エラー：#todays-game-title の要素が存在しません（まだ読み込まれていないか、IDが間違っています）\");\n    }\n    if (targetDiv2) {\n      targetDiv2.style.display = \"none\";\n      \u002F\u002Fconsole.log(\"★処理成功：#todays-game-title を非表示にしました\");\n    } else {\n      \u002F\u002Fconsole.error(\"エラー：#carpscorediv の要素が存在しません（まだ読み込まれていないか、IDが間違っています）\");\n    }\n  }\n});\n\u003C\u002Fscript>\n\n","617e4edb-87c7-414b-8f63-90b7f37f7355",[277],{"memo":278,"src":279,"tags":280,"uuid":283},"CSS_タブ切り替え（foryou）","\u003Cstyle>\n\u002F* --- 基本設定（541px以上：PC・タブレット） --- *\u002F\n#js-foryou-tabs li:has(.is-active-tab) {\n  border-top: 3px solid var(--s-color-af8b1674) !important;\n  border-left: 3px solid var(--s-color-af8b1674) !important;\n  border-right: 3px solid var(--s-color-af8b1674) !important;\n  border-bottom: 0px none transparent !important;\n  border-style: solid !important;\n  box-sizing: border-box;\n}\n\n\u002F* --- レスポンシブ設定（540px以下：スマホ） --- *\u002F\n@media screen and (max-width: 540px) {\n  #js-foryou-tabs li:has(.is-active-tab) {\n    border-top-width: 2px !important;\n    border-left-width: 2px !important;\n    border-right-width: 2px !important;\n    \u002F* border-colorなどは継承されるため、太さだけ上書きします *\u002F\n  }\n}\n\n\u002F* --- 以下はこれまでの安定化設定（維持） --- *\u002F\n#js-foryou-tabs a {\n  -webkit-tap-highlight-color: transparent;\n  touch-action: manipulation;\n}\n\n#js-foryou-tabs a.is-active-tab {\n  opacity: 1 !important;\n  cursor: default;\n  pointer-events: none;\n}\n\n#js-foryou-tabs li::before { display: none !important; }\n\n#tab-01_foryou_content-01,\n#tab-01_foryou_content-02,\n#tab-01_foryou_content-03 {\n  display: none !important;\n  opacity: 0;\n  transform: translateZ(0);\n}\n\n#js-tab-foryou .is-active-content {\n  display: flex !important; \n  opacity: 1 !important;\n  transition: opacity 0.15s ease-out !important;\n}\n\n.is-active-tab [id*=\"atv-icon\"], .is-active-tab [id*=\"atv-select\"] { display: block !important; }\n#js-foryou-tabs a:not(.is-active-tab) [id*=\"atv-icon\"],\n#js-foryou-tabs a:not(.is-active-tab) [id*=\"atv-select\"],\n.is-active-tab [id*=\"non-icon\"] { display: none !important; }\n\u003C\u002Fstyle>",[281],{"children":282,"tagName":163},"\u002F* --- 基本設定（541px以上：PC・タブレット） --- *\u002F\n#js-foryou-tabs li:has(.is-active-tab) {\n  border-top: 3px solid var(--s-color-af8b1674) !important;\n  border-left: 3px solid var(--s-color-af8b1674) !important;\n  border-right: 3px solid var(--s-color-af8b1674) !important;\n  border-bottom: 0px none transparent !important;\n  border-style: solid !important;\n  box-sizing: border-box;\n}\n\n\u002F* --- レスポンシブ設定（540px以下：スマホ） --- *\u002F\n@media screen and (max-width: 540px) {\n  #js-foryou-tabs li:has(.is-active-tab) {\n    border-top-width: 2px !important;\n    border-left-width: 2px !important;\n    border-right-width: 2px !important;\n    \u002F* border-colorなどは継承されるため、太さだけ上書きします *\u002F\n  }\n}\n\n\u002F* --- 以下はこれまでの安定化設定（維持） --- *\u002F\n#js-foryou-tabs a {\n  -webkit-tap-highlight-color: transparent;\n  touch-action: manipulation;\n}\n\n#js-foryou-tabs a.is-active-tab {\n  opacity: 1 !important;\n  cursor: default;\n  pointer-events: none;\n}\n\n#js-foryou-tabs li::before { display: none !important; }\n\n#tab-01_foryou_content-01,\n#tab-01_foryou_content-02,\n#tab-01_foryou_content-03 {\n  display: none !important;\n  opacity: 0;\n  transform: translateZ(0);\n}\n\n#js-tab-foryou .is-active-content {\n  display: flex !important; \n  opacity: 1 !important;\n  transition: opacity 0.15s ease-out !important;\n}\n\n.is-active-tab [id*=\"atv-icon\"], .is-active-tab [id*=\"atv-select\"] { display: block !important; }\n#js-foryou-tabs a:not(.is-active-tab) [id*=\"atv-icon\"],\n#js-foryou-tabs a:not(.is-active-tab) [id*=\"atv-select\"],\n.is-active-tab [id*=\"non-icon\"] { display: none !important; }","e08d2d82-e479-43b9-afcf-5c3d6f0fd3d2",{"description":21,"og:image":21},"広島東洋カープ公式サイト｜広島東洋カープ公式サイト","\u002F",{"x":288,"y":288},0,"5674ef0d-f584-4550-8594-22eeeb23dd90",[291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323],"6862bd95-940f-400f-9376-62a43fbb0a82","fb4f4294-0333-4578-9eb9-6d5df5de44dd","fc54b6f9-0939-42cd-99ae-270766efc4d5","a4c82ca0-d4fa-4844-9c34-8f9b7fabe9c9","a0defa1f-c4c7-49ba-8d74-e6a769e77088","9c31b8d8-10e7-478b-9761-97218268453c","6856e393-8735-490b-932b-ced245f7b68d","838015b0-f8a9-47bd-9446-bcc2b55284ee","e5b8b11b-2aa5-4a0c-b886-1235388e0351","0c5f0307