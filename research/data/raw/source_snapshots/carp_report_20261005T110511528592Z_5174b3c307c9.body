<!DOCTYPE html><html  lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>10月1日(木)カープダイジェスト｜広島東洋カープ公式サイト</title><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><script type="importmap">{"imports":{"#entry":"/_nuxt/C0WHp8zF.js"}}</script><script>window.addEventListener('load', () => {
  const convertText = () => {
    // 変換対象とする要素（Studioのテキスト要素、リスト、テーブル等）
    const targets = document.querySelectorAll('.text, p, li, td, span');

    targets.forEach(target => {
      // 子要素にタグが含まれていない（純粋なテキストのみ）の場合に処理
      if (target.children.length === 0) {
        let text = target.innerText;

        // 1. 全角数字を半角数字へ変換
        text = text.replace(/[０-９]/g, (s) => {
          return String.fromCharCode(s.charCodeAt(0) - 0xFEE0);
        });

        // 2. 半角括弧を全角括弧へ変換
        text = text.replace(/\(/g, '（').replace(/\)/g, '）');

        // 反映
        if (target.innerText !== text) {
          target.innerText = text;
        }
      }
    });
  };

  // 初回実行
  convertText();

  // Studioの動的リスト対策（1秒後に再実行）
  setTimeout(convertText, 1000);
});</script><script data-hid="4ff866e" src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script><script data-hid="bda835f" src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script><style>/* デフォルトスタイル */
	a:hover {
		opacity: 0.6;
	}

	img {
		object-fit: cover;
	}

	@media screen and (max-width: 840px) {
		[id^="table"] {
			overflow: scroll;
		}

		[id^="table"]>div {
			min-width: 840px;
		}
	}

	@media screen and (max-width: 540px) {
		[id^="small-table"] {
			overflow: scroll;
		}

		[id^="small-table"]>div {
			min-width: 540px;
		}
	}

	/* メガヘッダー高さ制限 */
	[id^="js-scroll-"] {
		max-height: calc(100vh - 263px);
		overflow-y: auto;
		overflow-x: hidden;
	}

	@media screen and (max-width: 1140px) {
		[id^="js-scroll-"] {
			max-height: calc(100vh - 219px);
		}
	}

	@media screen and (max-width: 840px) {
		[id^="js-scroll-"] {
			max-height: calc(100vh - 114px);
		}
	}

	/* モーダルメニュー開閉時の色変更 */
