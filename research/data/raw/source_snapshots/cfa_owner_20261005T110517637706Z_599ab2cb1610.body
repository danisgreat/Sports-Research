    <style>
        /* 通知公告 + 禁业名单 两栏布局 */
        .notice_two_col { display: flex; gap: 40px; }
        .notice_left { flex: 1; min-width: 0; }
        .notice_right { flex: 1; min-width: 0; }

        /* 禁业名单容器 */
        .ban_section {
            /* background: #F7F9FA; */
            border-radius: 4px;
            padding: 20px 0;
            /* font-family: "Microsoft YaHei", Arial, Helvetica, sans-serif; */
            font-family: MicrosoftYaHei;
        }
        .ban_header {
            display: flex;
            background: rgba(0, 108, 84, 0.07);
            font-size: 12px;
            color: #006C54;
            font-weight: 500;
            line-height: 36px;
        }
        .ban_header span {
            padding: 0 6px;
            text-align: center;
        }
        .ban_header .ban_col_name  { width: 150px; }
        .ban_header .ban_col_start { width: 120px; }
        .ban_header .ban_col_end   { width: 120px; }
        .ban_header .ban_col_bz    { flex: 1; }
        .ban_col_name  { width: 150px; }
        .ban_col_start { width: 120px; }
        .ban_col_end   { width: 120px; }
        .ban_col_bz    { flex: 1; }

        /* 滚动视口 */
        .ban_viewport {
            height: 240px;
            overflow: hidden;
            position: relative;
        }
        .ban_scroll {
            transition: transform 0.4s ease;
        }

        /* 单行数据 */
        .ban_row {
            display: flex;
            height: 48px;
            line-height: 48px;
            font-size: 14px;
            color: #666666;
        }
        .ban_row:nth-child(odd) { background: #FCFCFC; }
        .ban_row:nth-child(even) { background: #F5F6F7; }
        .ban_row span {
            padding: 0 6px;
            text-align: center;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .ban_row .ban_col_name  { width: 150px; }
        .ban_row .ban_col_start { width: 120px; }
        .ban_row .ban_col_end   { width: 120px; }
        .ban_row .ban_col_bz    { flex: 1; }
        .ban_row .ban_col_bz.lifelong { }

        /* 暂无数据 */
        .ban_empty {
            height: 40px;
            line-height: 40px;
            text-align: center;
            color: #999;
            font-size: 13px;
        }

        /* 禁用两栏对移动端友好 */
        @media (max-width: 1000px) {
            .notice_two_col { flex-direction: column; }
        }
    </style>
