<script>
    $(function () {
        var system = {};
        system.pingtai = /(Win32|Win16|WinCE|Mac68K|MacIntel|MacIntel|MacPPC|Linux mips64)/i.test(navigator.platform);
        if (system.pingtai) {
            //电脑1
            $('.pc').css("display","block");
            $('.app').css("display","none");
            $("meta[name='viewport']").attr('content', "width=device-width, initial-scale=0.3, minimum-scale=0.2, maximum-scale=1");
        } else {
            //手机
            $("meta[name='viewport']").attr('content', "width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0");
            $('.app').css("display","block");
            $('.pc').css("display","none");
            setTimeout(function(){
                $(".app").scrollTop(0);
                window.parent.scrollTo(0, 0);
            },300)
        }
    })
</script>
