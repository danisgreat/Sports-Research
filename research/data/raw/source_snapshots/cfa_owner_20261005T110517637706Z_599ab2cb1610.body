                                    function getZqbShooter(lid, year) {
                                        let strHtml = "";
                                        $.ajax({
                                            url: 'https://data.thecfa.cn/shooter.do',
                                            data: 'lid=' + lid + '&year=' + year,
                                            dataType: "jsonp",
                                            type: 'post',
                                            success: function (json) {
                                                strHtml += '<div class="ranking_title she_title"><div>排名</div><div>球员</div><div>球队</div><div>进球（点球）</div></div>';
                                                strHtml += '<div class="ranking_content">'
                                                for (var i = 0; i < 12; i++) {
                                                    if (undefined == json[i] || "undefined" == json[i]) continue;

                                                    strHtml += '<div class="ranking_content_item she">'
                                                    strHtml += '<div>' + json[i].ranking + '</div>'
                                                    strHtml += '<div>' + json[i].playername + '</div>'
                                                    strHtml += '<div>' + json[i].teamname + '</div>'
                                                    strHtml += '<div>' + json[i].goalnum + '(' + json[i].pknum + ')' + '</div>'
                                                    strHtml += '</div>'
                                                }
                                                strHtml += '</div>'
                                                strHtml += '<a href="https://www.thecfa.cn/zxb/index.html" class="rankinglist_announcement_more" target="_blank">查看更多</a>'
                                                $("#zqb_she").html(strHtml);
                                            },

                                            error: function () {

                                                // alert('fail');

                                            }

                                        });
                                    }
                                </script>
                            </div>
