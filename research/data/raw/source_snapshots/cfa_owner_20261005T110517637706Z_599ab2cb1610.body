<script>
    $(function () {
        function searchEvent(){
            $("#h5searchForm").submit();
        }
    })

    let name = '';
    $(function () {
        // 导航点击切换，居中js
        $('.newtab_warp div').on("click", function () {
            $('.newtab_warp div').removeClass('active');
            $(this).addClass('active');
            let dicLift = $(this).offset().left;
            let divWidth = $(this).width() / 2;
            let widths = $(window).width() / 2;
            let scroll = $('.newtab_warp').scrollLeft();
            $('.newtab_warp').animate({
                scrollLeft: scroll + (dicLift - widths) + divWidth
            })
            $('.newtab_warp div').children('span').attr('class','iconNew')
            let text = $(this).text();
            if(text == name) return false;
            name = text;
            if(text == '队伍'){
                $('.app_competition_mask').show();
                let str = '<div class="competition_mask_item"><div class="competition_mask_item_left"><div class="competition_mask_item_left_li left_active">男子</div><div class="competition_mask_item_left_li">女子</div><div class="competition_mask_item_left_li">五人制和沙滩</div></div><div class="competition_mask_item_right"><div class="competition_mask_item_right_list"><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/nzgjd/index.html">中国国家男子足球队</a></div><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/nzyyh/index.html">中国国家男子足球亚运队</a></div><div class="competition_mask_item_right_li"  ><a href="https://www.thecfa.cn/nzu23/index.html">中国U-23国家男子足球队</a></div><div class="competition_mask_item_right_li"  ><a href="https://www.thecfa.cn/nzu17/index.html">中国U-17国家男子足球队</a></div></div><div class="competition_mask_item_right_list" style="display:none;"><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/nvzgjd/index.html">中国国家女子足球队</a></div><div class="competition_mask_item_right_li"  ><a href="https://www.thecfa.cn/nvu20/index.html">中国U-20国家女子足球队</a></div><div class="competition_mask_item_right_li"  ><a href="https://www.thecfa.cn/nvu17/index.html">中国U-17国家女子足球队</a></div></div><div class="competition_mask_item_right_list" style="display:none;"><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/nzstsq/index.html">中国国家男子沙滩足球队</a></div><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/wrznzgjd/index.html">中国国家男子五人制足球队</a></div></div></div></div>'
                $('.app_competition_mask').children().remove();
                $('.app_competition_mask').append(str);
                $('.app_competition_mask').children('.competition_mask_item').eq(0).show()
                $(this).children('span').attr('class','icon')
                fixed()
            }else if(text == '赛事'){
                $('.app_competition_mask').show();
                let str = '<div class="competition_mask_item"><div class="competition_mask_item_left"><div class="competition_mask_item_left_li left_active">男子</div><div class="competition_mask_item_left_li">女子</div><div class="competition_mask_item_left_li">五人制和沙滩</div></div><div class="competition_mask_item_right"><div class="competition_mask_item_right_list"><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/zxb/index.html">中国足球协会杯</a></div><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/yyls/index.html">中国足球协会会员协会冠军联赛</a></div><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/qcls/index.html">中国青少年足球联赛</a></div></div><div class="competition_mask_item_right_list" style="display:none;"><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/zgzqxhb/index.html">中国足球协会杯赛（女子）</a></div></div><div class="competition_mask_item_right_list" style="display:none;"><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/wcwj/index.html">中国足球协会室内五人制足球超级联赛</a></div><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/wrzjjls/index.html">中国足球协会室内五人制足球甲级联赛</a></div><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/nzsnwrzls/index.html">中国足球协会女子室内五人制足球联赛</a></div><div class="competition_mask_item_right_li"><a href="https://www.thecfa.cn/snwrzzq/index.html">中国足球协会室内五人制及沙足等其它赛事</a></div></div></div></div>'
                $('.app_competition_mask').children().remove();
                $('.app_competition_mask').append(str);
                $('.app_competition_mask').children('.competition_mask_item').eq(1).show()
                $(this).children('span').attr('class','icon')
                fixed()
            }else{
                $('.app_competition_mask').hide();
                fixed_cancel();
            }
            bindFunction();
        })
        function bindFunction(){
            $('.competition_mask_item_left div').on('click',function(){
                $(this).addClass('left_active').siblings().removeClass('left_active');
                let index = $(this).index();
                $(this).parent().next().children().eq($(this).index()).css('display', 'block').siblings().css('display', 'none');
            })
        }
        //触发弹窗底部页面禁止滑动
        function fixed(){
          var scrolltop = document.body.scrolltop;//设置背景元素的位置
          $('#content').attr('data-top',scrolltop);
          var contentstyle = document.getElementById("content").style;//content是可以滚动的背景元素id名称
          contentstyle.position = 'fixed'; //contentstyle是第二步的变量，设置背景元素的position属性为‘fixed'
          contentstyle.top = "-"+scrolltop+"px";
        }
        
        //关闭弹窗底部页面恢复滑动
        function fixed_cancel(){
          var contentstyle = document.getElementById("content").style;
          var scrolltop = $('#content').attr('data-top');//设置背景元素的位置
          contentstyle.top = '0px';//恢复背景元素的初始位置
          contentstyle.position ="static";//恢复背景元素的position属性（初始值为absolute，就恢复为absolute，以此类推）
          $(document).scrolltop(scrolltop);//scrolltop,设置滚动条的位置
        }
    })
    // 轮播图
    var swiper = new Swiper(".mySwiper", {
        loop: true,
        autoplay: {
            delay: 3000,
            disableOnInteraction: false,
        },
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
            renderBullet: function (index, className) {
                return '<div class="' + className + '"></div>';
            },
        },
    });
    // 官方商城
    /*    var swiper = new Swiper(".mySwiper_shop", {
            centeredSlides: true,
            loop: true,
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
            },
        });*/

</script>

<script>
    // 禁业名单数据加载 + CSS 自动滚动
    $(function () {
        function formatDate(dateStr) {
            if (!dateStr) return '-';
            var d = new Date(dateStr.replace(/-/g, '/'));
            return d.getFullYear() + '年' +
                ((d.getMonth() + 1) < 10 ? '0' + (d.getMonth() + 1) : (d.getMonth() + 1)) + '月' +
                (d.getDate() < 10 ? '0' + d.getDate() : d.getDate()) + '日';
        }
        function renderBanList() {
            $.ajax({
                url: "https://www.thecfa.cn//proxy/portal-manager-api/rest/black/user/page",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ name: '', pageNum: 1, pageSize: 999 }),
                dataType: "json",
                success: function (data) {
                    if (!data.data || data.data.count === 0) {
                        $('#banScroll').html('<div class="ban_empty">暂无信息</div>');
                        return;
                    }
                    var filtered = data.data.list.filter(function (v) {
                        return v.blackType === "all";
                    });
                    if (filtered.length === 0) {
                        $('#banScroll').html('<div class="ban_empty">暂无信息</div>');
                        return;
                    }
                    var html = '';
                    $.each(filtered, function (k, v) {
                        var startStr = formatDate(v.blackStartTime);
                        var endStr = v.lifelongFlag == 1 ? '-' : formatDate(v.blackEndTime);
                        var bzStr = v.lifelongFlag == 1 ? '终身禁业' : v.blackLengthTime;
                        var bzClass = v.lifelongFlag == 1 ? 'ban_col_bz lifelong' : 'ban_col_bz';
                        html += '<div class="ban_row">' +
                            '<span class="ban_col_name">' + v.name + '</span>' +
                            '<span class="ban_col_start">' + startStr + '</span>' +
                            '<span class="ban_col_end">' + endStr + '</span>' +
                            '<span class="' + bzClass + '">' + bzStr + '</span>' +
                        '</div>';
                    });
                    var $scroll = $('#banScroll');
                    if (filtered.length > 5) {
                        $scroll.html(html + html);
                        // 每秒滚动一条
                        startStepScroll($scroll);
                    } else {
                        $scroll.html(html);
                    }
                },
                error: function () {
                    $('#banScroll').html('<div class="ban_empty">数据加载失败</div>');
                }
            });
        }
        // 每秒滚动一条（步进式）
        function startStepScroll($el) {
            var step = 0;
            var rowH = 48;
            var totalRows = $el.children().length;
            var halfRows = totalRows / 2;
            var timer = null;
            var visible = false;

            function tick() {
                if (document.hidden) {
                    timer = setTimeout(tick, 2000);
                    return;
                }
                step++;
                if (step >= halfRows) {
                    step = 0;
                    $el.css('transition', 'none').css('transform', 'translateY(0)');
                    $el[0].offsetHeight;
                    $el.css('transition', 'transform 0.4s ease');
                } else {
                    $el.css('transform', 'translateY(-' + (step * rowH) + 'px)');
                }
                timer = setTimeout(tick, 2000);
            }

            // 进入视口开始滚动，离开视口暂停
            var observer = new IntersectionObserver(function(entries) {
                visible = entries[0].isIntersecting;
                if (visible) {
                    if (!timer) timer = setTimeout(tick, 2000);
                } else {
                    clearTimeout(timer);
                    timer = null;
                }
            }, { threshold: 0 });
            observer.observe($el.parent()[0]);

            $el.parent().hover(function () {
                clearTimeout(timer);
            }, function () {
                if (visible) timer = setTimeout(tick, 2000);
            });
        }
        renderBanList();
    });
</script>
</body>
</html>