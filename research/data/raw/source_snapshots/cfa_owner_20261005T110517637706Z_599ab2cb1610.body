                            <div class="title_green">女超</div>
                            <div>女甲</div>
                            <!-- <div>锦标赛</div> -->
                        </div>
                        <div class="rankinglist_announcement_top">
                            <div class="title_green woman_jf_tab">积分榜</div>
                            <div>射手榜</div>
                        </div>
                        <div class="item">
                            <!-- 女积分 -->
                            <div class="rankinglist_announcement_bottom" id="chao_ji">
                                <script>
                                    fetchSuperRound('526-2025','http://women.thecfa.cn/cwsl_standings_2025/index.html')
                                    function fetchSuperRound(jab,gengduo_jf) {
                                        $.ajax({
                                            url: 'https://women.thecfa.cn/json/leaguerank/'+jab+'.json',
                                            type: 'get',
                                            // dataType: "json",
                                            success: function (data) {
                                                jo = 3;
                                                var strHtml = "";
                                                strHtml += '<div class="ranking_title"><div>排名</div><div>球队</div><div>胜</div><div>平</div><div>负</div><div>积分</div></div>';
                                                strHtml += '<div class="ranking_content" style="height:200px">'
                                                for (var i = 0; i < data.round.length; i++) {
                                                    // if(jab != '526-2025'){
                                                    //     jo = 5;
                                                    // }
                                                    // if (i > jo) break
                                                    var row = data.round[i];
                                                    strHtml += '<div class="ranking_content_item">'
                                                    strHtml += '<div>' + (i + 1) + '</div>'
                                                    strHtml += '<div style="width: 126px;">' + row.name + '</div>'
                                                    strHtml += '<div>' + row.win + '</div>'
                                                    strHtml += '<div>' + row.draw + '</div>'
                                                    strHtml += '<div>' + row.lose + '</div>'
                                                    strHtml += '<div>' + row.score + '</div>'
                                                    strHtml += '</div>'
                                                }
                                                strHtml += '</div>'
                                                strHtml += '<a href="'+ gengduo_jf +'" class="rankinglist_announcement_more" target="_blank">查看更多</a>'
                                                $("#chao_ji").html(strHtml);
                                            }
                                        });
                                    }
                                </script>
                            </div>
                            <!-- 女射手 -->
                            <div class="rankinglist_announcement_bottom" id="chao_she" style="display: none;">
                                <script>
                                    fetchSuperGoal('526-2025','http://women.thecfa.cn/cwsl_data_2025/index.html')
                                    function fetchSuperGoal(jab,gengduo_she) {
                                        $.ajax({
                                            url: 'https://women.thecfa.cn/json/top/goal/'+jab+'.json',
                                            type: 'get',
                                            // dataType: "json",
                                            success: function (data) {
                                                var strHtml = "";
                                                strHtml += '<div class="ranking_title she_title"><div>排名</div><div>球员</div><div>球队</div><div>进球（点球）</div></div>';
                                                strHtml += '<div class="ranking_content" style="height:200px">'
                                                for (var i = 0; i < data.goal.length; i++) {
    
                                                    var row = data.goal[i];
                                                    strHtml += '<div class="ranking_content_item she">'
                                                    strHtml += '<div>' + (i + 1) + '</div>'
                                                    strHtml += '<div>' + row.playName + '</div>'
                                                    strHtml += '<div>' + row.clubName + '</div>'
                                                    strHtml += '<div>' + row.total + '(' + row.penalty + ')' + '</div>'
                                                    strHtml += '</div>'
                                                }
                                                strHtml += '</div>'
                                                strHtml += '<a href="'+ gengduo_she +'" class="rankinglist_announcement_more" target="_blank">查看更多</a>'
                                                $("#chao_she").html(strHtml);
                                            }
                                        });
                                    }
                                </script>
                            </div>
                        </div>
                    </div>
                    <!-- 青少年联赛 -->
                    <div class="info info7" style="display: none;">
                        <style>
                            .event .superTab {
                                display: flex;
                                margin-bottom: 10px;
                            }
                            .event .superTab>div {
                                height: 28px;
                                font-size: 15px;
