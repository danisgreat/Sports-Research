                                font-size: 18px;
                                font-weight: bold;
                                color: #039646;
                            }
                        </style>
                        <div class="shaonTab superTab">
                            <div class="title_green">U-19组</div>
                            <div>U-15组</div>
                            <div>U-13组</div>
                        </div>
                        <div class="rankinglist_announcement_top">
                            <div class="title_green shaon_jf_tab">积分榜</div>
                            <div>射手榜</div>
                        </div>
                        <div class="item">
                            <!-- 青少年-积分 -->
                            <div class="rankinglist_announcement_bottom" id="shaon_ji">
                                <script>
                                    shaon_ji('2022090600');
                                    function shaon_ji(lid){
                                        $.ajax({
                                            url: 'https://data.thecfa.cn/scoreboard.do',
                                            data: 'lid='+ lid +'&year=2022',
                                            dataType: "jsonp",
                                            type: 'post',
                                            success: function (json) {
                                                let strHtml = "";
                                                strHtml += '<div class="ranking_title"><div>排名</div><div>球队</div><div>胜</div><div>平</div><div>负</div><div>积分</div></div>';
                                                strHtml += '<div class="ranking_content">'
                                                for (var i = 0; i < json.length; i++) {
                                                    if (i > 4) break
                                                    var row = json[i];
                                                    strHtml += '<div class="ranking_content_item">'
                                                    strHtml += '<div>' + row.ranking + '</div>'
                                                    strHtml += '<div>' + row.name + '</div>'
                                                    strHtml += '<div>' + row.win + '</div>'
                                                    strHtml += '<div>' + row.draw + '</div>'
                                                    strHtml += '<div>' + row.loss + '</div>'
                                                    strHtml += '<div>' + row.score + '</div>'
                                                    strHtml += '</div>'
                                                }
                                                strHtml += '</div>'
                                                strHtml += '<a href="https://www.thecfa.cn/qcls/index.html" class="rankinglist_announcement_more" target="_blank">查看更多</a>'

                                                $("#shaon_ji").html(strHtml);
                                            },
                                            error: function () {
                                                // alert('fail');
                                            }
                                        });
                                    }
                                    function shaon_zg(lid){
                                        $.ajax({
                                            url: 'https://data.thecfa.cn/gameplans.do',
                                            data: 'lid='+ lid +'&year=2022',
                                            dataType: "jsonp",
                                            type: 'post',
                                            success: function (json) {
                                                var strHtml = '<div class="ranking_title"><div style="width: 98px;margin:0px;">日期</div><div style="width: 230px;margin:0px;">比赛结果</div></div>';
                                                strHtml += '<div class="ranking_content">';
                                                for (var i = 0; i < json.length; i++) {
                                                    if (i > 4) break
                                                    strHtml += '<div class="ranking_content_item">';
                                                    strHtml += '<div style="width: 27%">' + json[i].gametime.substring(0, 16).split(" ")[0] + '</div>';
                                                    strHtml += '<div style="width: 32%">' + json[i].hostteamname.substring(0, 4) + '...</div>';
                                                    strHtml += '<div style="width: 8%">' + json[i].score.substring(0, 3).split(" ")[0] + '</div>';
                                                    strHtml += '<div style="width: 32%">' + json[i].clientteamname.substring(0, 4) + '...</div>';
                                                    strHtml += '</div>';
                                                }
                                                strHtml += '</div>';
                                                strHtml += '<a href="https://www.thecfa.cn/qcls/index.html" class="rankinglist_announcement_more" target="_blank">查看更多</a>'
                                                $("#shaon_ji").html(strHtml);
                                            }
                                        });
                                    }
                                </script>
                            </div>
                            <!-- 青少年-射手 -->
                            <div class="rankinglist_announcement_bottom" id="shaon_she" style="display:none;">
                                <script>
                                    shaonShe('2022090600')
                                    function shaonShe(lid) {
                                        let strHtml = "";
                                        $.ajax({
                                            url: 'https://data.thecfa.cn/shooter.do',
                                            data: 'lid='+ lid +'&year=2022',
                                            dataType: "jsonp",
                                            type: 'post',
                                            success: function (json) {
                                                strHtml += '<div class="ranking_title she_title"><div>排名</div><div>球员</div><div>球队</div><div>进球</div></div>';
                                                strHtml += '<div class="ranking_content">'
                                                for (var i = 0; i < json.length; i++) {
                                                    var row = json[i];
                                                    strHtml += '<div class="ranking_content_item she">'
                                                    strHtml += '<div>' + row.ranking + '</div>'
                                                    strHtml += '<div>' + row.playername + '</div>'
                                                    strHtml += '<div>' + row.teamname + '</div>'
                                                    strHtml += '<div>' + row.goalnum + '</div>'
                                                    strHtml += '</div>'
                                                }
                                                strHtml += '</div>'
                                                strHtml += '<a href="https://www.thecfa.cn/qcls/index.html" class="rankinglist_announcement_more" target="_blank">查看更多</a>'
                                                $("#shaon_she").html(strHtml);
                                            }
                                        });
                                    }
                                </script>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <script>
                $(function () {
                    window.onload = function () {
                        $('.rankinglist_title>div:first-child').trigger("click")
                    }
                    //一级切换
                    $('.rankinglist_title').on('click', 'div', function () {
                        let index = $(this).index()
                        $(this).addClass('title_big').siblings().removeClass("title_big")
                        window.className = 'info' + index
                        $('.rankinglist_announcement .info').eq(index).show().siblings().hide()
                    })

                    //u-19 切换 u-15
                    $('.shaonTab div').click(function () {
                        var index = $(this).index();
                        var arrTab = ['2022090600','2022082508','2022082308'];
                        if(index == 0){
                            $('.shaon_jf_tab').html('积分榜');
                            shaon_ji(arrTab[index]);
                        } else {
                            $('.shaon_jf_tab').html('赛果');
                            shaon_zg(arrTab[index]);
                        }
                        shaonShe(arrTab[index])
                        $(this).addClass('title_green').siblings().removeClass("title_green")
                        $('.shaon_jf_tab').addClass('title_green').siblings().removeClass("title_green")
                        $('.' + window.className + ' .rankinglist_announcement_bottom').eq(0).show().siblings().hide()
                    })

                    //女超 切换 女甲
                    $('.womanTab div').click(function () {
                        var index = $(this).index();
                        var arrTab = ['526-2025','527-2025','302-2023'];
                        var gengduo_jf = ['http://women.thecfa.cn/cwsl_standings_2025/index.html','http://women.thecfa.cn/cwfl_standings_2025/index.html','http://women.thecfa.cn/cwc_2023/cwc_standings.html'];
                        var gengduo_she = ['http://women.thecfa.cn/cwsl_data_2025/index.html','http://women.thecfa.cn/cwfl_data_2025/index.html','http://women.thecfa.cn/cwc_2023/cwc_standings.html'];
                        if(index == 1){
                            // fetchSuperRound('527-202201',gengduo_jf[index])
                            fetchSuperRound('527-2025',gengduo_jf[index])
                        }else if(index == 0){
                            fetchSuperRound('526-2025',gengduo_jf[index])
                        }
                        else{
                            fetchSuperRound(arrTab[index],gengduo_jf[index])
                        }
                        fetchSuperGoal(arrTab[index],gengduo_she[index])
                        $(this).addClass('title_green').siblings().removeClass("title_green")
                        $('.woman_jf_tab').addClass('title_green').siblings().removeClass("title_green")
                        $('.' + window.className + ' .rankinglist_announcement_bottom').eq(0).show().siblings().hide()
                    })

                    // 积分 - 射手 切换
                    $('.rankinglist_announcement_top').on('click', 'div', function () {
                        let index = $(this).index()
                        $(this).addClass('title_green').siblings().removeClass("title_green")
                        $('.' + window.className + ' .rankinglist_announcement_bottom').eq(index).show().siblings().hide()
                    })

                    // $('.rankinglist_title>div:first').addClass("title_big")
                    // $('.info:first').show().siblings().hide()
                    // $('.item .rankinglist_announcement_bottom:first').show().siblings().hide()
                    // $('.rankinglist_title>div').click(function () {
                    //     $(this).addClass("title_big").siblings().removeClass("title_big")
                    //     $(".info").eq($(".rankinglist_title>div").index(this)).show().siblings().hide()
                    //     $('.item .rankinglist_announcement_bottom:first-child').show().siblings().hide()
                    // })
                    // $(".rankinglist_announcement_top>div").click(function () {
                    //     let index = $(this).index()
                    //     $(this).addClass("title_green").siblings().removeClass("title_green")
                    //     $('.item .rankinglist_announcement_bottom').eq($(".rankinglist_announcement_top>div").index(this)).show().siblings().hide()
                    //     // $('.rankinglist_announcement_bottom').eq($(".rankinglist_announcement_bottom").index()).hide().siblings().show()
                    // })
                })

            </script>
        </div>
    </div>

