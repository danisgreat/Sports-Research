                        <div class="item">
                            <div class="rankinglist_announcement_bottom" id="zxb_sg">
                                <script>
                                     <!--getgameplansResult2(2023062701,1,2023);-->
                                     getgameplansResult2(20260422,3,2026);
                                    //足协杯赛果榜
                                    function getgameplansResult2(lid, round, year) {
                                        $.ajax({
                                            url: 'https://rest.thecfa.cn/game-plan/get-plan-result',
                                            data: 'lid=' + lid  + '&year=' + year  + '&isall=2',
                                            dataType: "json",
                                            type: 'post',
                                            success: function (json) {
                                                var strHtml = '<div class="ranking_title" style =" gap: 6px;"><div style="width: 100px;margin-left: 15px;">日期</div><div style="width: 180px;margin:0px;">比赛结果</div></div>';
                                                strHtml += '<div class="ranking_content">';

                                                var time = "";
                                                var datestr = "";
                                                var city = "";
                                                var score = "";

                                                for (var i = 0; i < json.length; i++) {
                                                    if (i > 4) break
                                                    time = json[i].gametime;
                                                    datestr = time.substring(0, 16);
                                                    if (json[i].city == undefined) {
                                                        city = "";
                                                    } else {
                                                        city = json[i].city;
                                                    }
                                                    if (json[i].score == undefined) {
                                                        score = "";
                                                    } else {
                                                        score = json[i].score;
                                                    }
                                                    var hostteamname1 = json[i].hostteamname.replace(/\u8db3\u7403\u4ff1\u4e50\u90e8/g, "");
                                                    var hostteamname2 = hostteamname1.replace(/\u6709\u9650\u516c\u53f8/g, "");
                                                    var hostteamname3 = hostteamname2.replace(/\u96c6\u56e2/g, "");
                                                    var hostteamname4 = hostteamname3.replace(/\u6709\u9650\u8d23\u4efb\u516c\u53f8/g, "");
                                                    var hostteamname5 = hostteamname4.replace(/\u804c\u4e1a/g, "");
                                                    var hostteamname = hostteamname5.replace(/\u80a1\u4efd/g, "");
                                                    hostteamname=  hostteamname.length > 5 ? hostteamname.slice(0, 4) + '....' : hostteamname;  
                                                    
                                                    // hostteamname = hostteamname + (hostteamname.length === 4 ? "  " : "");
                                                    var clientteamname1 = json[i].clientteamname.replace(/\u8db3\u7403\u4ff1\u4e50\u90e8/g, "");
                                                    var clientteamname2 = clientteamname1.replace(/\u6709\u9650\u516c\u53f8/g, "");
                                                    var clientteamname3 = clientteamname2.replace(/\u96c6\u56e2/g, "");
                                                    var clientteamname4 = clientteamname3.replace(/\u6709\u9650\u8d23\u4efb\u516c\u53f8/g, "");
                                                    var clientteamname5 = clientteamname4.replace(/\u804c\u4e1a/g, "");
                                                    var clientteamname = clientteamname5.replace(/\u80a1\u4efd/g, "");
                                                    clientteamname=  clientteamname.length > 5 ? clientteamname.slice(0, 4) + '...' : clientteamname;
                                                    strHtml += '<div class="ranking_content_item">';
                                                    strHtml += '<div style="width: 100px;margin-left: 15px;">' + datestr.split(' ')[0] + '</div>';
                                                    strHtml += '<div style="width:87px;text-align:right;padding-left:0" >' + hostteamname + '</div>';
                                                    strHtml += '<div  style="width:40px;">' + score + '</div>';
                                                    strHtml += '<div style="width: auto">' + clientteamname + '</div>';
                                                    strHtml += '</div>';
                                                }
                                                strHtml += '</div>';
                                                strHtml += '<a href="https://www.thecfa.cn/zxb/index.html" class="rankinglist_announcement_more" target="_blank">查看更多</a>'
                                                $("#zxb_sg").html(strHtml);
                                            },
                                            error: function () {
                                                //alert('fail');
                                            }
                                        });
                                    }
                                </script>
                            </div>
