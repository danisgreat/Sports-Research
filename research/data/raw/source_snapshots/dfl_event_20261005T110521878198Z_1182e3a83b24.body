ontent-ng-c2859481003 class="overlay-inner"><div _ngcontent-ng-c2859481003 class="container-fluid"><div _ngcontent-ng-c2859481003 class="row title"><div _ngcontent-ng-c2859481003 class="col-8"><span _ngcontent-ng-c2859481003 class="matchfact-title">Goal probability</span></div><div _ngcontent-ng-c2859481003 class="col-4"><button _ngcontent-ng-c2859481003 type="button" class="close" jsaction="click:;"><dfl-simple-icon _ngcontent-ng-c2859481003 icon="close" _nghost-ng-c4282993974 ngh="6"><img _ngcontent-ng-c4282993974 aria-hidden="true" alt class="auto" width="25" height="25" loading="lazy" fetchpriority="auto" decoding="auto" ng-img="true" src="/assets/icons/simple/close.svg"></dfl-simple-icon></button></div></div><div _ngcontent-ng-c2859481003 class="row description"><span _ngcontent-ng-c2859481003>Goal probability determines the likelihood that the ball will land in the goal from every position on the pitch. The value is based on large amounts of data from previous years; factors such as shot angle, distance to goal and opponent pressure - as well as mathematical models.</span></div><div _ngcontent-ng-c2859481003 class="row matchfacts"><livetickerevent-matchfacts-banner _ngcontent-ng-c2859481003 _nghost-ng-c3738688064 ngh="28"><a _ngcontent-ng-c3738688064 target="_blank" class="matchfacts-sponsor" href="https://www.bundesliga.com/en/bundesliga/info/provider/aws"><dfl-image _ngcontent-ng-c3738688064 height="40" dark="/assets/liveticker/powered-by-aws-white.svg" light="/assets/liveticker/powered-by-aws.svg" _nghost-ng-c656278645 ngh="27"><!----><!----><!----><img _ngcontent-ng-c656278645 class="light" src="/assets/liveticker/powered-by-aws.svg" alt height="40" loading="eager" fetchpriority="auto" jsaction="error:;"><img _ngcontent-ng-c656278645 class="dark" src="/assets/liveticker/powered-by-aws-white.svg" alt height="40" loading="eager" fetchpriority="auto" jsaction="error:;"><!----></dfl-image></a><!----><!----></livetickerevent-matchfacts-banner></div></div></div>