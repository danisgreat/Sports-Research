t" style="color: #000000;"> 650 <!----></span></div><div _ngcontent-ng-c1251780261 class="bar right" style="background-color: #005AAA; width: calc(35.2589641434263% - 2px);"><span _ngcontent-ng-c1251780261 class="value right" style="color: #FFFFFF;"> 354 <!----></span></div><!----></div></div></bar-chart><text-chart _ngcontent-ng-c1665606642 style="margin-top: 6px; display: block;" _nghost-ng-c3889971007 ngh="6"><div _ngcontent-ng-c3889971007 class="text-chart"><span _ngcontent-ng-c3889971007 class="left">90 %</span><strong _ngcontent-ng-c3889971007 class="title">Accuracy</strong><span _ngcontent-ng-c3889971007 class="right">83 %</span></div></text-chart></div><div _ngcontent-ng-c1665606642 class="horizontal-line"></div><div _ngcontent-ng-c1665606642 class="col-12 heading-row"><div _ngcontent-ng-c1665606642 class="empty-col"></div><h2 _ngcontent-ng-c1665606642 class="title">Pass Efficiency</h2><livetickerevent-matchfacts-info _ngcontent-ng-c1665606642 matchfact="passEfficiency" icon="question" textcolor="#D20515" _nghost-ng-c2859481003 ngh="29"><div _ngcontent-ng-c2859481003 class="metric-info" jsaction="click:;"><dfl-simple-icon _ngcontent-ng-c2859481003 _nghost-ng-c4282993974 ngh="6"><img _ngcontent-ng-c4282993974 aria-hidden="true" alt class="auto" width="20" height="20" loading="lazy" fetchpriority="auto" decoding="auto" ng-img="true" src="/assets/icons/simple/question.svg"></dfl-simple-icon><span _ngcontent-ng-c2859481003 style="color: #D20515;"><!--ngetn--></span></div><!----><div _ngcontent-ng-c2859481003 class="overlay" jsaction="click:;"></div><div _ngcontent-ng-c2859481003 class="overlay-inner"><div _ngcontent-ng-c2859481003 class="container-fluid"><div _ngcontent-ng-c2859481003 class="row title"><div _ngcontent-ng-c2859481003 class="col-8"><span _ngcontent-ng-c2859481003 class="matchfact-title">Pass Efficiency</span></div><div _ngcontent-ng-c2859481003 class="col-4"><button _ngcontent-ng-c2859481003 type="button" class="close" jsaction="click:;"><dfl-simple-icon _ngcontent-ng-c2859481003 icon="close" _nghost-ng-c4282993974 ngh="6"><img _ngcontent-ng-c4282993974 aria-hidden="true" alt class="auto" width="25" height="25" loading="lazy" fetchpriority="auto" decoding="auto" ng-img="true" src="/assets/icons/simple/close.svg"></dfl-simple-icon></button></div></div><div _ngcontent-ng-c2859481003 class="row description"><span _ngcontent-ng-c2859481003>Pass Efficiency compares the number of successful passes with the number of passes expected to find another teammate. For this, every pass receives an AI-calculated probability to be a successful one. If a player has a positive Pass Efficiency value, he has brought more passes to his teammates than predicted.</span></div><div _ngcontent-ng-c2859481003 class="row matchfacts"><livetickerevent-matchfacts-banner _ngcontent-ng-c2859481003 _nghost-ng-c3738688064 ngh="28"><a _ngcontent-ng-c3738688064 target="_blank" class="matchfacts-sponsor" href="https://www.bundesliga.com/en/bundesliga/info/provider/aws"><dfl-image _ngcontent-ng-c3738688064 height="40" dark="/assets/liveticker/powered-by-aws-white.svg" light="/assets/liveticker/powered-by-aws.svg" _nghost-ng-c656278645 ngh="27"><!----><!----><!----><img _ngcontent-ng-c656278645 class="light" src="/assets/liveticker/powered-by-aws.svg" alt height="40" loading="eager" fetchpriority="auto" jsaction="error:;"><img _ngcontent-ng-c656278645 class="dark" src="/assets/liveticker/powered-by-aws-white.svg" alt height="40" loading="eager" fetchpriority="auto" jsaction="error:;"><!----></dfl-image></a><!----><!----></livetickerevent-matchfacts-banner></div></div></div></livetickerevent-matchfacts-info></div><div _ngcontent-ng-c1665606642 class="stats-wrapper col-12"><stats-playerprogressranking-card _ngcontent-ng-c1665606642 _nghost-ng-c3290924102 ngh="33"><div _ngcontent-ng-c3290924102 class="playerprogressranking-card"><span _ngcontent-ng-c3290924102 class="title"><!--ngetn--></span><div _ngcontent-ng-c3290924102 class="bar"><bar-progress-c