tml":false,"entryDate":"2026-09-06T22:21:39+0200","entryType":"video","hidden":false,"matchSection":"PRE_MATCH","order":10000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"none"},"7502462114129248256":{"conference":false,"detail":{"aspectRatio":"16:9","duration":64,"headline":"Watch: Werder Bremen 3-1 RB Leipzig - last time out","text":"Ridlu Baku's strike in the sixth minute of stoppage time on his 250th Bundesliga appearance proved nothing but a consolation as Martín Demichelis' Leipzig suffered a 3-1 defeat against Werder Bremen.","uploadDate":"2026-09-05T15:55:17.000Z","videoId":"1KjZjQTg"},"enableHtml":false,"entryDate":"2026-09-06T22:22:52+0200","entryType":"video","hidden":false,"matchSection":"PRE_MATCH","order":20000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"none"},"7502462663373357056":{"conference":false,"detail":{"aspectRatio":"16:9","duration":123,"headline":"Watch: Hamburg 1-2 RB Leipzig - previous meeting","text":"Rômulo and Yan Diomande found the net as the Saxony club overturned a 1-0 deficit to secure a comeback victory in Hamburg on Matchday 24 of 2025\u002F26.","uploadDate":"2026-03-01T20:42:25.000Z","videoId":"hIlZNLt0"},"enableHtml":false,"entryDate":"2026-09-06T22:27:07+0200","entryType":"video","hidden":false,"matchSection":"PRE_MATCH","order":30000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"none"},"7503146279141113856":{"conference":false,"detail":{"copyright":"IMAGO\u002Fosnapix \u002F Michael Titgemeyer","headline":"Third time lucky for Nkunku?","text":"Ahead of Matchday 3, Leipzig have had the most shots in the division (42) and boast the highest xG (6.2). However, Christopher Nkunku is yet to score on his return after six attempts on goal.","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F8\u002Fimago1082402012h.jpg?crop=0px,0px,4310px,2873px"},"enableHtml":false,"entryDate":"2026-09-08T19:44:14+0200","entryType":"image","hidden":false,"matchSection":"PRE_MATCH","order":80000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"none"},"7503146672227090432":{"conference":false,"detail":{"copyright":"IMAGO\u002FEibner-Pressefoto\u002FMarcel von Fehrn","headline":"Second-season wobble","text":"After finishing 13th in their first Bundesliga season since 2017\u002F18, Hamburg have now made their worst-ever start to a top-flight campaign, with zero points and a -7 goal difference.","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F8\u002Fimago1082483878h.jpg?crop=0px,0px,4500px,3000px"},"enableHtml":false,"entryDate":"2026-09-08T19:45:50+0200","entryType":"image","hidden":false,"matchSection":"PRE_MATCH","order":70000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"away"},"7503800055288037376":{"conference":false,"detail":{"channelsEnabled":{"mobile":true,"web":false},"embedPlatform":"monterosa","eventId":"591470c3-5756-4e07-b20e-266e6b789970","projectId":"18fcbca1-809f-40ac-9587-30488c355541"},"enableHtml":false,"entryDate":"2026-09-10T15:02:02+0200","entryType":"embed","hidden":false,"matchSection":"PRE_MATCH","order":110000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"none"},"7503931905868300288":{"conference":false,"detail":{"copyright":"Claudio Villa","headline":"Leipzig looking to bounce back","text":"Martín Demichelis' men suffered a heavy 4-1 defeat in their UEFA Champions League opener away to tournament debutants Como. The Italian side proved too much for Die Roten Bullen to handle, but Andrija Maksimović provided a glimmer of hope for Leipzig with his goal in the 58th minute, upon which they will be hoping to build against Hamburg.","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F8\u002FGettyImages-2294560885.jpg?crop=0px,58px,4208px,2805px"},"enableHtml":false,"entryDate":"2026-09-10T23:40:47+0200","entryType":"image","hidden":false,"matchSection":"PRE_MATCH","order":120000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"none"},"7504154735880962048":{"conference":true,"detail":{"copyright":"IMAGO\u002FEibner-Pressefoto\u002FMarcel von Fehrn","headline":"Merlin Polzin on facing Leipzig","text":"\"We need to show a completely different side to ourselves compared to last weekend. There are no excuses [for the defeat against Mainz]. There are lots of little steps we need to follow to achieve our goal, and hopefully a lot more of those will be on display against Leipzig. We're eager to win football matches and want to show that on the pitch.\"","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F8\u002Fimago1082515926h.jpg?crop=523px,351px,5103px,3400px"},"enableHtml":false,"entryDate":"2026-09-11T14:30:04+0200","entryType":"image","hidden":false,"matchSection":"PRE_MATCH","order":130000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"away"},"7504463842231975936":{"conference":false,"detail":{"copyright":"IMAGO\u002FRoger Petzsche","headline":"Schäfer releases statement","text":"After back-to-back defeats, managing director for sport Marcel Schäfer released a statement on Friday. \"We are highly ambitious, but we are also critical of ourselves. The last two results have not been good enough,\" he said. \"We know that, and we are not going to sugar-coat it. We are addressing the situation very clearly internally. At the same time, we are staying calm and focused, and we are united as a club. That applies to everyone who works here, the players and the entire coaching staff. They all have our full support and trust. We made a number of changes over the summer, brought new players into the squad and have also had several injuries to deal with. Important players are now coming back. A new-look team needs time to gel and to develop an understanding on the pitch. That is simply the reality. We believe in the quality of our squad and we know what this team is capable of. Now we need to learn the right lessons, continue to work hard and make progress over the coming weeks.\"","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F7\u002Fimago1080671036.jpg?crop=0px,0px,6000px,4000px"},"enableHtml":false,"entryDate":"2026-09-12T10:59:44+0200","entryType":"image","hidden":false,"matchSection":"PRE_MATCH","order":140000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"home"},"7504884116068761600":{"conference":false,"detail":{"headline":"Leipzig subs","text":"Nyland, Finkgräfe, Estéve, Maksimović, Baku, Seiwald, Rômulo, Nkunku, Guiu"},"enableHtml":false,"entryDate":"2026-09-13T14:48:27+0200","entryType":"freetext","hidden":false,"matchSection":"PRE_MATCH","order":145000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"home"},"7504884425901998080":{"conference":false,"detail":{"headline":"Hamburg subs","text":"Tangvik, Omari, Lemke, Nadir, Adeline, Viera, Moffi, Jatta, Stange"},"enableHtml":false,"entryDate":"2026-09-13T14:50:39+0200","entryType":"freetext","hidden":false,"matchSection":"PRE_MATCH","order":155000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"away"},"7504885584817553408":{"conference":false,"detail":{"copyright":"IMAGO\u002FDeFodi.de","headline":"Leipzig team news","text":"Following their disappointing Champions League opener in Como, Martín Demichelis has made five changes to his starting line-up. Gomis, Banzuzi, Henrichs, Ouédraogo, and Gruda replace Guiu, Seiwald, Baku, Nkunku, and Maksimović. Ouédraogo is playing for the first time in the Bundesliga this season after returning from injury.","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F7\u002Fimago1080674560.jpg?crop=0px,0px,2817px,1879px"},"enableHtml":false,"entryDate":"2026-09-13T14:54:44+0200","entryType":"image","hidden":false,"matchSection":"PRE_MATCH","order":190000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"home"},"7504888354807218176":{"conference":false,"detail":{"copyright":"IMAGO\u002FFernando Soares","headline":"Hamburg team news","text":"The visitors have also made a raft of changes from their last game, in which they lost 5-0 at home to Mainz. Poulsen, Daka, Nandja and Lokonga have been brought into the starting eleven for HSV. New signings Adeline, Nadir, and Moffi, along with the injured Bornauw, have been dropped from the starting line-up.","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F8\u002Fimago1082289463h.jpg?crop=0px,0px,5074px,3383px"},"enableHtml":false,"entryDate":"2026-09-13T14:57:45+0200","entryType":"image","hidden":false,"matchSection":"PRE_MATCH","order":200000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"away"},"7504890098035458048":{"conference":false,"detail":{"aspectRatio":"9:16","duration":46,"headline":"Watch: Poulsen returns to Leipzig","uploadDate":"2026-09-13T13:12:15.000Z","videoId":"xItr2DI5"},"enableHtml":false,"entryDate":"2026-09-13T15:13:08+0200","entryType":"video","hidden":false,"matchSection":"PRE_MATCH","order":210000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"none"},"7504890577515708416":{"conference":false,"detail":{"aspectRatio":"9:16","duration":9,"headline":"Watch: Keepers come out to warm-up","uploadDate":"2026-09-13T13:14:57.000Z","videoId":"OmwI875C"},"enableHtml":false,"entryDate":"2026-09-13T15:15:20+0200","entryType":"video","hidden":false,"matchSection":"PRE_MATCH","order":220000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"none"},"7504891809407959040":{"conference":false,"detail":{"copyright":"IMAGO\u002FBEAUTIFUL SPORTS\u002FBuriakov","headline":"Starting XI debut for Nandja","text":"After three substitute appearances for Hamburg, 19-year-old Nandja, who replaces the injured Bornauw, is set to make his first start in the Bundesliga. He will therefore wear a debut patch on his jersey this afternoon.","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F7\u002Fimago1082139071.jpg?crop=0px,4px,3000px,1999px"},"enableHtml":false,"entryDate":"2026-09-13T15:17:12+0200","entryType":"image","hidden":false,"matchSection":"PRE_MATCH","order":230000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"home"},"7504894591028428800":{"conference":false,"detail":{"headline":"We're underway!","text":"Leipzig get the game going on home soil. "},"enableHtml":false,"entryDate":"2026-09-13T15:31:22+0200","entryType":"freetext","hidden":false,"matchSection":"FIRST_HALF","order":100020000,"pinned":false,"playtime":{"injuryTime":0,"minute":1},"side":"none"},"7504896268737445888":{"conference":false,"detail":{"headline":"Early corner","text":"Hamburg have made a strong start to the game and are putting Leipzig under some early pressure. However, the home side defend it well. "},"enableHtml":false,"entryDate":"2026-09-13T15:36:01+0200","entryType":"freetext","hidden":false,"matchSection":"FIRST_HALF","order":400010000,"pinned":false,"playtime":{"injuryTime":0,"minute":4},"side":"away"},"7504896832313491456":{"conference":false,"detail":{"headline":"Capaldo booked","text":"The Hamburg defender tries to prevent a Leipzig counterattack by committing a tactical foul. He duly picks up an early yellow card. "},"enableHtml":false,"entryDate":"2026-09-13T15:38:32+0200","entryType":"freetext","hidden":false,"matchSection":"FIRST_HALF","order":700010000,"pinned":false,"playtime":{"injuryTime":0,"minute":7},"side":"away"},"7504898819029467136":{"conference":false,"detail":{"headline":"Hendrichs from range!","text":"There's the first dangerous shot of the match. Henrichs cuts inside from the right and unleashes a shot from around 25 yards. His left-footed effort is deflected by the sliding Torunarigha and whistles just past the right post."},"enableHtml":false,"entryDate":"2026-09-13T15:45:12+0200","entryType":"freetext","hidden":false,"matchSection":"FIRST_HALF","order":1200010000,"pinned":false,"playtime":{"injuryTime":0,"minute":12},"side":"home"},"7504899495813971968":{"conference":false,"detail":{"copyright":"Stuart Franklin","headline":"Gomis with the opener!","text":"Leipzig lead. Gruda cleverly plays the ball down the right flank to Banzuzi, who crosses it low into the middle from the right wing. Gomis is perfectly positioned and fires the ball into the near corner with his first touch. Clinical stuff from the youngster! ","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F8\u002FGettyImages-2295040547.jpg?crop=0px,0px,5516px,3678px"},"enableHtml":false,"entryDate":"2026-09-13T15:50:00+0200","entryType":"image","hidden":false,"matchSection":"FIRST_HALF","order":1700020000,"pinned":false,"playtime":{"injuryTime":0,"minute":17},"side":"none"},"7504899723795365888":{"conference":false,"detail":{"headline":"Leipzig's form player","text":"After recording two assists in his first home game, Gomis now has three goal involvements after three matchdays - an RBL record."},"enableHtml":false,"entryDate":"2026-09-13T15:51:40+0200","entryType":"freetext","hidden":false,"matchSection":"FIRST_HALF","order":2000010000,"pinned":false,"playtime":{"injuryTime":0,"minute":20},"side":"none"},"7504901452796526592":{"conference":false,"detail":{"headline":"Hosts well on top","text":"Henrichs wins a corner kick on the right. Raum's corner is headed clear of the penalty area, but it's all one way traffic at the moment. "},"enableHtml":false,"entryDate":"2026-09-13T15:56:20+0200","entryType":"freetext","hidden":false,"matchSection":"FIRST_HALF","order":2500010000,"pinned":false,"playtime":{"injuryTime":0,"minute":25},"side":"home"},"7504902201962135552":{"conference":false,"detail":{"aspectRatio":"9:16","duration":14,"headline":"Nusa makes it 2-0!","text":"The Norwegian winger is played in behind the Hamburg backline after a defensive error. He shapes up to shoot from the edge of the HSV penalty area, but he hits his shot against the leg of Torunarigha, which then flies beyond the reach of Heuer Fernandes - and into the net. There was a touch of fortune about that, but Leipzig won't mind! ","uploadDate":"2026-09-13T14:31:41.000Z","videoId":"WC7WxkhJ"},"enableHtml":false,"entryDate":"2026-09-13T15:59:38+0200","entryType":"video","hidden":false,"matchSection":"FIRST_HALF","order":2900010000,"pinned":false,"playtime":{"injuryTime":0,"minute":29},"side":"home"},"7504903337586720768":{"conference":false,"detail":{"headline":"Nusa's strong start","text":"After netting four goals in pre-season, Nusa has scored his second in the Bundesliga, having previously found the net against Mönchengladbach."},"enableHtml":false,"entryDate":"2026-09-13T16:05:10+0200","entryType":"freetext","hidden":false,"matchSection":"FIRST_HALF","order":3100010000,"pinned":false,"playtime":{"injuryTime":0,"minute":31},"side":"home"},"7504903573533097984":{"conference":false,"detail":{"headline":"Early change for the hosts","text":"Ouédraogo just cannot catch a break. In his first game back since recovery from an injury, the Leipzig midfielder is forced off with another issue. Summer signing Nkunku is on to replace him. "},"enableHtml":false,"entryDate":"2026-09-13T16:06:33+0200","entryType":"freetext","hidden":false,"matchSection":"FIRST_HALF","order":3600010000,"pinned":false,"playtime":{"injuryTime":0,"minute":36},"side":"home"},"7504904383528697856":{"detail":{"away":{"relativeValue":0,"value":0.0719},"headline":"A fair reflection","home":{"relativeValue":2,"value":0.6815},"matchFact":true,"metric":"goalsMetricTitle","text":"Leipzig are winning the match - and winning the xG battle. ","title":"xGoals","type":"clubProgressRanking"},"enableHtml":false,"entryDate":"2026-09-13T16:09:07+0200","entryType":"stats","hidden":false,"matchSection":"FIRST_HALF","order":3900010000,"pinned":false,"playtime":{"injuryTime":0,"minute":39},"side":"none"},"7504904725519663104":{"conference":false,"detail":{"headline":"Daka's effort drifts wide","text":"Wolfe starts the move, finding Grønbæk who plays it onto El Ouahdi. The ball reaches Daka, but his shot rolls just wide of Vandevoordt's near-post. "},"enableHtml":false,"entryDate":"2026-09-13T16:11:38+0200","entryType":"freetext","hidden":false,"matchSection":"FIRST_HALF","order":4100010000,"pinned":false,"playtime":{"injuryTime":0,"minute":41},"side":"none"},"7504906766551875584":{"conference":false,"detail":{"headline":"Henrichs again","text":"Gomis, Banzuzi and Nusa combine and set up Henrichs, but his shot is blocked by Wolfe for a corner. The corner comes to nothing."},"enableHtml":false,"entryDate":"2026-09-13T16:15:56+0200","entryType":"freetext","hidden":false,"matchSection":"FIRST_HALF","order":4400010000,"pinned":false,"playtime":{"injuryTime":0,"minute":44},"side":"home"},"7504908170838409216":{"conference":false,"detail":{"copyright":"Stuart Franklin","headline":"Half-time: Leipzig 2-0 Hamburg","text":"The home side have a comfortable lead at the break. After a good start by HSV, Leipzig had their first attempt at goal through Henrichs, whose shot was well blocked. Gomis and Nusa then showed more composure and made it 2-0 before the half-hour mark. If Hamburg want to take anything from this game, they'll need to offer significantly more in the second half.","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F8\u002FGettyImages-2295043301.jpg?crop=0px,0px,4704px,3137px"},"enableHtml":false,"entryDate":"2026-09-13T16:25:32+0200","entryType":"image","hidden":false,"matchSection":"HALF","order":4502010000,"pinned":false,"playtime":{"injuryTime":2,"minute":45},"side":"none"},"7504909525330165760":{"conference":false,"detail":{"aspectRatio":"9:16","duration":20,"headline":"Watch: Poulsen steps back onto the Red Bull Arena Turf","uploadDate":"2026-09-13T13:34:57.000Z","videoId":"RO98LXiq"},"enableHtml":false,"entryDate":"2026-09-13T16:27:58+0200","entryType":"video","hidden":false,"matchSection":"PRE_MATCH","order":225000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"home"},"7504911392885964800":{"conference":false,"detail":{"headline":"Second half gets going","text":"We're back underway at the Red Bull Arena. Hamburg have made a change for the second half, bringing on Moffi for Poulsen. "},"enableHtml":false,"entryDate":"2026-09-13T16:37:00+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":4700010000,"pinned":false,"playtime":{"injuryTime":0,"minute":47},"side":"none"},"7504911911700398080":{"conference":false,"detail":{"headline":"Lukeba booked","text":"The RBL defender takes out El Ouahdi down the left flank and consequently receives a yellow card.\n"},"enableHtml":false,"entryDate":"2026-09-13T16:40:14+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":4900010000,"pinned":false,"playtime":{"injuryTime":0,"minute":49},"side":"home"},"7504912741392449536":{"conference":false,"detail":{"headline":"Raum's Free Kick Blocked","text":"The Leipzig captain sees his free kick blocked following Nicolai Remberg's foul on El Aynaoui. Raum's effort is comfortably dealt with by the Hamburg defence, which has looked a bit more secure so far this half. "},"enableHtml":false,"entryDate":"2026-09-13T16:42:09+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":5300010000,"pinned":false,"playtime":{"injuryTime":0,"minute":53},"side":"none"},"7504913307707375616":{"conference":false,"detail":{"headline":"Chance for Hamburg","text":"Finally, the visitors are starting the threat again. The ball is laid into the path of El Ouahdi on the right side of the RBL penalty area. The Hamburg midfielder tries to beat Vandevoordt at the near-post, but the Belgian is alert to the danger. "},"enableHtml":false,"entryDate":"2026-09-13T16:43:59+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":5600010000,"pinned":false,"playtime":{"injuryTime":0,"minute":56},"side":"away"},"7504914572097093632":{"conference":false,"detail":{"headline":"Just wide from Nkunku","text":"Gomis floats a lovely ball towards the Hamburg far post where Nkunku is waiting. The Frenchman attempts an acrobatic volley, but his effort misses the target by no more than a few inches. "},"enableHtml":false,"entryDate":"2026-09-13T16:49:48+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":5900010000,"pinned":false,"playtime":{"injuryTime":0,"minute":59},"side":"home"},"7504914936292704256":{"detail":{"away":{"value":44},"headline":"Leipzig enjoying more of the ball","home":{"value":56},"matchFact":false,"text":"It won't come as a shock, but the host have controlled possession this afternoon. Even now, with Hamburg needing two goals, it's Leipzig who are confidently spraying the ball around the pitch. ","title":"possessionTitle","type":"pie"},"enableHtml":false,"entryDate":"2026-09-13T16:51:17+0200","entryType":"stats","hidden":false,"matchSection":"SECOND_HALF","order":6200010000,"pinned":false,"playtime":{"injuryTime":0,"minute":62},"side":"none"},"7504915659512348672":{"conference":false,"detail":{"headline":"Tame from Moffi","text":"The Hamburg forward evades his marker and strides towards the Leipzig goal However, his attempted shot, from just outside the penalty area, is far too central to test Vandevoordt. "},"enableHtml":false,"entryDate":"2026-09-13T16:53:37+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":6500010000,"pinned":false,"playtime":{"injuryTime":0,"minute":65},"side":"away"},"7504916940935135232":{"conference":false,"detail":{"headline":"Top save!","text":"The balls at the feet of Nkunku inside the six-yard box. He shoots at goal, but Heuer Fernandes makes an excellent reaction save to keep his side in the game. "},"enableHtml":false,"entryDate":"2026-09-13T16:59:02+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":6900010000,"pinned":false,"playtime":{"injuryTime":0,"minute":69},"side":"away"},"7504917161022849024":{"conference":false,"detail":{"headline":"Another booking","text":"Nandja, in his first Bundesliga start, picks up a yellow card for dragging Nusa to the ground. Free kick for RBL in a dangerous area..."},"enableHtml":false,"entryDate":"2026-09-13T17:00:38+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":7100020000,"pinned":false,"playtime":{"injuryTime":0,"minute":71},"side":"away"},"7504917583817080832":{"conference":false,"detail":{"headline":"Orbán adds a third goal!","text":"Nusa, who won the initial free kick, swings in a perfect delivery that picks out the head of Orbán inside the area. He powers the ball beyond a helpless Heuer Fernandes to wrap up the three points for Leipzig. "},"enableHtml":false,"entryDate":"2026-09-13T17:01:53+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":7200030000,"pinned":false,"playtime":{"injuryTime":0,"minute":72},"side":"home"},"7504918927168765952":{"conference":false,"detail":{"copyright":"Stuart Franklin","headline":"Nkunku scores!","text":"The French player scores his first goal since his return and his 48th Bundesliga goal overall! It all comes from a long Vandevoordt kick, who picks out Nusa down the left channel. He then feeds the ball to Nkunku, who keeps his composure and slots it beyond the Hamburg keeper. ","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F8\u002FGettyImages-2295054285.jpg?crop=0px,0px,5238px,3490px"},"enableHtml":false,"entryDate":"2026-09-13T17:06:58+0200","entryType":"image","hidden":false,"matchSection":"SECOND_HALF","order":7500010000,"pinned":false,"playtime":{"injuryTime":0,"minute":75},"side":"none"},"7504919295822921728":{"conference":false,"detail":{"headline":"Leipzig score a fifth!","text":"HSV are falling apart! Omari receives a throw-in at the halfway line and is pressured by Rômulo. The striker gets to the ball first and then runs alone towards goal. At the edge of the penalty area, he rounds Heuer Fernandes before slotting it into an empty net."},"enableHtml":false,"entryDate":"2026-09-13T17:09:01+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":7800030000,"pinned":false,"playtime":{"injuryTime":0,"minute":78},"side":"home"},"7504920059148500992":{"conference":false,"detail":{"headline":"Late changes for both sides ","text":"Nusa, who has been at his electrifying best today, makes way for Finkgräfe. Hamburg, meanwhile, have replaced Lokonga with Stange for the final 10 minutes or so. "},"enableHtml":false,"entryDate":"2026-09-13T17:11:46+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":8000010000,"pinned":false,"playtime":{"injuryTime":0,"minute":80},"side":"none"},"7504920984210636800":{"conference":false,"detail":{"headline":"Hamburg have dropped right back","text":"There's not much coming from the away side anymore in an offensive sense. If any team is still playing attacking football, it's Leipzig."},"enableHtml":false,"entryDate":"2026-09-13T17:15:56+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":8400010000,"pinned":false,"playtime":{"injuryTime":0,"minute":84},"side":"home"},"7504921586277810176":{"conference":false,"detail":{"headline":"Hamburg's final substitution","text":"With the match winding down, Polzin has decided to bring on Jatta for El Ouahdi."},"enableHtml":false,"entryDate":"2026-09-13T17:18:08+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":8900020000,"pinned":false,"playtime":{"injuryTime":0,"minute":89},"side":"none"},"7504921622369796096":{"conference":false,"detail":{"headline":"Gruda's effort flies over","text":"Baku intercepts the ball and Banzuzi quickly finds Gruda, but his shot sails harmlessly over the crossbar."},"enableHtml":false,"entryDate":"2026-09-13T17:19:01+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":8800010000,"pinned":false,"playtime":{"injuryTime":0,"minute":88},"side":"none"},"7504922133525430272":{"conference":false,"detail":{"headline":"Added time","text":"There will be an additional three minutes of play. The HSV players will surely be glad it's not any longer. "},"enableHtml":false,"entryDate":"2026-09-13T17:20:32+0200","entryType":"freetext","hidden":false,"matchSection":"SECOND_HALF","order":9001010000,"pinned":false,"playtime":{"injuryTime":1,"minute":90},"side":"home"},"7504925205655977984":{"conference":false,"detail":{"copyright":"Stuart Franklin","headline":"Full-time: Leipzig 5-0 Hamburg","text":"Leipzig ran out decisive winners against Hamburg, who are still yet to pick up a single point this season. The hosts added three goals in the second half, with Nkunku getting his first for Leipzig since making his return this summer. The result lifts RBL up to fifth in the table, while HSV are now rock bottom. ","url":"https:\u002F\u002Fassets.bundesliga.com\u002Fcontender\u002F2026\u002F8\u002FGettyImages-2295054129.jpg?crop=0px,0px,2480px,1652px"},"enableHtml":false,"entryDate":"2026-09-13T17:29:41+0200","entryType":"image","hidden":false,"matchSection":"FINAL_WHISTLE","order":9004030000,"pinned":false,"playtime":{"injuryTime":4,"minute":90},"side":"none"},"7504945399157751808":{"conference":true,"detail":{"aspectRatio":"9:16","duration":10,"headline":"Nusa on Leipzig's big win","uploadDate":"2026-09-13T16:47:18.000Z","videoId":"1fieOw0v"},"enableHtml":false,"entryDate":"2026-09-13T18:52:48+0200","entryType":"video","hidden":false,"matchSection":"FINAL_WHISTLE","order":9004040000,"pinned":false,"playtime":{"injuryTime":4,"minute":90},"side":"none"},"7fc5a12e-16c0-4fb3-856c-630cf4818aca":{"detail":{"decision":"No goal","review":"Offside?","score":{"away":0,"home":5},"situation":"No goal"},"entryDate":"2026-09-13T17:21:15+0200","entryType":"videoAssistant","matchSection":"SECOND_HALF","order":9000010000,"playtime":{"injuryTime":0,"minute":90},"side":"none"},"end_firstHalf":{"detail":{"score":{"away":0,"home":2}},"entryDate":"2026-09-13T16:17:41+0200","entryType":"end_firstHalf","matchSection":"FIRST_HALF","order":4503010000,"playtime":{"injuryTime":3,"minute":45},"side":"none"},"end_secondHalf":{"detail":{"score":{"away":0,"home":5}},"entryDate":"2026-09-13T17:22:48+0200","entryType":"end_secondHalf","matchSection":"SECOND_HALF","order":9004020000,"playtime":{"injuryTime":4,"minute":90},"side":"none"},"finalWhistle":{"detail":{"score":{"away":0,"home":5}},"entryDate":"2026-09-13T17:22:48+0200","entryType":"finalWhistle","matchSection":"FINAL_WHISTLE","order":9004010000,"playtime":{"injuryTime":4,"minute":90},"side":"none"},"intro":{"conference":false,"detail":{"headline":"Hello and welcome!","text":"Welcome along and thanks for joining us for build-up and live coverage of this Matchday 3 fixture between RB Leipzig and Hamburg."},"enableHtml":false,"entryDate":"2026-07-02T11:49:41+0200","entryType":"freetext","hidden":false,"matchSection":"PRE_MATCH","order":-10000,"pinned":false,"playtime":{"injuryTime":0,"minute":0},"side":"none"},"lineup_away":{"detail":{"formation":"3-4-2-1 Double-10","lineup":[{"dflDatalibraryObjectId":"DFL-OBJ-0001EH","imageUrl":"https:\u002F\u002Fassets.bundesliga.com\u002Fplayer\u002Fdfl-obj-0001eh-dfl-clu-00000c-dfl-sea-0001ka.png","name":"Daniel Heuer Fernandes","position":"TW","shirtNumber":1},{"dflDatalibraryObjectId":"DFL-OBJ-J0255S","imageUrl":"https:\u002F\u002Fassets.bundesliga.com\u002Fplayer\u002Fdfl-obj-j0255s-dfl-clu-00000c-dfl-sea-0001ka.png","name":"Shafiq Nandja","position":"IVL","shirtNumber":43},{"dflDatalibraryObjectId":"DFL-OBJ-0027JU","imageUrl":"https:\u002F\u002Fassets.bundesliga.com\u002Fplayer\u002Fdfl-obj-0027ju-dfl-clu-00000c-dfl-sea-0001ka.png","name":"Jordan Torunarigha","position":"IVZ","shirtNumber":23},{"dflDatalibraryObjectId":"DFL-OBJ-J01H5G","imageUrl":"https:\u002F\u002Fassets.bundesliga.com\u002Fplayer\u002Fdfl-obj-j01h5g-dfl-clu-00000c-dfl-sea-0001ka.png","name":"Nicolás Capaldo","position":"IVR","shirtNumber":24},{"dflDatalibraryObjectId":"DFL-OBJ-J01KPV","imageUrl":"https:\u002F\u