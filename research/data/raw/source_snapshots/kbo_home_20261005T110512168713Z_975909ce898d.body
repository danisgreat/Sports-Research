            getTopBannerNew();         // 상단 슬라이드(NEW)
            setTopNews();           // 상단 KBO NEWS 8개 
            setTeamRank();          // 팀 순위

            getGameDate(nowDate);   // 경기일정

            getHitterRank();        // 타자 순위
            //getPitcherRank();     // 투수순위 --> #tabPlayerRank 클릭 이벤트 안으로 이동
