            //        return;
            //    }
            //} catch (e) { }

            $.datepicker.setDefaults($.datepicker.regional['ko']);
            let nowDate = $.datepicker.formatDate('yymmdd', date);


            let check = true;
            document.addEventListener('scroll', function () {
                if (check) {
                    //console.log('currentScrollValue is ' + currentScrollValue);

                    getPlayerTrade(); // 선수이동현황

                    getNoticeBanner();  // 노티스 배너
                    getHomeBanner();    // KBO 배너
                    getSponBanner();    // 스폰서 배너
        //getSponBanner2();   // 스폰서2 배너
                    //setHighlight(2026); // 하이라이트

                    setPressRelease();              // KBO 보도자료
                    setNotice();                     // KBO NOTICE
                    //setNews();                    // KBO NEWS
                    getVedio(2026);                     // 비디오 판독
                    getCheckedSwingVideo(2026);                     // 체크스윙 판독
                    CheckCache(); //==> 인스타그램 캐시 확인 함수
                    getYoutube(); //  유튜브
                    getYoutubeShorts();
                    getMedicalVod(); // 의무위원회
                    check = false;
                }

            });


            //if (Request("notshow") == "true") {
            //    $.cookie("notshow", true, { expires: 1 });
            //}


            //let allstarBannerStart = new Date(2020, 10, 1, 09, 00);
