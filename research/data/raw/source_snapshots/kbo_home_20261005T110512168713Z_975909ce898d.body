        // 초기 진입 영상
        function setMainPopup() {
            if ($.cookie("_popupVideo") == undefined) {
                // 초기 진입 영상 불러오기
                getMainPopup();

                $(document).on("click", "#popupVideo", function (e) {
                    if ($("#popValCheck").is(":checked") == true) {
                        $("body").removeClass("modal-hidden");
                        $(".event-wrap").remove();
                        $(".modal").addClass("dp-none");

                        setCookie("_popupVideo", "done", 1);
                    }
                    else {
                        $("body").removeClass("modal-hidden");
                        $(".event-wrap").remove();
                        $(".modal").addClass("dp-none");
                    }
                    //sessionStorage.setItem("popup", false); // 쿠키 추가로 인해 세션 스토리지 주석 처리
                    e.preventDefault();
                });
            }
        }

        // 쿠키 생성 함수
        function setCookie(name, value, expiredays) {
            var todayDate = new Date();
            todayDate.setDate(todayDate.getDate() + expiredays);
            document.cookie = name + "=" + escape(value) + "; path=/; expires=" + todayDate.toGMTString() + ";"
        }

        // 경기종료 따라 NEWS 선택변경 (경기전:프리뷰, 경기종료:속보)
        function setNewsTab() {
            var tabNo = setNewsCheck('1,2,3,20');    // 프리뷰,경기속보,인터뷰
            switch (tabNo) {
                case 1: // 프리뷰
                    tabNo = 0;
                    break;
                case 2: // 속보
                    tabNo = 1;
                    break;
                case 3: // 인터뷰
                    tabNo = 3;
                    break;
                case 20: // 카드뉴스
                    tabNo = 2;
                    break;
            }
            $("#tabNews > li").removeClass();
            $("#tabNews > li").eq(tabNo).addClass("on");
        }

        // 탭 개수에 따른 클래스
        function addTabClass(count) {
            var tabClass = '';

            switch (count) {
                case 2:
                    tabClass = "two";
                    break;
                case 3:
                    tabClass = "three";
                    break;
                case 4:
                    tabClass = "four";
                    break;
                default:
                    tabClass = "";
                    break;
            }

            return tabClass;
        }

