            //});



            setEventBinding(nowDate);   // 이벤트 바인딩

            //setTiebreakDate(); // 타이브레이크 종료시 주석


            //getSaveSacrifice() // Save & Sacrifice 캠페인

            $("#btnLiveIssue").click(function (e) {
                e.preventDefault();
                var url = e.target.href;
                window.open(url, 'pop', 'toolbar=no,menubar=no,location=no,scrollbars=no,status=no, width=980, height=' + screen.availHeight + '');
                return false;
            })
        });

        // 초기화
        function initControl() {
            var minYear = 2010;
            var maxYear = getGameMaxYear("0,1,3,4,5,7,9"); //new Date().getFullYear();
            $('#txtGameDate').datepicker({
                dateFormat: 'yymmdd'
                , minDate: '20100306'
                , showOn: "button"
                , buttonImage: "//6ptotvmi5753.edge.naverncp.com/KBO_IMAGE/KBOHome/resources/images/main/btn_calendar.png"
                , buttonImageOnly: true
                , beforeShow: function (textbox, instance) {
                    instance.dpDiv.css({
                        marginTop: '30px',
                        marginLeft: '-163px'
                    });
                }, onSelect: function (selectedDate) {
                    getGameDate(selectedDate);        // 2021까지 메인에서 일정 바뀜  // 22.09.23 (추가) 다시 월별일정 -> 메인 일정변경으로 수정
                    //getMonthCalendar(selectedDate);     // 2022부터 월별일정으로 이동
                    $(".tab-depth1").addClass("dp-none");
                },
                changeMonth: true,
                changeYear: true,
                yearRange: String.format("{0}:{1}", minYear, maxYear),
                yearSuffix: ''
            });

            $("#txtGameDate").val($.datepicker.formatDate('yymmdd', new Date()));
            $("#lblGameDate").text($.datepicker.formatDate('yy.mm.dd(D)', new Date()));
            $(".game-info").hide();
            $("#FL").hide();

            // KBO베너
            if ($("#ulKboBanner").children().length > 1) {
                $('#ulKboBanner').bxSlider({
                    controls: true,
                    auto: true,
                    pause: 15000,
                    pager: true,
                    infiniteLoop: true
                });
            }

            // 하단 스폰서 리스트
            if ($("#sponsor ul.sponsor-list").children().length > 7) {
                $('.sponsor-list').bxSlider({
                    auto: true
                    , pause: 3000
                    , pager: false
                    , controls: false
                    , autoStart: true
                    , autoControls: false
                    , slideWidth: 148
                    , minSlides: 7
                    , maxSlides: 7
                    , moveSlides: 1
                    , slideMargin: 10
                    , infiniteLoop: true
                    , hideControlOnEnd: true
                });
            }
        }

        // 타이브레이크 순위결정전 날짜 변경 숨김
        //function setTiebreakDate() {
        //    $("#lnkPrev").parent().hide();
        //    $("#lnkNext").parent().hide();
        //    $("#txtGameDate").next().hide();
        //};

        // 이벤트 세팅
        function setEventBinding(nowDate) {
            // 리그 탭
            $(document).on("click", ".tab-league > ul > li > a", function (e) {
                var tab = $(this).parents("li");
                tab.addClass("on").siblings().removeClass("on");
                var leId = tab.attr("le-id");
                var srId = tab.attr("sr-id");
                var seasonId = tab.attr("season_id");
                let types = String(tab.attr("match-type")).split(' ');

                $("#FL").hide();
                $("#lblGameTitle").hide();
                $("#gameTab").hide();
                $("#gameDetail").hide();

                if (leId == "1" && srId == "6" && types[0] == "tiebreaker") {
                    $("#lnkPrev").parent().hide();
                    $("#lnkNext").parent().hide();
                    $("#txtGameDate").next().hide();

                    getTiebreakerGame(types[1], nowDate);
                } else {
                    $("#lnkPrev").parent().show();
                    $("#lnkNext").parent().show();
                    $("#txtGameDate").next().show();

                    getGameDate(nowDate);
                }
                //getGameDate(nowDate);

                if (leId == "2") {
                    if (srId == "15") {  // Fall League
                        setEduHitterRank();
                        setEduTeamRank();
                    }
                    else {
                        setFuturesHitterRank();
                        setFuturesTeamRank();
                    }

                    $(".game-info").show();
                    $("#FL").show();
                }

                // 23.01.03, 김연중, 포스트시즌 미표출로 인한 주석처리
                // POST SEASON BRACKET
                //if (leId == "1" && srId == "3,4,5,7") {
                //    hideAllRankingTab();
                //    showTabPostseasonBracket();
                //    showTabTeamRanking();
                //} else if (leId = "1" && srId == "0") {
                //    hideAllRankingTab();
                //    showTabTeamRanking();
                //}

                e.preventDefault();
            });

            // 경기리스트 새로고침
            $(document).on("click", "#btnGameRefresh", function (e) {
                var li = $(".game-list-n > li.on");
                var gameSc = li.attr("game_sc");
                var leId = li.attr("le_id");
                var srId = li.attr("sr_id");
                var gId = li.attr("g_id");

                getGameList();

                $(".game-list-n > li[g_id='" + gId + "'").addClass("on").siblings().removeClass("on");

                if (leId == "1") {
                    if (srId == "1" || (srId == "0" && gameSc != "1")) {
                        setGameDetailAnalysis();
                    }
                }

                e.preventDefault();
            });

            // 경기(프리뷰,LIVE,리뷰) 버튼 클릭
            //$(document).on("click", ".game-list-n > li ", function (e) {
            //    var li = $(this);
            //    //if (li.attr("le_id") == "1" && li.attr("sr_id") == "6" && ((li.attr("game_sc") == "1" && li.attr("lineup_ck") == 0) || li.attr("game_sc") == "3")) {
            //    //    return false;
            //    //}
            //    if (li.hasClass("cancel") == false) {   // 취소경기 선택불가
            //        if (li.hasClass("on")) {
            //            li.removeClass("on");

            //            if (li.attr("le_id") == "1") { // 2017-04-18 yeeun, 퓨처스리그는 항상 보여야함
            //                $(".game-info").hide();
            //            }

            //            if (li.attr("le_id") == "1" && li.attr("sr_id") == "9" && (li.attr("game_sc") == "1" || li.attr("game_sc") == "3")) { // 2017-07-14 yeeun, 올스타전 예외처리
            //                setAllstarClick(li);
            //            } else if (li.attr("le_id") == "1" && li.attr("sr_id") == "8") { // 2017-11-08 yeeun, APBC 예외처리
            //                //} else if (li.attr("le_id") == "1" && li.attr("sr_id") == "8" && li.attr("season") == "2019") { // 2017-11-08 yeeun, APBC 예외처리, 2019년도 프리미어12 문자중계 진행(한국경기만)
            //                //alert("click")
            //                setAllstarClick(li);
            //            } else if (li.attr("le_id") == "1" && (li.attr("sr_id") == "6" && li.attr("season") != "2021")) { // 2017-11-08 yeeun, APBC 예외처리
            //                //} else if (li.attr("le_id") == "1" && li.attr("sr_id") == "8" && li.attr("season") == "2019") { // 2017-11-08 yeeun, APBC 예외처리, 2019년도 프리미어12 문자중계 진행(한국경기만)
            //                //alert("click")
            //                setAllstarClick(li);
            //            } else if (li.attr("le_id") == "1" && (li.attr("sr_id") == "4" || li.attr("sr_id") == "3" || li.attr("sr_id") == "5" || li.attr("sr_id") == "7") && li.attr("season") == "2016" && (li.attr("game_sc") == "3" && li.attr("result_ck") == "1")) { // 2017-09-29 yeeun, 2016 포스트시즌 예외처리
            //                location.href = String.format("/Schedule/GameCenter/Main.aspx?gameDate={0}&gameId={1}&section=REVIEW", li.attr("g_dt"), li.attr("g_id"));
            //                //} else if(li.attr("le_id") == "1" && li.attr("sr_id") == "0"){    // 2017-11-09 yeeun, 정규시즌 예외처리
            //                //    location.href = String.format("/Schedule/GameCenter/Main.aspx?gameDate={0}&gameId={1}&section=REVIEW", li.attr("g_dt"), li.attr("g_id"));
            //            } else if (li.attr("le_id") == "1" && li.attr("sr_id") == "0" && li.attr("result_ck") == "1") {    // 2019-03-07 heokyunam 정규시즌도 전송 확인. 홍승규대리 요청
            //                location.href = String.format("/Schedule/GameCenter/Main.aspx?gameDate={0}&gameId={1}&section=REVIEW", li.attr("g_dt"), li.attr("g_id"));
            //            }
            //        } else {
            //            li.addClass("on").siblings().removeClass("on");
            //            setGameDetail();
            //        }
            //    }

            //    e.preventDefault();
            //});

            // 타자 정보 누를 때 불러오기
            $(document).one("click", "#btnRankingNext, #btnRankingPrev ", function (e) {
                getHitterRank();
            });

            // 경기 일정 중간 부분
            $(document).on("click", ".game-list-n > li > .wrap > .middle", function (e) {
                var li = $(this).parent().parent();
                var leId = li.attr("le_id");
                var srId = li.attr("sr_id");
                var gId = li.attr("g_id");
                var gameSc = li.attr("game_sc");
                var season = li.attr("season");
                var result = li.attr("result_ck");
                var lineup = li.attr("lineup_ck");

                if (li.hasClass("cancel") == false) {                           // 취소경기 선택불가
                    if (!(leId == "2"))     // 2군 경기전,중 선택 불가
                    {
                        if (leId == "1" && (srId == "9" || srId == "8") && (gameSc == "1" || gameSc == "2" || gameSc == "3")) { // 2017-07-14 yeeun, 올스타전 예외처리
                            //setAllstarClick(li);  // 2022-07-01 안현수, middle 부분 클릭이벤트 제거 
                            return;
                        }

                        if (li.hasClass("on")) {            // 이미 클릭한 상태
                            li.removeClass("on");

                            if (leId == "1") { // 2017-04-18 yeeun, 퓨처스리그는 항상 보여야함
                                $(".game-info").hide();
                            }

                            if (leId == "1" && srId == "8") { // 2017-11-08 yeeun, APBC 예외처리
                                //} else if (li.attr("le_id") == "1" && li.attr("sr_id") == "8" && li.attr("season") == "2019") { // 2017-11-08 yeeun, APBC 예외처리, 2019년도 프리미어12 문자중계 진행(한국경기만)
                                //alert("click")
                                setAllstarClick(li);
                            } else if (leId == "1" && (srId == "6" && season != "2021")) { // 2017-11-08 yeeun, APBC 예외처리
                                //} else if (li.attr("le_id") == "1" && li.attr("sr_id") == "8" && li.attr("season") == "2019") { // 2017-11-08 yeeun, APBC 예외처리, 2019년도 프리미어12 문자중계 진행(한국경기만)
                                //alert("click")
                                setAllstarClick(li);
                            } else if (leId == "1" && (srId == "4" || srId == "3" || srId == "5" || srId == "7") && season == "2016" && (gameSc == "3" && result == "1")) { // 2017-09-29 yeeun, 2016 포스트시즌 예외처리
                                location.href = String.format("/Schedule/GameCenter/Main.aspx?gameDate={0}&gameId={1}&section=REVIEW", li.attr("g_dt"), gId);
                                //} else if(li.attr("le_id") == "1" && li.attr("sr_id") == "0"){    // 2017-11-09 yeeun, 정규시즌 예외처리
                                //    location.href = String.format("/Schedule/GameCenter/Main.aspx?gameDate={0}&gameId={1}&section=REVIEW", li.attr("g_dt"), li.attr("g_id"));
                            } else if (leId == "1" && (srId == "0" || srId == "1") && result == "1") {    // 2019-03-07 heokyunam 정규시즌도 전송 확인. 홍승규대리 요청
                                location.href = String.format("/Schedule/GameCenter/Main.aspx?gameDate={0}&gameId={1}&section=REVIEW", li.attr("g_dt"), gId);
                            }
                        } else {
                            li.addClass("on").siblings().removeClass("on");

                            // 1군, 정규, 기록 전송 후 .middle 클릭 시 리뷰 페이지
                            if (leId == "1" && (srId == "0" || srId == "1" || srId == "6") && result == "1") {
                                location.href = String.format("/Schedule/GameCenter/Main.aspx?gameDate={0}&gameId={1}&section=REVIEW", li.attr("g_dt"), gId);
                            } else {
                                setGameDetail();
                            }
                        }
                    } else {
                        // 교육리그 중계 X
                        if ((Number(lineup) > 0 || gameSc == "2") && gameSc != "3" && srId != 15) {
                            //var checkLogin = chekLogin();

                            //if (checkLogin) {
                                var url = String.format("/Game/Futures/LiveText.aspx?leagueId={0}&seriesId={1}&gameId={2}&gyear={3}", leId, srId, gId, season);
                                window.open(url, 'FuturesLiveText', 'toolbar=no,menubar=no,location=no,scrollbars=no,status=no, width=1020, height=720'); return false;
                            //} else {
                            //    if (gameSc != "3")
                            //        alert("로그인을 하셔야 문자중계를 보실 수 있습니다");
                            //    return false;
                            //}
                        }
                    }

                }

                e.preventDefault();
            });

            // 경기 일정 하단 버튼
            $(document).on("click", ".game-cont > .wrap > .bottom > ul > li > a", function (e) {
                var li = $(this).parent().parent().parent().parent().parent();
                var leId = li.attr("le_id");
                var srId = li.attr("sr_id");
                var gId = li.attr("g_id");
                var gameSc = li.attr("game_sc");
                var season = li.attr("season");
                var result = li.attr("result_ck");
                var kbotSe = li.attr("kbot_se");
                var lineup = li.attr("lineup_ck");

                var btnText = $(this).text();

                if (li.hasClass("cancel") == false) {   // 취소경기 선택불가
                    // 2022.07.01, 김연중, 중복코드 단일화, "중계" 버튼 클릭 할 시
                    if (leId == "1" && (srId == "1" || srId == "0" || srId == "9" || srId == "3" || srId == "4" || srId == "5" || srId == "7" || srId == "6" || srId == "8") && btnText == "중계") { // KBO 정규시즌, 올스타전, 포스트시즌 > 중계 눌렀을 때
                        //var checkLogin = chekLogin();
                        //if (checkLogin) {
                            var url = String.format("/Game/LiveText.aspx?leagueId={0}&seriesId={1}&gameId={2}&gyear={3}", leId, srId, gId, season);
                            window.open(url, 'liveText', 'toolbar=no,menubar=no,location=no,scrollbars=no,status=no, width=1020, height=720'); return false;
                        //} else {
                        //    alert("로그인을 하셔야 문자중계를 보실 수 있습니다");
                        //    return false;
                        //}
                    }

                    if (leId == "1" && srId == "9" && (gameSc == "1" || gameSc == "3")) { // 2017-07-14 yeeun, 올스타전 예외처리 /  2022-07-01 안현수 올스타전 클릭이벤트 조건 변경
                        setAllstarClick(li);
                        return;
                    }

                    if (li.hasClass("on")) {            // 이미 클릭한 상태
                        li.removeClass("on");

                        if (leId == "1") { // 2017-04-18 yeeun, 퓨처스리그는 항상 보여야함
                            $(".game-info").hide();
                        }

                        if (leId == "1" && srId == "8") { // 2017-11-08 yeeun, APBC 예외처리
                            //} else if (li.attr("le_id") == "1" && li.attr("sr_id") == "8" && li.attr("season") == "2019") { // 2017-11-08 yeeun, APBC 예외처리, 2019년도 프리미어12 문자중계 진행(한국경기만)
                            //alert("click")
                            //setAllstarClick(li);
                        } else if (leId == "1" && (srId == "6" && (season != "2021" && season != "2024"))) { // 2017-11-08 yeeun, APBC 예외처리
                            //} else if (li.attr("le_id") == "1" && li.attr("sr_id") == "8" && li.attr("season") == "2019") { // 2017-11-08 yeeun, APBC 예외처리, 2019년도 프리미어12 문자중계 진행(한국경기만)
                            //alert("click")
                            setAllstarClick(li);
                        } else if (leId == "1" && (srId == "4" || srId == "3" || srId == "5" || srId == "7") && season == "2016" && (gameSc == "3" && result == "1")) { // 2017-09-29 yeeun, 2016 포스트시즌 예외처리
                            location.href = String.format("/Schedule/GameCenter/Main.aspx?gameDate={0}&gameId={1}&section=REVIEW", li.attr("g_dt"), gId);
                            //} else if(li.attr("le_id") == "1" && li.attr("sr_id") == "0"){    // 2017-11-09 yeeun, 정규시즌 예외처리
                            //    location.href = String.format("/Schedule/GameCenter/Main.aspx?gameDate={0}&gameId={1}&section=REVIEW", li.attr("g_dt"), li.attr("g_id"));
                        } //else if (leId == "1" && srId == "0" && result == "1") {    // 2019-03-07 heokyunam 정규시즌도 전송 확인. 홍승규대리 요청
                        //location.href = String.format("/Schedule/GameCenter/Main.aspx?gameDate={0}&gameId={1}&section=REVIEW", li.attr("g_dt"), gId);
                        //}

                    } else if (btnText != "TICKET") {
                        if (leId != "2") {

                            if (leId == "1" && srId == "8" && gameSc == "3") {
                                location.href = String.format("/Schedule/GameCenter/Main.aspx?gameDate={0}&gameId={1}&section=REVIEW", li.attr("g_dt"), gId);
                            }
                            else {
                                li.addClass("on").siblings().removeClass("on");
                                setGameDetail();
                            }
                        }
                    }

                    // 2군
                    if (leId == "2") {
                        if (gameSc == "3" && result == "1" && btnText == "경기정보") {
                            location.href = String.format("/Futures/Schedule/BoxScore.aspx?leagueId={0}&seriesId={1}&gameId={2}&seasonId={3}", leId, srId, gId, season);
                        } else if (btnText.indexOf("케이봇") > -1 && kbotSe > 0) {
                            location.href = String.format("/Futures/KBot/View.aspx?bdSe={0}", kbotSe);
                        } else if ((gameSc == "1" && Number(lineup > 0)) || gameSc == "2" && btnText == "중계") {
                            //var checkLogin = chekLogin();
                            //if (checkLogin) {
                                var url = String.format("/Game/Futures/LiveText.aspx?leagueId={0}&seriesId={1}&gameId={2}&gyear={3}", leId, srId, gId, season);
                                window.open(url, 'FuturesLiveText', 'toolbar=no,menubar=no,location=no,scrollbars=no,status=no, width=1020, height=720'); return false;
                            //} else {
                            //    alert("로그인을 하셔야 문자중계를 보실 수 있습니다");
                            //    return false;
                            //}
                        }
                    }
                }

            });

            // 경기(선발,키플레이어,NEWS,라인업 등) 탭 선택
            $(document).on("click", "#tabGame > li > a", function (e) {
                $(this).parent().addClass("on").siblings().removeClass("on");
                setGameDetailAnalysis();
                e.preventDefault();
            });

            // 퓨처스 랭킹(투수/타자) 탭 선택
            $(document).on("click", "#tabFutures > li > a", function (e) {
                var srId = $(".tab-league li.on").attr("sr-id");
                var rankTab = $(this).parent();
                rankTab.addClass("on").siblings().removeClass("on");
                var section = rankTab.attr("section");

                if (section == "hit") {
                    if (srId == "15")
                        setEduHitterRank();
                    else
                        setFuturesHitterRank();
                } else {
                    if (srId == "15")
                        setEduPitcherRank();
                    else
                        setFuturesPitcherRank();
                }

                e.preventDefault();
            });

            // KBO 랭킹(투수/타자/주간랭킹) 탭 선택
            $(document).on("click", "#tabPlayerRank > li > a", function (e) {
                var rankTab = $(this).parent();
                rankTab.addClass("on").siblings().removeClass("on");
                var section = rankTab.attr("section");

                if (section == "hit") {
                    $("#hitterRank").show();
                    $("#pitcherRank").hide();
                    $("#weeklyRank").hide();

                    $("#lblPlayerRank").show();
                    $("#lblWeekRank").hide();

                    //$(".player-ranking").children("span.btn-more").children("a").attr("href", "/Record/Ranking/Top5.aspx");
                    $("#rankMore").attr("href", "/Record/Ranking/Top5.aspx");
                } else if (section == "pit") {
                    getPitcherRank();   // 투수순위
                    $("#hitterRank").hide();
                    $("#pitcherRank").show();
                    $("#weeklyRank").hide();

                    $("#lblPlayerRank").show();
                    $("#lblWeekRank").hide();

                    //$(".player-ranking").children("span.btn-more").children("a").attr("href", "/Record/Ranking/Top5.aspx");
                    $("#rankMore").attr("href", "/Record/Ranking/Top5.aspx");
                } else {
                    getWeekRank();      // 주간순위
                    $("#hitterRank").hide();
                    $("#pitcherRank").hide();
                    $("#weeklyRank").show();

                    $("#lblPlayerRank").hide();
                    $("#lblWeekRank").show();

                    //$(".player-ranking").children("span.btn-more").children("a").attr("href", "/Record/Ranking/Week.aspx");
                    $("#rankMore").attr("href", "/Record/Ranking/Week.aspx");
                }

                e.preventDefault();
            });

            // 상단 랭킹 영역
            $(document).on("click", "ul.title > li > a", function (e) {
                let nowTitle = $(this).find('h4').attr('nowtype');

                hideAllRankingTab();

                switch (nowTitle) {

