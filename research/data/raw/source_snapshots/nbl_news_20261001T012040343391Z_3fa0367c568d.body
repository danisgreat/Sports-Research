/**
 * Safely get redirect param or fallback to current path
 */
function getRedirectTarget() {
  const url = new URL(window.location.href)
  const r = url.searchParams.get('r')

  if (r) {
    try {
      return decodeURIComponent(r)
    } catch {
      return r
    }
  }

  return url.pathname + url.search
}

/**
 * Remove origin if present
 */
function stripOrigin(path) {
  if (!path) return ''
  return path.startsWith(window.location.origin)
    ? path.replace(window.location.origin, '')
    : path
}

/**
 * True when value is absolute http(s) URL
 */
function isAbsoluteHttpUrl(value) {
  return /^https?:\/\//i.test(value || '')
}

/**
 * Append ?r= to buttons with [redirect-button]
 */
function addRedirectLinks() {
  const redirectTarget = encodeURIComponent(stripOrigin(getRedirectTarget()))

  document.querySelectorAll('[redirect-button]').forEach(btn => {
    if (!btn.href) return

    const url = new URL(btn.href, window.location.origin)
    url.searchParams.set('r', redirectTarget)
    btn.href = url.toString()
  })
}

/**
 * Populate data-ms-redirect attributes
 * - Internal path => keep as-is
 * - External URL => route via /auth/redirect?r=...
 */
function populateMsRedirect() {
  const redirectTarget = stripOrigin(getRedirectTarget())

  const memberstackRedirect = isAbsoluteHttpUrl(redirectTarget)
    ? `/auth/redirect?r=${encodeURIComponent(redirectTarget)}`
    : (redirectTarget || '/')

  document.querySelectorAll('[data-ms-redirect]').forEach(el => {
    el.setAttribute('data-ms-redirect', memberstackRedirect)
  })
}

function initRedirects() {
  addRedirectLinks()
  populateMsRedirect()
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initRedirects)
} else {
  initRedirects()
}
</script></div></div><nav class="navbar"><div class="navbar-container"><a href="/" class="brand-link w-inline-block"><img width="Auto" src="https://cdn.prod.website-files.com/64a4f0de3648103ab3295afa/6a9fbb2ab0a305fdc3326477_2d20783f49fe37b5744df758d11141d5_NBL-HJs%20Cropped.svg" alt="" class="brand-logo-1"/></a><div id="desktopMenu" class="nav-menu"><div class="desktop-nav-menu"><div class="primary-nav-menu"><div data-delay="0" data-hover="false" class="dropdown w-dropdown"><div class="dropdown-toggle w-dropdown-toggle"><div>News</div><div class="dropdown-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 16 17" fill="none" xmlns="http://www.w3.org/2000/svg">
