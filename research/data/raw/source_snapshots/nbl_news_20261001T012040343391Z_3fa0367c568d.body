        function autoslideToNextGame() {
        const completedElements = document.querySelectorAll('[data-status="complete"]');
        const completedElementsCount = completedElements?.length ?? 0;

        if (completedElementsCount === 0) {
            return;
        }

        const matchCardElement = document.querySelector('[data-name="match-card"]');
        const matchCardWidth = matchCardElement ? matchCardElement.offsetWidth : null;

        // Find the .w-dyn-list container
        const dynListContainer = document.querySelector('.ribbon.w-dyn-items');
        if (dynListContainer && matchCardWidth) {
            // Scroll the .w-dyn-list container to the right by matchCardWidth, with smooth behavior
            dynListContainer.scrollTo({
                left: completedElementsCount * (matchCardWidth + 16), // add 1 rem (16px)
                behavior: 'smooth'
            });
        }
    }

    // Run autoslideToNextGame when the DOM is ready
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", autoslideToNextGame);
    } else {
        autoslideToNextGame();
    }
