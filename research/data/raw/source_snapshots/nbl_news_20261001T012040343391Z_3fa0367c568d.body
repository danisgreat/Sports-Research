<script>
    document.addEventListener('DOMContentLoaded', async() => {
        const userIp = await fetch('https://api.ipify.org?format=json')  // Fetch the IP address
            .then(response => response.json())

        const currentDateTime = new Date();
        const formattedDateTime = currentDateTime.toISOString().replace('T', ' ').slice(0, 19);

        const populateFields = (query, value) => {
            const elements = document.querySelectorAll(query); // Replace with the ID of the hidden field
            if (value && !!elements?.length) {
                elements.forEach(element => {
                    if(element){
                        element.value = value
                    }
                })
            }
        }
        populateFields('.user-ip', userIp?.ip)
        populateFields('.current-date', formattedDateTime)

   });
</script>
