nt {\r\n  background: black;\r\n}\r\n\r\n.MkHeaderMobileNavigationItem .MkHeaderMobileNavigationItem__header {\r\n  color: white;\r\n}\r\n\r\n.MkHeaderMobileNavigationItem .MkHeaderMobileNavigationItem__toggle {\r\n  color: white;\r\n}\r\n\r\n.MkHeaderMobileNavigationItem .MkHeaderMobileNavigationItem__header.MkHeaderMobileNavigationItem--active {\r\n  background-color: rgba(255 255 255 / 0.2);\r\n  color: white;\r\n}\r\n\r\n.MkHeaderMobileNavigation .MkHeaderMobileNavigation__secondaryNavigation .MkHeaderMobileNavigationItem .MkHeaderMobileNavigationItem__header {\r\n  font-family: var(--font-primary);\r\n}\r\n\r\n.MkHeaderMobileNavigation .MkSelect .MkSelect__control {\r\n  --bg: transparent;\r\n  --color: white;\r\n}\r\n\r\n/* Footer */\r\n.MkFooter {\r\n  border-block-start: 6px solid var(--color-primary-60);\r\n}\r\n\r\n.MkFooterMenu {\r\n  --bg-color: black;\r\n  --label-color: white;\r\n}\r\n\r\n.MkFooterCopyright__root {\r\n  background: black;\r\n}\r\n\r\n.MkFooterCopyright__root .MkFooterCopyright__copyrightText,\r\n.MkFooterCopyright__root .MkFooterCopyright__link {\r\n  color: white;\r\n}\r\n\r\n.MkFooter .MkSelect .MkSelect__control {\r\n  --bg: black;\r\n  --color: white;\r\n}\r\n\r\n/* VideoCard B */\r\n.MkVideoCard.MkVideoCard--video-card-b .MkVideoCard__categoryAndDate {\r\n    border-inline-start: 1px solid var(--text-strong);\r\n    padding-inline-start: 10px;\r\n}\r\n\r\n/* Module Football PageList ListCompetitionMatch */\r\n.MkFootballModuleListCompetitionMatch .MkFootballModuleListCompetitionMatch__matchGroup__matchesList .MkFootballMatchCard--fullList:not(:first-child) {\r\n    border-top: 1px solid black;\r\n}\r\n\r\n.MkFootballModuleContentCompetitionTeamListMatches__matchList .MkFootballMatchCard--fullList:not(:first-child) {\r\n        border-top: 1px solid black;\r\n}\r\n\r\n/* Module FootballCompetitionMatchesCurrentGameweek */\r\n.MkFootballCompetitionModuleMatchesCurrentGameweek .splide__slide:not(:first-child) .MkFootballMatchCard.MkFootballMatchCard--smallCard::before,\r\n.MkFootballCompetitionModuleMatchesCurrentGameweek .MkFootballMatchCard.MkFootballMatchCard--smallCard:not(:first-child)::before {\r\n    content: \"\";\r\n    border-left: 1px solid black;\r\n    position: absolute;\r\n    top: 0;\r\n    bottom: 0;\r\n    left: -8px;\r\n}\r\n\r\n.MkFootballCompetitionModuleMatchesCurrentGameweek .MkFootballMatchCard.MkFootballMatchCard--smallCard {\r\n    overflow: revert;\r\n}\r\n\r\n.MkGrids .MkGrids__block.MkGrids__block--accessibleTextMode-light .MkFootballCompetitionModuleMatchesCurrentGameweek .MkFootballMatchCard.MkFootballMatchCard--smallCard::before {\r\n    border-color: white;\r\n}\r\n\r\n/* Small match card */\r\n.MkFootballMatchCard.MkFootballMatchCard--smallCard .MkFootballMatchCard__time,\r\n.MkFootballMatchCard.MkFootballMatchCard--smallCard .MkFootballMatchCard__warning,\r\n.MkFootballMatchCard.MkFootballMatchCard--smallCard .MkFootballMatchCard__result {\r\n  font-family: var(--font-highlighted);\r\n  font-size: 24px;\r\n  font-weight: 700;\r\n  line-height: 140%;\r\n}\r\n\r\n/* News carousel */\r\n.MkModuleCarousel .splide__slide:has(.MkNewsCard) + .splide__slide \u003e .MkNewsCard::before {\r\n    content: \"\";\r\n    position: absolute;\r\n    border-left: 1px solid black;\r\n    top: 0;\r\n    left: -16px;\r\n    bottom: 0;\r\n}\r\n\r\n.MkGrids .MkGrids__block.MkGrids__block--accessibleTextMode-light .MkModuleCarousel .MkNewsCard::before {\r\n    border-color: white;\r\n}\r\n\r\n/* Module Sponsors */\r\n.MkModuleSponsors .MkModuleSponsors__imagesContainer {\r\n    max-width: 100% \r\n}\r\n\r\n.MkModuleSponsors .MkModuleSponsors__imagesContainer .MkModuleSponsors__imageWapper {\r\n    max-width: 160px;\r\n}\r\n\r\n/* Onboarding */\r\n.MkOnboardingScreen,\r\n.MkOnboardingScreenSurface {\r\n  --bg: white;\r\n}\r\n\u003c/style\u003e\r\n\r\n\r\n\u003cscript\u003eCookieThough.init({\r\n  \"policies\": [\r\n      {\r\n      \"id\": \"essential\",\r\n      \"label\": \"Essentie