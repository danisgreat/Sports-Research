function disableSelectedPlayeSeason(cls){
    $("."+cls+" option").removeAttr('disabled');
    $("."+cls).each(function(){
        var val = $(this).val();
        if(val != ''){
            $('.'+cls+' option[value="'+val+'"]').attr('disabled','disabled');
            $(this).find('option[value="'+val+'"]').attr('disabled',false);
        }
        
    })
}
    
    </script>
             <script type="text/javascript">
        var logoutConfirm = 'Are you sure you want to logout?';
        $(document).ready(function(){

            $(document).on("click", "#logout_id", function(event){
                event.preventDefault();
                var url = $(this).attr('href');
                swal({
                        title: logoutConfirm,

                        icon: "warning",
                        buttons: true,
                        dangerMode: true,
                        buttons: ["Cancel", "OK"],
                    }) .then(function(willDelete){
                    if (willDelete) {
                        ajaxPost(url,null,function(response){

                            if(response.status == 'error'){

                            }else{
                                showAlert('success',response.message);
                                //$("#profile_div").html(response.html);
                                location.reload();
                            }
                        },'GET');
                    }
                });
            });
        });
    </script>


<script type="text/javascript">
     var sel = "--Please Select --";
    $(document).ready(function(){
        $(".feedback-competitin").trigger("change");
        $(".feedback-competitin").on("change",function(){
            var selectedMatch = "";
            var id = $(this).val();
            var tar = $(this).data('target');
            $("#"+tar).html('<option value="">'+sel+'</option>');
            if(id != ''){
                var url = 'https://www.uaeproleague.ae/en/get-matches/:id';
                url = url.replace(':id', id);
                ajaxPost(url,{selectedMatch : selectedMatch},function(response){
                   
                    $("#"+tar).html(response.html);
                    $('.custom-drop-contact-page').select2({
                        minimumResultsForSearch: -1
                      });
                },'GET',);
            }
            
        });

        $("#global_search_input").on("change, input",function(){
            $(".form-result-wrap").hide();
            var inputStr = $(this).val();
            $("#global_search_results").html();
            if(inputStr != ''){
                var postData = {inputStr : inputStr};
                var url = 'https://www.uaeproleague.ae/en/search-results-popup';
                ajaxPost(url,postData,function(response){
                     $("#global_search_results").html(response.html);
                     $(".form-result-wrap").show();
                },'GET');
            }

        });
        $("#signup-form-2").hide();
        $('.club-section-slider').not('.slick-initialized').slick({
            slidesToShow: 7,
            slidesToScroll: 1,
            autoplay: false,
            arrows: true,
            autoplaySpeed: 2000,
            infinite: false,

            responsive: [{
              breakpoint: 767,
              settings: {
                slidesToShow: 4,
                slidesToScroll: 1,
                infinite: false,


              }
            }]
          });
        $("#sign-up-2,#mob-sign-up-btn").on("click",function(){
            $('.club-section-slider').slick('unslick');
            $(".login-signin-1").hide();
            $("#signup-form-2").show();
            $('.club-section-slider').slick({
                slidesToShow: 7,
                slidesToScroll: 1,
                autoplay: false,
                arrows: true,
                autoplaySpeed: 2000,
                infinite: false,

                responsive: [{
                  breakpoint: 767,
                  settings: {
                    slidesToShow: 4,
                    slidesToScroll: 1,
                    infinite: false,


                  }
                }]
              });
        })
        $(".btn-close").on("click",function(){
            $(".login-signin-1").hide();
            $("#signup-form-2").hide();
        })
        $(".club-section-slider__item").on("click",function(){
            $(".clubSelected").prop('checked',false);
            $(this).find('.clubSelected').prop('checked',true);
        });


          var parent = document.querySelector(".phone-list-sign");


          if (parent !== null) {
            var input = parent.querySelector('input');

            var iti = window.intlTelInput(input, {
              //nationalMode: false,
              //autoHideDialCode: false,
             // autoHideDialCode: false,
              nationalMode: false,
              initialCountry: 'ae',
              preferredCountries: ["ae"],


              //hiddenInput : 'full',

              /*geoIpLookup: function(callback) {

                jQuery.get('https://ipinfo.io', function() {}, "jsonp").always(function(resp) {

                  var countryCode = (resp && resp.country) ? resp.country : "";

                  callback(countryCode);
                  //$("#mobile_code").val(countryCode);

                });
              }*/

            });

              input.addEventListener('countrychange', function(e) {
                  var country = iti.getSelectedCountryData();

                  $("#countryCode").val('+'+country.dialCode);
                });
          }

          var parent = document.querySelector(".phone-list-feedback");


          if (parent !== null) {
            var input = parent.querySelector('input');

            var iti = window.intlTelInput(input, {
              //nationalMode: false,
              //autoHideDialCode: false,
              autoHideDialCode: false,
              nationalMode: false,
              initialCountry: 'ae',
              preferredCountries: ["ae"],



            });
        }

    });



    /*$("#sign_up_button").submit( function(event){
