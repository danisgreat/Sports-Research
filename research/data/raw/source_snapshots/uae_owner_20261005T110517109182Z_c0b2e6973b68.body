                                    </svg>
                                    </a>
                                </div>
                            
                            
                                <div class="log-in-social__item">
                                    <a href="https://www.uaeproleague.ae/en/login/google">
                                    <svg class="log-in-social__icon">
                                        <use xlink:href="https://www.uaeproleague.ae/web/images/siginicon.svg#icon-signingoogle-plus"></use>
                                    </svg>
                                    </a>
                                </div>
                            

