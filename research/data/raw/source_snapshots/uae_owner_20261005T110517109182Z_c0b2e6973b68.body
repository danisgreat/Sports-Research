  function updateMacthListHome(childData){
       if(typeof childData != 'undefined' && childData.length > 0){
         var childData = childData.substring(1, childData.length-1);
         var childData = JSON.parse(childData);
        }
        var mId = childData.matchInfo.id;
        var parent = "#match_list_"+mId;
       
        if($("#match_list_"+mId).length == 1 && childData.liveData.matchDetails.matchStatus == 'Playing'){ 
          var mTime = getMatchTime(childData);
          var hGoal = childData.liveData.matchDetails.scores.total.home;
          var aGoal = childData.liveData.matchDetails.scores.total.away;
                      var matchScore = hGoal+':'+aGoal;
            //var matchTime = mTime +"'";
            var matchTime = (mTime == 45) ? 'HT' :  mTime +"'";
                    var homeData = {matchId : mId, matchTime : matchTime, matchScore : matchScore};
          var ehtml = $("#home_page_live").html();
          
          var homeHtml = replaceTemplateContent(ehtml,homeData);
          $("#match_list_"+mId).html(homeHtml);
          createcircle(mId,mTime)
        }                   
  }


  function matchInfoUpdate(){
  
    matchInfo.on('value', function(snapshot) {
       $(".timeCircle").html('');
      snapshot.forEach(function(childSnapshot) {
        var childKey = childSnapshot.key;
        var childData = childSnapshot.val();
         //console.log(childData);
         if( !(typeof matchEvent == 'undefined') && matchEvent != '' && matchEvent != null){
            updateMatchDetail(matchEvent.events ,'table'); 
           // updateMatchDetail(childData ); //for testing  purpose - live
         }else{
            updateMatchDetail(childData,'firebase' );
         }
         updateMacthList(childKey,childData); 
         updateMacthListHome(childData); 
      });

      
    });
    if( !(typeof matchEvent == 'undefined') && matchEvent != '' && matchEvent != null  && typeof liveMatch != 'undefined'){
        updateMatchDetail(matchEvent.events ,'table'); 
        
     }else{
      
     }
      //updateMacthList(sampleJson,sampleJson);
      //updateMacthList(sampleJson1,sampleJson1);
  }

  function updateMacthList(childKey,childData){
    
    //$('canvas').remove();
    if($("#match_list").length > 0){
      if(typeof childData != 'undefined' && childData.length > 0){
         var childData = childData.substring(1, childData.length-1);
         var childData = JSON.parse(childData);
        }
        var mId = childData.matchInfo.id;
        var parent = "#matchList_"+mId;
       
        if(childData.liveData.matchDetails.matchStatus.trim() == 'Playing'){ 
         
          if($(parent).find('.matchLiveClass').length == 0 ){
            $(parent).find('.compClass').addClass('live-border');
            $(parent).find('.removeTime').remove();
            $(parent).find('.leftClass').prepend(liveImage);
          }
          $(parent).find('.mtTitmeData').html('');
          var mTime = getMatchTime(childData);
          var hGoal = childData.liveData.matchDetails.scores.total.home;
          var aGoal = childData.liveData.matchDetails.scores.total.away;
                      var disTime = (mTime == 45) ? 'HT' : mTime+'\'';
            var mtHtml = '<span class="upcomingMatches__time-top">'+disTime+'</span><span class="upcomingMatches__score">'+hGoal+':'+aGoal+'</span>';
                    
          $(parent).find('.mtTitmeData').html(mtHtml);
          createcircle(mId,mTime)
        }
    }
  }


  function getMatchTime(childData){
    //var mTime = (childData.type == 'fanet') ? childData.liveData.matchDetails.matchLengthMin : childData.liveData.matchDetails.matchTime;
    //console.log(childData);
    if(childData.liveData.matchDetails.periodId == 10 && (typeof childData.liveData.matchDetails.matchTime  == 'undefined')){
      var mTime = 45;
    }
    else if(childData.liveData.matchDetails.periodId == 14 && (typeof childData.liveData.matchDetails.matchTime  == 'undefined')){
      var mTime = 90;
    }
    else{
      var mTime = (typeof childData.liveData.matchDetails.matchTime  == 'undefined') ? childData.liveData.matchDetails.matchLengthMin : childData.liveData.matchDetails.matchTime;
    }
    if(typeof mTime == 'undefined'){
      if(childData.liveData.matchDetails.periodId == 10){
        mTime = 45;
      }else if(childData.liveData.matchDetails.periodId == 14){
        mTime = 90;
      }else{
        mTime = 90;
      }
    }

    return mTime;
  }
  function updateMatchDetail(childData,from){
   // childData = sampleJson1; //comment
   
    if(typeof childData.liveData  != 'undefined' ){
        if(from == 'firebase' && childData.liveData.matchDetails.matchStatus.toLowerCase() == 'played' ){
          location.reload();
          return false;
      }
    }
    
    //console.log(childData);
    showPreloader();

    var total = 90;
    var mId = '';
    var lastGoal = [];
    
    if(typeof childData != 'undefined' && childData.length > 0){
     var childData = childData.substring(1, childData.length-1);
     var childData = JSON.parse(childData);
    }
    
    var mId = (typeof childData != 'undefined' && typeof childData != 'string') ?  childData.matchInfo.id : '';
    
    var timelineBlock = '';
    if((typeof matchOpta != 'undefined') && matchOpta == mId){
      
      //Team Events
      
      var teamAEvent = teamBEvent  = homeGoalPlayer  = awayGoalPlayer = mediaControlBlock = '';
      
      var mTime = getMatchTime(childData);
      var homeGoal = (childData.liveData.matchDetails.scores.total.home > 0) ? childData.liveData.matchDetails.scores.total.home : '0';
      var awayGoal =  (childData.liveData.matchDetails.scores.total.away > 0) ? childData.liveData.matchDetails.scores.total.away : '0';
      $(childData.liveData.goal).each(function(i, v){
        /*if( v.timeMin > total){
           v.timeMin = total;
        }*/
        var tm = v.timeMin;
        var left = Math.round(v.timeMin * 100 / total);
        left = (left > 97) ? 98 : left;
        var eData = { left :  left};
         if(v.scorerId!==undefined &&  v.scorerId !== null && v.scorerId !== '' ){
         
          if(match.home_team.opta_ctst_id == v.contestantId){
            var gl = goalImages.home_goal;
            var gType = v.type.toLowerCase();
            var homG = 'home_goal';
            var gImage = 'home_goal';
            if(gType == 'og'){
              var ehtml = $("#goalSelf_template").html();
              teamAEvent += replaceTemplateContent(ehtml,eData);
              var homG = 'self_goal';
              var gImage = 'self_goal';
              var gl = goalImages.self_goal;
            }else{
              var ehtml = $("#goalHome_template").html();
              teamAEvent += replaceTemplateContent(ehtml,eData);
               //teamA[v.timeMinSec] = 1;
            }

            var pId = v.scorerId;
           
            var playerName = (homeTeamPlayerData[pId]) ? homeTeamPlayerData[pId].name : v.scorerName;
            homeGoalPlayer += '<span class="matchesClub-hero__live-playername">'+playerName+' ('+tm+'’) <span class="goal"><img src="'+gl+'"> </span></span>';
            if(appEnv != 'production'){
             // homeGoalPlayer += '<span class="matchesClub-hero__live-playername">'+playerName+' ('+tm+'’) <span class="goal"><img src="'+goalImages.self_goal+'"> </span></span>';
            }
          }else{
            var awaG = 'away_goal';
            var gImage = 'away_goal';
            var gl = goalImages.away_goal;
            if(v.type.toLowerCase() == 'og'){
              var awaG = 'self_goal';
              var gImage = 'self_goal';
              var ehtml = $("#goalSelf_template").html();
              teamBEvent += replaceTemplateContent(ehtml,eData);
              var gl = goalImages.self_goal;
            }else{
              var ehtml = $("#goalAway_template").html();
              teamBEvent += replaceTemplateContent(ehtml,eData);
            }
            var pId = v.scorerId;
            var playerName = (awayTeamPlayerData[pId]) ? awayTeamPlayerData[pId].name : v.scorerName;

            awayGoalPlayer += '<span class="matchesClub-hero__live-playername"> <span class="goal"><img src="'+gl+'"> </span> ('+tm+'’) '+playerName+'</span>';
            if(appEnv != 'production'){
              //awayGoalPlayer += '<span class="matchesClub-hero__live-playername"> <span class="goal"><img src="'+goalImages.self_goal+'"> </span> ('+tm+'’) '+playerName+'</span>';
            }
          }

          lastGoal = {'image' : eventImages[gImage], 'time' : tm, 'player' : playerName};
        }
      });
      $(childData.liveData.card).each(function(i, v){
          /*if( v.timeMin > total){
             v.timeMin = total;
          }*/
        if(v.playerId!==undefined &&  v.playerId !== null && v.playerId !== '' ){
          var left = Math.round(v.timeMin * 100 / total);
          left = (left > 97) ? 98 : left;
          var eData = { left :  left};
          var cHtml = '';
          var eType = v.type.toLowerCase();
          switch (eType){
            case 'yc' : 
                      cHtml = $("#yellowCard_template").html(); 
                      break;
            case 'rc' : 
                      cHtml = $("#redCard_template").html(); 
                      break;
            case 'y2c' : 
                      cHtml = $("#redYellowCard_template").html(); 
                      break;
          }
         
          if(match.home_team.opta_ctst_id == v.contestantId){
            teamAEvent += replaceTemplateContent(cHtml,eData);
            
          }else{
            teamBEvent += replaceTemplateContent(cHtml,eData);
            
          }
        }
      });

      $(childData.liveData.substitute).each(function(i, v){
        if(v.playerOnId!==undefined &&  v.playerOnId !== null && v.playerOnId !== '' && v.playerOffId!==undefined &&  v.playerOffId !== null && v.playerOffId !== '' ){
          var left = Math.round(v.timeMin * 100 / total);
          left = (left > 97) ? 98 : left;
          left = left - 1;
          var eData = { left :  left};
          var cHtml = $("#substitute_timeline_template").html(); 
          if(match.home_team.opta_ctst_id == v.contestantId){
            teamAEvent += replaceTemplateContent(cHtml,eData);
            
          }else{
            teamBEvent += replaceTemplateContent(cHtml,eData);
            
          }
         } 
      });
      
      var chData = {channelText : ''};
      if(childData.liveData.matchDetails.matchStatus.toLowerCase() == 'playing'){ 
        timelineBlock = eventDetailTimeline(childData);
        var chData = {channelText : ''};
        $(".matchContent").remove();
      }

      var channelHero = replaceTemplateContent($("#channel_on_hero_template").html(),chData);
      if($("#channel_on_hero").length > 0){
        $("#channel_on_hero").replaceWith(channelHero);
      }
      var latestGoalMinute = '';
      var latestGoalImage = '';
      var latestGoalPlayer = '';
      var totlGoal = (typeof childData.liveData.goal != 'undefined') ? childData.liveData.goal.length : 0;
      if(latestGoal < totlGoal){
          var latestGoalMinute = lastGoal['time'];
          var latestGoalImage = lastGoal['image'];
          var latestGoalPlayer = lastGoal['player'];
      }
      
      var currentTime = getMatchTime(childData);
      var completedTimePercent = Math.round(currentTime * 100 / total);
      completedTimePercent = (completedTimePercent > 100) ? 100 : completedTimePercent;
      var completedTime = total - currentTime;
      var currentTimePercent = 100 - completedTimePercent;
      currentTimePercent = currentTimePercent.toString();
      completedTimePercent = completedTimePercent.toString();
      currentTime = (currentTime > 90) ? '' : currentTime;
      var data = {
        currentTime : currentTime,
        currentTimePercent : currentTimePercent,
        completedTimePercent : completedTimePercent,
        teamAEvent : teamAEvent,
        teamBEvent : teamBEvent,
        timelineBlock : timelineBlock,
        mediaControlBlock : mediaControlBlock,
        latestGoalMinute : latestGoalMinute,
        latestGoalImage : latestGoalImage,
        latestGoalPlayer : latestGoalPlayer,
      }
      
      var html = $("#timeline_template").html();
      html = replaceTemplateContent(html,data);
      
      if($("#liveMatchUpdate").length > 0){
        $("#liveMatchUpdate").replaceWith(html);
      }else{
        
        $("#matchContentDiv").append(html);
      }
     
      $(".buy_ticket_link").remove();
      if(childData.liveData.matchDetails.matchStatus.toLowerCase() == 'playing'){ 
        //var mediaControlBlock = $("#media_control_div").html();
        $(".liveMathTabClass").show();
                var disTime = (mTime == 45) ? 'HT' : mTime+'\'';
        var liveMinutes = '<img src="https://www.uaeproleague.ae/web/images/live-icon.svg" alt=""><span class="matchesClub-hero__live-score-minutes">'+disTime+'</span>';
                var heroData = {liveMinutes : liveMinutes, homeGoal : homeGoal, homeGoalPlayer : homeGoalPlayer, awayGoal : awayGoal, awayGoalPlayer : awayGoalPlayer };
      }else{
        $(".liveMathTabClass").hide();
        var heroData = {liveMinutes : '', homeGoal : homeGoal, homeGoalPlayer : homeGoalPlayer, awayGoal : awayGoal, awayGoalPlayer : awayGoalPlayer };
      }
      var heroHtml = $("#live_hero_div").html();
      heroHtml = replaceTemplateContent(heroHtml,heroData);
      $(".liveHeroReplace").replaceWith(heroHtml);
     
    }else{
       $(".matchContent").show();
    }

    if(childData.liveData.matchDetails.matchStatus.toLowerCase() == 'playing'){ 
      $("#live_widget_div").show();
      if(latestGoal < totlGoal){
        latestGoal = totlGoal;
        $("#latest_goal_update").show();
      }
      $(".timeline-wrap").show();
    }else{
      $("#live_widget_div").hide();
      $(".timeline-wrap").hide();
    }
    
    if(childData.liveData.matchDetails.matchStatus.toLowerCase() == 'played' || from == 'table'){
      $(".timeline-wrap").hide();
      $("#live_widget_div").hide();
    }
    
    hidePreloader();
  }

function eventDetailTimeline(childData){
    var mId = childData.matchInfo.id;
    var timelineBlock = '';
    if(matchOpta == mId){
     
      //Team Events
      var teamA = teamB = teamContent = [];
      var tContentFinal = [];
      var tContent = {};
      $(childData.liveData.goal).each(function(i, v){
        if(v.scorerId!==undefined &&  v.scorerId !== null && v.scorerId !== '' ){
          var tm = (typeof v.timeMinSec  == 'undefined') ? v.timeMin : v.timeMinSec;
          if(tm in tContent == false){
            tContent[tm] = {};
          }
          if(match.home_team.opta_ctst_id == v.contestantId){
            var gType = v.type.toLowerCase();
            var homG = 'home_goal';
            if(gType == 'og'){
              var homG = 'self_goal';
            }
            var pId = v.scorerId;
            //var content = v.timeMin+'’ Goal  ';
            
            var timeArray = {'contentType' : 'content_block',eventType : 'goal' , type : homG , data : v, team : 'home', time : tm};
            var t = tm;
            teamContent.push({ t : timeArray} );
            tContent[tm] = timeArray;
            tContentFinal.push(timeArray);
          }else{
            var awaG = 'away_goal';
            if(v.type.toLowerCase() == 'og'){
              var awaG = 'self_goal';
            }
          
            var timeArray = {'contentType' : 'content_block',eventType : 'goal' , type : awaG , data : v, team : 'away', time : tm};
            var t = tm;
            teamContent.push({ t : timeArray} );
            tContent[tm] = timeArray;
            tContentFinal.push(timeArray);
            
          }
        }
      });
      $(childData.liveData.card).each(function(i, v){
        if(v.playerId!==undefined &&  v.playerId !== null && v.playerId !== '' ){
          var eType = v.type.toLowerCase();
          var tm =  (typeof v.timeMinSec  == 'undefined') ? v.timeMin : v.timeMinSec;
          if(tm in tContent == false){
            tContent[tm] = {};
          }
          if(match.home_team.opta_ctst_id == v.contestantId){
            //teamA[v.timeMinSec] = createContentHtml('content_block_image',{playerImage : eventImages.eType});
            var timeArray = {'contentType' : 'content_block',eventType : 'card' , type : eType , data : v, team : 'home', time : tm};
            // var t = v.timeMinSec;
            // teamContent.push({ t : timeArray} );
            tContent[tm] = timeArray;
            tContentFinal.push(timeArray);
          }else{
            //teamB[v.timeMinSec] = createContentHtml('content_block_image',{playerImage : eventImages.eType});
            var timeArray = {'contentType' : 'content_block',eventType : 'card' , type : eType , data : v, team : 'away', time : tm};
            // var t = v.timeMinSec;
            // teamContent.push({ t : timeArray} );
            tContent[tm] = timeArray;
            tContentFinal.push(timeArray);
          }
        }
      });
      $(childData.liveData.substitute).each(function(i, v){
        if(v.playerOnId!==undefined &&  v.playerOnId !== null && v.playerOnId !== '' && v.playerOffId!==undefined &&  v.playerOffId !== null && v.playerOffId !== '' ){
          var tm =  (typeof v.timeMinSec  == 'undefined') ? v.timeMin : v.timeMinSec;
          if(match.home_team.opta_ctst_id == v.contestantId){
            var timeArray = {'contentType' : 'content_block_substitute',eventType : 'substitute' , type : 'substitute' , data : v, team : 'home', time : tm };
          }else{
            var timeArray = {'contentType' : 'content_block_substitute',eventType : 'substitute' , type : 'substitute' , data : v, team : 'away', time : tm};
          }
          
          tContent[tm] = timeArray;
          tContentFinal.push(timeArray);
        }
      });
      tContent[0] = {'contentType' : 'kickoff', eventType : 'kickoff'};
      tContentFinal.push({'contentType' : 'kickoff', eventType : 'kickoff' , time : 0});
      var matTime = getMatchTime(childData);
      if(parseInt(matTime) >= 45){
        tContent[45] = {'contentType' : 'half_time', eventType : 'half_time' };        
        tContentFinal.push({'contentType' : 'half_time', eventType : 'half_time' , time : 45});
      }
      if(childData.liveData.matchDetails.matchStatus == 'Played' ){
        tContent[90] = {'contentType' : 'full_time', eventType : 'full_time'};
        tContentFinal.push({'contentType' : 'full_time', eventType : 'full_time' , time : 90});
      }

     /* var tKeysReverse = Object.keys(tContent).sort(function(a, b){return parseFloat(b)-parseFloat(a)});  
           
       if($(tKeysReverse).length > 0){
          $(tKeysReverse).each(function(i, v){
              if(v in tContent){
                var content = tContent[v];
                timelineBlock += createContentHtml(content.contentType,content);
               
              }
          });
       }
       
    }*/
      tContentFinal.sort(function(a, b) {
        return parseInt(b.time) - parseInt(a.time);
      });
      
      $(tContentFinal).each(function(i, v){        
        timelineBlock += createContentHtml(v.contentType,v);
      });
    }
      return timelineBlock;
}

function replaceTemplateContent(template, data) {
    const pattern = /{\s*(\w+?)\s*}/g; // {property}
    return template.replace(pattern, (_, token) => data[token] || '');
}

function createContentHtml(type,cData){
  switch (type){
    case 'kickoff'    : return $("#kickoff_timeline_block").html(); break;
    case 'half_time'  : return $("#halftime_timeline_block").html(); break;
    case 'full_time'  : return $("#fulltime_timeline_block").html(); break;
    case 'content_block' : 
                          if(cData.team == 'home'){
                              var homeTeamContent = createContentHtml('left_block',cData);
                              var awayTeamContent = '';
                          }else{
                              var awayTeamContent = createContentHtml('right_block',cData);
                              var homeTeamContent = '';
                          }
                          
                          var data = { homeTeamContent : homeTeamContent, awayTeamContent : awayTeamContent };
                          var html = $("#timeline_content_block").html(); 
                          return replaceTemplateContent(html,data);
                          break;
    case 'left_block' : 
                          var typ = cData.type;
                          var eventImage = eventImages[typ];
                          var eventContent = createContentHtml('content_block_content',cData);
                          var imageContent = createContentHtml('content_block_image',cData);
                          
                          var data = { eventImage : eventImage, eventContent : eventContent, imageContent : imageContent};
                          var html = $("#timeline_content_left").html(); 
                          var rHtml = replaceTemplateContent(html,data);
                          
                          return rHtml;
                          break;
    case 'right_block'    : 
                          var typ = cData.type;
                          var eventImage = eventImages[typ];
                          var eventContent = createContentHtml('content_block_content',cData);
                          var imageContent = createContentHtml('content_block_image',cData);
                          var data = { eventImage : eventImage, eventContent : eventContent, imageContent : imageContent};
                          var html = $("#timeline_content_right").html(); 
                          return replaceTemplateContent(html,data);
                          break;
    case 'content_block_image'    : 
                          var pId = (cData.eventType == 'goal') ? cData.data.scorerId : cData.data.playerId;
                          if(cData.team == 'home'){
                            var playerImage = (homeTeamPlayerData[pId]) ? homeTeamPlayerData[pId].image : 'https://www.uaeproleague.ae/web/images/profile-dummy3.png';
                          }else{
                            var playerImage = (awayTeamPlayerData[pId]) ? awayTeamPlayerData[pId].image : 'https://www.uaeproleague.ae/web/images/profile-dummy3.png';
                          }
                          
                          var data = { playerImage : playerImage};
                          var html = $("#timeline_content_block_image").html(); 
                          return replaceTemplateContent(html,data);
                          //return '<img src="'+playerImage+'" alt="" class="timeline__player-img"/>';
                          break;
    case 'content_block_content'  : 
                          var pId = (cData.eventType == 'goal') ? cData.data.scorerId : cData.data.playerId;
                          var assistBy = '';
                         
                          if(cData.team == 'home'){
                            var playerImage = (homeTeamPlayerData[pId]) ? homeTeamPlayerData[pId].image : 'https://www.uaeproleague.ae/web/images/profile-dummy3.png';
                            var playerName = (homeTeamPlayerData[pId]) ? homeTeamPlayerData[pId].name : cData.data.scorerName;

                            if(typeof cData.data.assistPlayerName != 'undefined' && cData.eventType == 'goal'){
                              var html = $("#assist_by_div").html(); 
                              var assistByPlayer = (homeTeamPlayerData[cData.data.assistPlayerId]) ? homeTeamPlayerData[cData.data.assistPlayerId].name : cData.data.assistPlayerName;
                              assistBy = replaceTemplateContent(html,{assistByPlayer : assistByPlayer});
                               
                            }
                          }else{
                            var playerImage = (awayTeamPlayerData[pId]) ? awayTeamPlayerData[pId].image : 'https://www.uaeproleague.ae/web/images/profile-dummy3.png';
                            var playerName = (awayTeamPlayerData[pId]) ? awayTeamPlayerData[pId].name : cData.data.playerName;
                            if(typeof cData.data.assistPlayerName != 'undefined' && cData.eventType == 'goal'){
                              var html = $("#assist_by_div").html(); 
                              var assistByPlayer = (awayTeamPlayerData[cData.data.assistPlayerId]) ? awayTeamPlayerData[cData.data.assistPlayerId].name : cData.data.assistPlayerName;
                              assistBy = replaceTemplateContent(html,{assistByPlayer : assistByPlayer});
                               
                            }
                          }
                          var mainContent = '';
                          var subContent = '';
                          if(cData.eventType == 'goal'){
                            if(cData.type == 'self_goal'){
                              var goalText = "Own goal ";
                            }
                            else{
                              var goalText = "Goal ";
                            }
                            var mainContent = cData.data.timeMin+'’ '+goalText;
                            var subContent = playerName;
                          }else{
                            var cardText = '';
                            switch(cData.type){
                              case 'yc' : var cardText = 'Yellow Card'; break;
                              case 'rc' : var cardText = 'Red Card'; break;
                              case 'y2c' : var cardText = 'Red Card'; break;
                            }
                            var mainContent = cData.data.timeMin+'’ ' +cardText;
                            var subContent = playerName;
                          }
                          
                          var data = { mainContent : mainContent, subContent : subContent, assistBy : assistBy};
                          var html = $("#timeline_content_block_content").html(); 
                          return replaceTemplateContent(html,data);
                          break;
    case 'content_block_substitute' : 
                          if(cData.team == 'home'){
                              var subLeftContent = createContentHtml('content_block_substitute_content',cData);
                              var subRightContent = '';
                          }else{
                              var subRightContent = createContentHtml('content_block_substitute_content',cData);
                              var subLeftContent = '';
                          }
                          
                          var data = { subLeftContent : subLeftContent, subRightContent : subRightContent};
                          var html = $("#timeline_content_block_substitute").html(); 
                          return replaceTemplateContent(html,data); 
                          break;
    case 'content_block_substitute_content' : 
                          var inId =  cData.data.playerOnId;
                          var outId =  cData.data.playerOffId;
                          if(cData.team == 'home'){
                              var midPointClass = '';
                              var midContentClass = 'left';
                              var teamName = match.home_team.name;
                             
                              var inPlayerName = (homeTeamPlayerData[inId]) ? homeTeamPlayerData[inId].name : cData.data.playerOnName;
                              var inPlayerImage = (homeTeamPlayerData[inId]) ? homeTeamPlayerData[inId].image : 'https://www.uaeproleague.ae/web/images/profile-dummy3.png';
                              var outPlayerName = (homeTeamPlayerData[outId]) ? homeTeamPlayerData[outId].name : cData.data.playerOffName;
                              var outPlayerImage = (homeTeamPlayerData[outId]) ? homeTeamPlayerData[outId].image : 'https://www.uaeproleague.ae/web/images/profile-dummy3.png';
                          }else{
                              var midPointClass = '';
                              var midContentClass = 'right';
                              var teamName =  match.away_team.name;
                              var inPlayerName = (awayTeamPlayerData[inId]) ? awayTeamPlayerData[inId].name : cData.data.playerOnName;
                              var inPlayerImage = (awayTeamPlayerData[inId]) ? awayTeamPlayerData[inId].image : 'https://www.uaeproleague.ae/web/images/profile-dummy3.png';
                              var outPlayerName = (awayTeamPlayerData[outId]) ? awayTeamPlayerData[outId].name : cData.data.playerOffName;
                              var outPlayerImage = (awayTeamPlayerData[outId]) ? awayTeamPlayerData[outId].image : 'https://www.uaeproleague.ae/web/images/profile-dummy3.png';
                          }
                          var subStituteTime = cData.data.timeMin+'’';
                          var data = {midPointClass : midPointClass, midContentClass : midContentClass, teamName : teamName, inPlayerName : inPlayerName, inPlayerImage : inPlayerImage, outPlayerName : outPlayerName, outPlayerImage : outPlayerImage, subStituteTime : subStituteTime}
                          if(cData.team == 'home'){
                            var html = $("#timeline_content_block_substitute_content_left").html(); 
                          }else{
                            var html = $("#timeline_content_block_substitute_content_right").html();
                          }
                          return replaceTemplateContent(html,data);
                          break;
  } 
}


function createcircle(id,time){
  var maxTime = (time > 90) ? 90 : 90;
  var percent = (maxTime > 0 && time > 0) ? (time / maxTime) * 100 : 0;
  percent = (percent > 99.999) ? 99.999 : percent;
 
  if($("#mtTitme_"+id).length>0){
    $("#mtTitme_"+id).attr('data-percent',percent);
    drawCircleProgress(id,percent);

  }
  
  
}
//var bar;
function drawCircleProgress(id,percentage){
  // progressbar.js@1.0.0 version is used
// Docs: http://progressbarjs.readthedocs.org/en/1.0.0/

var bar = new ProgressBar.Circle("#mtTitme_"+id, {
  strokeWidth: 6,
  easing: 'easeInOut',
  duration: 1400,
  color: '#BA2D8D',
  trailColor: '#efefef',
  trailWidth: 1,
  svgStyle: null,
  /*text: {
        // Initial value for text.
        // Default: null
        value: 'Text',

        // Class name for text element.
        // Default: 'progressbar-text'
        className: 'progressbar__label',

        // Inline CSS styles for the text element.
        // If you want to modify all CSS your self, set null to disable
        // all default styles.
        // If the style option contains values, container is automatically
        // set to position: relative. You can disable behavior this with
        // autoStyleContainer: false
        // If you specify anything in this object, none of the default styles
        // apply
        // Default: object speficied below
        style: {
            // Text color.
            // Default: same as stroke color (options.color)
            color: '#f00',
            position: 'absolute',
            left: '50%',
            top: '50%',
            padding: 0,
            margin: 0,
            // You can specify styles which will be browser prefixed
            transform: {
                prefix: true,
                value: 'translate(-50%, -50%)'
            }
        },
         // Only effective if the text.style is not null
        // By default position: relative is applied to container if text
        // is set. Setting this to false disables that feature.
        autoStyleContainer: true,

