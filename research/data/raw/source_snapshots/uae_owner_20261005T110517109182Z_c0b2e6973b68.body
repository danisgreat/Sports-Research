    $("#mySignUpForm").validate({
        rules: {

          email: {
            required: true,

            email: true
          },
          password: {
            required: true,
            //minlength: 5
          },
          "name" : "required",

        },
      submitHandler: function(form) {
        // some other code
        // maybe disabling submit button
        // then:
        var url = $("#mySignUpForm").attr('action');
        var postData = $("#mySignUpForm").serialize();
        ajaxPost(url,postData,function(response){
                if(response.status == 'error'){
                    //$("#login_error_div").html(response.message);
                    showAlert('error',response.message);
                }else{
                    $(".signup-form-2").hide();
                    window.location.href = response.redirect;
                }
            });
      },
      errorPlacement: function(error, element) {

             error.insertAfter(element.closest('.sign-up-form__group'));

       }
     });


</script>

    </body>
</html>
