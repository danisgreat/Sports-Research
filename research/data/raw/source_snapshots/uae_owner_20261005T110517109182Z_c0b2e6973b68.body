                    </span>
                    <p id="login_error_div"></p>
                    <form action="https://www.uaeproleague.ae/en/login" method="post" id="myLoginForm" class="sign-in-form">
                    <input type="hidden" name="type" value="normal">

                        <div class="log-in-form__group">
                            <label for="email" class="log-in-form__label">Email</label>
                            <input type="email" name="email" id="email" class="log-in-form__input" placeholder="Enter your email" required="true" autocomplete="off">
                        </div>
    
                        <div class="log-in-form__group">
                            <label for="password" class="log-in-form__label">Password</label>
                            <input type="password" name="password" id="password" class="log-in-form__input" placeholder="Enter your Password" required="true" autocomplete="off">
                        </div>
    
                        <a class="log-in-form__forget-password" href="javascript:void(0)" id="forgot_click_btn">I’ve forgotten my password</a>
    
                        <button class="log-in-button log-in-form__btn log-in-form__btn--pink"  id="sign_in_button">
                            Sign-In
                        </button>
                        <div class="log-in-social">
