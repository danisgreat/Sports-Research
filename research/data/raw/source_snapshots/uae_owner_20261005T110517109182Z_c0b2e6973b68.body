-6a3f-11eb-85c1-0947406c02x0","name":"Etisalat Super Cup"},{"id":"73cc89d0-6a3f-11eb-95ca-bdfbb09b77xc","name":"Etisalat Cup"}],"9":[{"id":"0c8d9c50-6a3f-11eb-abea-f59ee726fab9","name":"Etisalat Pro League"},{"id":"0c8d9c50-6a3f-11eb-abea-f59ee726fab8","name":"Etisalat Reverse League"},{"id":"cb8ea270-6a3f-11eb-85c1-0947406c0200","name":"Etisalat Super Cup"},{"id":"73cc89d0-6a3f-11eb-95ca-bdfbb09b77cc","name":"Etisalat Cup"}]};
var activeCompetetion = {"season_competition_id":"05e5f710-7460-11f1-8060-fd4f2e8e9899","week_number":3};
var weekNumber = [];

$(document).ready(function(){

  $(".filterseason").on("change",function(){
   setCompetition();
  });
  $(".filterFixture").on("change",function(){
   getResult();
  });

  showPreloader();
  setTimeout(function(){
   setCompetition();
  },1000);

});

function setFixture(){
  var parent = $(".filterseason:visible").closest('.filterParentDiv');
    var cId = $(".filterCompetition:visible").val();
   /*
    var wkCnt = weekNumber[cId];
    var option = '<option value="">All</option>';
    for(var i=1; i<=wkCnt ;i++){
         var sel = '';
         if(activeCompetetion.week_number == i){
            var sel = 'selected="selected"';
         }
         option += '<option value="'+i+'" '+sel+'> Gameweek  '+i+'</option>';
    }

    $(parent).find('.filterFixture').select2("destroy");
    $(parent).find('.filterFixture').html(option);
    $(parent).find('.filterFixture').select2({
        minimumResultsForSearch: -1,
    }).on('change.select2', function (e) {
        getResult();
    });
    getResult();*/
    var url = 'https://www.uaeproleague.ae/en/fixtures-week';
    var postData = {seasonCompetitionId : cId};
    ajaxPost(url,postData,function(response){
        $(parent).find('.filterFixture').select2("destroy");
        $(parent).find('.filterFixture').html(response.option);
        $(parent).find('.filterFixture').select2({
            minimumResultsForSearch: -1,
        }).on('change.select2', function (e) {
            getResult();
        });
        getResult();
    },'GET');
}
function setCompetition(){
    var parent = $(".filterseason:visible").closest('.filterParentDiv');
    var cId = $(".filterseason:visible").val();
    //var cId = $(this).val();
    var seas = season[cId];
    var option = '';
    $(seas).each(function(index,value){
         var sel = '';
         if(activeCompetetion != null && activeCompetetion.season_competition_id == value.id){
            var sel = 'selected="selected"';
         }
         option += '<option value="'+value.id+'" '+sel+'>'+value.name+'</option>';
    });

    $(parent).find('.filterCompetition').select2("destroy");
    $(parent).find('.filterCompetition').html(option);
    $(parent).find('.filterCompetition').select2({
        minimumResultsForSearch: -1,
    }).on('change.select2', function (e) {
        setTeamFilter();
        getResult();
        setFixture();
    });
    setTeamFilter();
    setFixture();
}
function setTeamFilter(){
  var parent = $(".filterCompetition:visible").closest('.filterParentDiv');
  var url = 'https://www.uaeproleague.ae/en/fixtures-filter';
  var id = $(".filterCompetition:visible").val();
  var postData = { id :id };
  ajaxPost(url,postData,function(response){
    var option = ' <option value="">All</option>';
      $(response.teams).each(function(index,value){
        option += '<option value="'+value.id+'">'+value.name+'</option>';
      });
      $(parent).find('.filterTeam').select2("destroy");
      $(parent).find('.filterTeam').html(option);
      $(parent).find('.filterTeam').select2({
          minimumResultsForSearch: -1,
      }).on('change.select2', function (e) {
          getResult();
      });
      getResult();
  },'GET');

}

function getResult(){
  var seasonCompetitionId = $(".filterCompetition:visible").val();
  var weekNber = $(".filterFixture:visible").val();
  var teamId = $(".filterTeam:visible").val();
  var postData = { seasonCompetitionId :seasonCompetitionId, weekNumber : weekNber, teamId : teamId };
  var url = 'https://www.uaeproleague.ae/en/fixtures/matches';
  ajaxPost(url,postData,function(response){
    $("#match_list").html(response.html);
    matchInfoUpdate();
  },'GET');
}

</script>
<script type="text/javascript">
    var smileyError = "Please select all options";
    $(document).ready(function(){
        //clearSmileyForm();



         var sTitle1 = "How was your experience?";
          var sTitle2 = "What can we improve?";
          $(".next-form").on( "click", function(){
            $(".smiley-title").text(sTitle2);
          }) 
          $(".smiley-back").on( "click", function(){
            $(".smiley-title").text(sTitle1);
          })
          $(".smiley-sub-btn").on("click",function(){
                
                if($("input[name=smiley]:checked").length != '' && $("input[name=use]:checked").length != '' && $("input[name=presentation]:checked").length != '' && $("input[name=performance]:checked").length != ''){
                    var url = $("#smileyForm").attr('action');
                    var postData = $("#smileyForm").serialize();
                    ajaxPost(url,postData,function(response){
                        if(response.status == 'success'){
                            successPage();
                            
                            showAlertWithTitle('success',response.title,response.message);
                        }else{
                            showAlert('error',response.message);
                        }
                        
                    });
                }else{
                    showAlert('error',smileyError);
                }
          });

          $("#smiley_btn_close").on("click",function(){
            clearSmileyForm();
          })
    });

    function clearSmileyForm(){
        $(".smiley-detail").hide();        
        $(".smiely-form-submit").hide();
        $(".smiely-box-middle").hide();
        $(".smiely-feedback").show();
        $("#smileyForm")[0].reset();
    }

    function successPage(){
        $(".smiley-detail").hide();        
        $(".smiely-form-submit").hide();
        $(".smiely-box-middle").hide();
        //$(".smiely-form-submit").show();
        $("#smileyForm")[0].reset();
        $(".smiley-feedback-form").hide();
    }
</script>

<script type="text/javascript">

    var sel = "--Please Select --";
    $(document).ready(function(){
        $(".feedMacthGroup").hide();
        $("#feed_category_id").on("change",function(){
            var id = $(this).val();
            $(".feedMacthGroup").hide();
            $("#feed_sub_category").html('<option value="">'+sel+'</option>');
            if(id != ''){
                if(id == "20a5a090-f5a4-11ea-b104-995a43c1dc30"){
                    $(".feedMacthGroup").show();
                }
                var url = 'https://www.uaeproleague.ae/en/get-subcategory/:id';
                url = url.replace(':id', id);
                ajaxPost(url,null,function(response){
                  
                    $("#feed_sub_category").html(response.html);
                     //console.log($("#feed_sub_category_contatiner").html());
                     setTimeout(function(){
                        $('.custom-drop-contact-page').select2({
                        minimumResultsForSearch: -1
                      });
                    },100)
                    
                },'GET',);
            }
            
        });

        $("#feedbackForm").validate({
            rules: {
              
              email: {
                required: true,
               
                email: true
              }
            },
          submitHandler: function(form) {
            // some other code
            // maybe disabling submit button
            // then:
            var url = $("#feedbackForm").attr('action');
            var postData = $("#feedbackForm").serialize();
            ajaxPost(url,postData,function(response){
                showAlert(response.status,response.message);
                    if(response.status == 'success'){
                        $(".feedback-form").hide();
                        $(".feedMacthGroup").hide();
                        $("#feedbackForm")[0].reset();
                    }
            });
          }
     });
    })
</script>
<script type="text/javascript">
    $(document).ready(function(){
        $(".openCalendarPopup").on("click",function(){
            $("#calendar_first").show();
            $("#calendar_second").html('');
            $("#calendar_second").hide();
            $(".compSelCheck").prop("checked",false);
        })
        var comp = [];
        $("#cal_next_1").on("click",function(){
             if($(".compSelCheck:checked").length == 0){
                showAlert('error','Select Competition');
                return false;
             }
            $(".compSelCheck:checked").each(function(){
                comp.push($(this).val());
            })
             //var comp = $(this).data('comp');
             getCalendarClubs(comp);
        });
        $(".calenderOpen2-all").on("click",function(){
            var comp = 'all';
            $(".compSelCheck").prop("checked",true);
            getCalendarClubs(comp);
        });

        $(document).on("click","#cal_next_2", function(){
            if($(".calClubCheck:checked").length == 0){
                showAlert('error','Select Clubs');
                return false;
             }
            syncCal();
        });

        $(document).on("click",".calAllClubs",function(){
            $(".calClubCheck").prop("checked",true);
            syncCal();
        });
    });

    function getCalendarClubs(comp){
        var postData = {comp : comp};
             $("#calendar_second").html('');
            var url = 'https://www.uaeproleague.ae/en/get-clubs-competition';
            ajaxPost(url,postData,function(response){
                $("#calendar_first").hide();
                $("#calendar_second").html(response.html);
                $("#calendar_second").show();
            });
    }

    function syncCal(){
        var clb = '';
        var jn = '';
        $(".calClubCheck:checked").each(function(){
            clb += jn+$(this).val();
            jn = ',';
        });

        var comps = '';
        var jn = '';
        $(".compSelCheck:checked").each(function(){
            comps += jn+$(this).val();
            jn = ',';
        });
        var url = 'https://www.uaeproleague.ae/en/sync-calendar/web/:compids/:tids';
         url = url.replace(':compids', comps);
         url = url.replace(':tids', clb);
         window.location = url;
         $(".calender-pop-up").hide();
    }
</script>
