{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sports-research.invalid/schemas/prospective-record-v1.json",
  "title": "Sports Research prospective forecast and settlement record v1",
  "description": "A strict evidence record. Passing this shape is necessary but not sufficient for scoring; tools/semantic_validation.py and tools/prospective_eligibility.py enforce relationships, hashes, timing, independent lineages, exact joins and RM-1 reproduction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "complements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/complement"
      }
    },
    "geometry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/geometry"
      }
    },
    "nested_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nested"
      }
    },
    "distributions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/distribution"
      }
    },
    "slates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slate"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "event_cluster_id",
        "forecast_id",
        "card_id",
        "decision_id",
        "target_id",
        "contract_id",
        "contract",
        "contract_spec",
        "sport",
        "competition",
        "season",
        "participant_ids",
        "rank",
        "horizon",
        "input_cutoff_utc",
        "input_availability_latest_utc",
        "issued_at_utc",
        "event_start_utc",
        "distribution_id",
        "distribution_type",
        "distribution_sha256",
        "probabilities",
        "q",
        "q_semantics",
        "baseline",
        "method_version",
        "method_sha256",
        "control_sha256",
        "manifest_sha256",
        "ranking_model_version",
        "ranking_model_sha256",
        "ranking_model_code_sha256",
        "settlement_revision_id",
        "observed_value",
        "result",
        "outcome_verified",
        "issue_receipts",
        "terminal_receipts",
        "preferred_at_issue",
        "selection_policy_version",
        "complementary_pair_id",
        "covering_pair_id",
        "target_weight",
        "missingness"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_cluster_id": {
          "type": "string",
          "minLength": 1
        },
        "forecast_id": {
          "type": "string",
          "minLength": 1
        },
        "card_id": {
          "type": "string",
          "pattern": "^P-[0-9]{3,}$"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "sport": {
          "type": "string",
          "minLength": 1
        },
        "competition": {
          "type": "string",
          "minLength": 1
        },
        "season": {
          "type": "string",
          "minLength": 1
        },
        "participant_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "horizon": {
          "enum": [
            "PREGAME",
            "LIVE_ISSUED",
            "POST_START",
            "UNKNOWN"
          ]
        },
        "input_cutoff_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "input_availability_latest_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "issued_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "event_start_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "probabilities": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "W",
                "P",
                "L"
              ],
              "additionalProperties": false,
              "properties": {
                "W": {
                  "$ref": "#/$defs/probability"
                },
                "P": {
                  "$ref": "#/$defs/probability"
                },
                "L": {
                  "$ref": "#/$defs/probability"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "W",
                "P",
                "L",
                "V"
              ],
              "additionalProperties": false,
              "properties": {
                "W": {
                  "$ref": "#/$defs/probability"
                },
                "P": {
                  "$ref": "#/$defs/probability"
                },
                "L": {
                  "$ref": "#/$defs/probability"
                },
                "V": {
                  "$ref": "#/$defs/probability"
                }
              }
            }
          ]
        },
        "q": {
          "oneOf": [
            {
              "$ref": "#/$defs/probability"
            },
            {
              "type": "null"
            }
          ]
        },
        "q_semantics": {
          "enum": [
            "ROW_CALIBRATED_NOT_JOINT",
            "MARGINAL_EVENT_PROBABILITY",
            "RANKING_SCORE",
            "UNKNOWN"
          ]
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "method_version": {
          "type": "string",
          "minLength": 1
        },
        "method_sha256": {
          "$ref": "#/$defs/hash"
        },
        "control_sha256": {
          "$ref": "#/$defs/hash"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/hash"
        },
        "ranking_model_version": {
          "type": "string",
          "minLength": 1
        },
        "ranking_model_sha256": {
          "$ref": "#/$defs/hash"
        },
        "settlement_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "supersedes_revision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_value": {},
        "result": {
          "enum": [
            "W",
            "P",
            "L",
            "V",
            "UNRESOLVED"
          ]
        },
        "outcome_verified": {
          "type": "boolean"
        },
        "issue_receipts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/receipt"
          }
        },
        "terminal_receipts": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/terminalReceipt"
          }
        },
        "preferred_at_issue": {
          "type": "boolean"
        },
        "complementary_pair_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "covering_pair_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "selection_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "missingness": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prospective_cohort_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "eligibility_policy_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "contract_spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "measure",
            "period",
            "line",
            "side",
            "units",
            "overtime_rule",
            "draw_rule",
            "push_rule",
            "void_rule",
            "action_rule",
            "contract_version"
          ],
          "properties": {
            "measure": {
              "type": "string",
              "minLength": 1
            },
            "period": {
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": [
                "number",
                "null"
              ]
            },
            "side": {
              "type": "string",
              "minLength": 1
            },
            "units": {
              "type": "string",
              "minLength": 1
            },
            "overtime_rule": {
              "type": "string",
              "minLength": 1
            },
            "draw_rule": {
              "type": "string",
              "minLength": 1
            },
            "push_rule": {
              "type": "string",
              "minLength": 1
            },
            "void_rule": {
              "type": "string",
              "minLength": 1
            },
            "action_rule": {
              "type": "string",
              "minLength": 1
            },
            "contract_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "distribution_id": {
          "type": "string",
          "minLength": 1
        },
        "distribution_type": {
          "type": "string",
          "minLength": 1
        },
        "distribution_sha256": {
          "$ref": "#/$defs/hash"
        },
        "ranking_model_code_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p",
        "status",
        "event_id",
        "target_id",
        "contract_id",
        "horizon",
        "input_cutoff_utc",
        "training_cutoff_utc",
        "version"
      ],
      "properties": {
        "p": {
          "oneOf": [
            {
              "$ref": "#/$defs/probability"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "FROZEN_VALID",
            "MISSING",
            "NOT_YET_DERIVED",
            "INVALID"
          ]
        },
        "event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "contract_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "horizon": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_cutoff_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "training_cutoff_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "population_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome_vector": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "event_id",
        "lineage_id",
        "observed_at_utc",
        "sha256",
        "source_ref",
        "fields"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "terminalReceipt": {
      "allOf": [
        {
          "$ref": "#/$defs/receipt"
        },
        {
          "type": "object",
          "required": [
            "terminal"
          ],
          "properties": {
            "terminal": {
              "const": true
            }
          }
        }
      ]
    },
    "complement": {
      "type": "object",
      "required": [
        "left_decision_id",
        "right_decision_id"
      ],
      "properties": {
        "left_decision_id": {
          "type": "string"
        },
        "right_decision_id": {
          "type": "string"
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "p_left",
        "p_right",
        "p_intersection",
        "semantics"
      ],
      "properties": {
        "p_left": {
          "$ref": "#/$defs/probability"
        },
        "p_right": {
          "$ref": "#/$defs/probability"
        },
        "p_intersection": {
          "$ref": "#/$defs/probability"
        },
        "semantics": {
          "type": "string"
        },
        "union_covers": {
          "type": "boolean"
        }
      }
    },
    "nested": {
      "type": "object",
      "required": [
        "p_inner",
        "p_outer"
      ],
      "properties": {
        "p_inner": {
          "$ref": "#/$defs/probability"
        },
        "p_outer": {
          "$ref": "#/$defs/probability"
        }
      }
    },
    "distribution": {
      "type": "object"
    },
    "slate": {
      "type": "object"
    }
  }
}
